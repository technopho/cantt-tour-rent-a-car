# Build-time variables (read by astro.config.mjs and src/lib/catalog.ts). Copy to .env if needed.
# In Cloudflare Workers Builds, set these as build variables instead.

# Canonical public URL (no trailing slash). Defaults to https://canttrentacar.com.
SITE_URL=https://canttrentacar.com

# Published fleet catalog from the control panel (R2 public bucket), e.g.
# CATALOG_URL=https://media.canttrentacar.com/catalog/v1.json
# Leave empty to build with src/data/catalog.sample.json.
CATALOG_URL=

# Set to "true" in production builds to FAIL the build when CATALOG_URL is missing or broken,
# instead of silently publishing the sample fleet with placeholder prices.
CATALOG_REQUIRED=false
