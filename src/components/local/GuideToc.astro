---
/**
 * Table of contents for guides: H2 headings from render(entry).headings plus extra blocks.
 * Desktop: sticky list with the current section highlighted (IntersectionObserver, no scroll
 * listener). Phones: a native <details> disclosure.
 */
import Icon from "@/components/Icon.astro";

interface TocItem {
  slug: string;
  text: string;
}

interface Props {
  items: TocItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{
  items.length > 1 && (
    <nav aria-label="On this page" class:list={["guide-toc", className]} data-guide-toc>
      <details class="group border-y border-line lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-fg [&::-webkit-details-marker]:hidden">
          <span class="label">On this page</span>
          <Icon name="ph:caret-down" size={16} class="text-muted transition-transform duration-300 group-open:rotate-180" />
        </summary>
        <ol class="flex flex-col gap-1 border-t border-line py-4 text-sm">
          {items.map((item) => (
            <li>
              <a href={`#${item.slug}`} class="block py-1.5 text-muted transition-colors hover:text-fg">
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </details>

      <div class="hidden lg:block">
        <p class="label text-muted">On this page</p>
        <ol class="mt-4 flex flex-col border-l border-line text-sm">
          {items.map((item) => (
            <li>
              <a href={`#${item.slug}`} class="toc-link -ml-px block border-l-2 border-transparent py-2 pl-4 text-muted transition-colors hover:text-fg" data-toc-link={item.slug}>
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )
}

<style>
  .toc-link.is-current {
    border-color: var(--accent);
    color: var(--text);
  }
</style>

<script>
  function initGuideToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (!links.length || !("IntersectionObserver" in window)) return;
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => byId.set(l.dataset.tocLink ?? "", l));
    const headings = [...byId.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => Boolean(h));
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const current = headings.find((h) => visible.has(h.id));
        if (current) links.forEach((l) => l.classList.toggle("is-current", l.dataset.tocLink === current.id));
      },
      { rootMargin: "-20% 0px -65% 0px" },
    );
    headings.forEach((h) => io.observe(h));
    document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
  }
  initGuideToc();
</script>
