---
/**
 * Route links set as a typographic list, with approximate distance and drive time ("Lahore to Murree by car").
 *
 *   <RouteLinks routes={entries} exclude="lahore-to-islamabad" limit={6} />
 */
import { formatDriveTime, formatKm } from "@/lib/format";
import { urls } from "@/lib/urls";

interface RouteLike {
  data: { slug: string; to: string; distanceKm: number; driveHours: number };
}

interface Props {
  routes: RouteLike[];
  exclude?: string;
  /** Preferred slugs first (e.g. routes near an area). */
  prefer?: string[];
  limit?: number;
  /** "grid" = 1/2 columns; "stack" = one narrow column for side rails. */
  layout?: "grid" | "stack";
  class?: string;
}

const { routes, exclude, prefer = [], limit = 6, layout = "grid", class: className } = Astro.props;
const sorted = [...routes]
  .filter((r) => r.data.slug !== exclude)
  .sort((a, b) => {
    const pa = prefer.indexOf(a.data.slug);
    const pb = prefer.indexOf(b.data.slug);
    return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
  })
  .slice(0, limit);
---

<ul class:list={["grid border-t border-line", layout === "grid" && "md:grid-cols-2 md:gap-x-14", className]}>
  {
    sorted.map((r) => (
      <li class="border-b border-line">
        <a href={urls.route(r.data.slug)} class:list={["group flex flex-col gap-1", layout === "grid" ? "py-6" : "py-4"]}>
          <span class:list={["transition-colors duration-500 group-hover:text-accent-fg", layout === "grid" ? "text-display-sm text-fg" : "font-medium text-fg"]}>Lahore to {r.data.to} by car</span>
          <span class="text-sm text-muted tabular">
            about {formatKm(r.data.distanceKm)}, {formatDriveTime(r.data.driveHours)}
          </span>
        </a>
      </li>
    ))
  }
</ul>
