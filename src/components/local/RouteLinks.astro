---
/**
 * Grid of route links with approximate distance and drive time ("Lahore to Murree by car").
 *
 *   <RouteLinks routes={entries} exclude="lahore-to-islamabad" limit={6} />
 */
import Icon from "@/components/Icon.astro";
import { formatDriveTime, formatKm } from "@/lib/format";
import { urls } from "@/lib/urls";

interface RouteLike {
  data: { slug: string; to: string; distanceKm: number; driveHours: number };
}

interface Props {
  routes: RouteLike[];
  exclude?: string;
  /** Preferred slugs first (e.g. routes near an area). */
  prefer?: string[];
  limit?: number;
  /** "grid" = 1/2/3 columns; "stack" = 1 column on phones and desktop sidebars, 2 on tablets. */
  layout?: "grid" | "stack";
  class?: string;
}

const { routes, exclude, prefer = [], limit = 6, layout = "grid", class: className } = Astro.props;
const sorted = [...routes]
  .filter((r) => r.data.slug !== exclude)
  .sort((a, b) => {
    const pa = prefer.indexOf(a.data.slug);
    const pb = prefer.indexOf(b.data.slug);
    return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
  })
  .slice(0, limit);
---

<ul
  class:list={[
    "grid gap-px overflow-hidden rounded-card border border-line bg-line",
    layout === "grid" ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-1",
    className,
  ]}
>
  {
    sorted.map((r) => (
      <li class="bg-bg">
        <a href={urls.route(r.data.slug)} class="group flex h-full items-center justify-between gap-4 p-5 transition-colors duration-300 hover:bg-surface">
          <span class="flex flex-col gap-1">
            <span class="font-semibold text-fg">Lahore to {r.data.to} by car</span>
            <span class="text-xs text-muted tabular">
              about {formatKm(r.data.distanceKm)}, {formatDriveTime(r.data.driveHours)}
            </span>
          </span>
          <Icon name="ph:arrow-right" size={18} class="shrink-0 text-muted transition-[color,transform] duration-300 group-hover:translate-x-1 group-hover:text-accent" />
        </a>
      </li>
    ))
  }
</ul>
