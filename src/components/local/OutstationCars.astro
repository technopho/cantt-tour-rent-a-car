---
/**
 * Recommended cars for a route with catalog prices: outstation day rate with a driver and the
 * driver night allowance. Rows collapse to stacked cards on phones. Amounts come from the catalog.
 *
 *   <OutstationCars models={models} categories={categories} reasons={{ "toyota-fortuner": "..." }} />
 */
import CarVisual from "@/components/CarVisual.astro";
import Icon from "@/components/Icon.astro";
import PriceTag from "@/components/PriceTag.astro";
import type { CatalogCategory, CatalogModel } from "@/lib/catalog";
import { urls } from "@/lib/urls";
import { outstationDaily } from "./pricing";

interface Props {
  models: CatalogModel[];
  categories: CatalogCategory[];
  /** "outstation" shows outstation day rates; "city" shows the Lahore day rate (Wagah). */
  rate?: "outstation" | "city";
  class?: string;
}

const { models, categories, rate = "outstation", class: className } = Astro.props;
const catName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
const dayRate = (m: CatalogModel) => (rate === "city" ? (m.rates.withDriver?.daily ?? null) : outstationDaily(m));
---

<ul class:list={["flex flex-col gap-3", className]}>
  {
    models.map((m) => (
      <li class="group relative grid items-center gap-x-6 gap-y-4 rounded-card border border-line bg-surface p-4 transition-colors duration-300 hover:border-line-strong sm:grid-cols-[8.5rem_minmax(0,1fr)] md:grid-cols-[8.5rem_minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)_auto]">
        <CarVisual model={m} categoryName={catName(m.category)} decorative showName={false} sizes="136px" class="max-sm:hidden" />
        <div class="flex flex-col gap-1.5">
          <h3 class="text-display-sm text-fg">
            <a href={urls.car(m.slug)} class="after:absolute after:inset-0 after:rounded-card after:content-['']">
              {m.make} {m.model}
            </a>
          </h3>
          <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted">
            <span>{catName(m.category)}</span>
            <span class="flex items-center gap-1">
              <Icon name="ph:users" size={14} />
              {m.seats} seats
            </span>
            {typeof m.luggage === "number" && (
              <span class="flex items-center gap-1">
                <Icon name="ph:suitcase-rolling" size={14} />
                {m.luggage} bags
              </span>
            )}
          </p>
        </div>
        <div class="flex flex-col gap-0.5 sm:col-start-2 md:col-start-auto">
          <span class="text-xs font-semibold text-muted">{rate === "city" ? "City day with driver" : "Outstation with driver"}</span>
          <PriceTag amount={dayRate(m)} />
        </div>
        <div class="flex flex-col gap-0.5 sm:col-start-2 md:col-start-auto">
          <span class="text-xs font-semibold text-muted">{rate === "city" ? "Driver overtime" : "Driver night stay"}</span>
          {rate === "city" ? (
            <PriceTag amount={m.rates.withDriver?.overtimeHourly ?? null} unit="hour" from={false} size="sm" />
          ) : (
            <PriceTag amount={m.rates.driverNightAllowance} unit="night" from={false} size="sm" />
          )}
        </div>
        <Icon
          name="ph:arrow-up-right"
          size={20}
          class="absolute top-4 right-4 text-muted transition-[color,transform] duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent md:static"
        />
      </li>
    ))
  }
</ul>
