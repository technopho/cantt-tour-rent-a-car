---
/**
 * Recommended cars for a route with catalog prices: outstation day rate with a driver and the
 * driver night allowance. Rows collapse to stacked cards on phones. Amounts come from the catalog.
 * Cars with a picture come first and the name-only rows after them (picturesFirst), so a car's name never sits
 * straight above another car's picture, where it would read as that picture's label.
 *
 *   <OutstationCars models={models} categories={categories} reasons={{ "toyota-fortuner": "..." }} />
 */
import CarVisual from "@/components/CarVisual.astro";
import { picturesFirst } from "@/components/fleet/gallery-slots";
import PriceTag from "@/components/PriceTag.astro";
import type { CatalogCategory, CatalogModel } from "@/lib/catalog";
import { fleetImage } from "@/lib/media";
import { urls } from "@/lib/urls";
import { outstationDaily } from "./pricing";

interface Props {
  models: CatalogModel[];
  categories: CatalogCategory[];
  /** "outstation" shows outstation day rates; "city" shows the Lahore day rate (Wagah). */
  rate?: "outstation" | "city";
  class?: string;
}

const { models: given, categories, rate = "outstation", class: className } = Astro.props;
const catName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
const hasPicture = (m: CatalogModel) => (m.images?.length ?? 0) > 0 || Boolean(fleetImage(m.slug));
const models = picturesFirst(given, hasPicture);
const dayRate = (m: CatalogModel) => (rate === "city" ? (m.rates.withDriver?.daily ?? null) : outstationDaily(m));
---

<ul class:list={["border-t border-line", className]} data-fx="stagger">
  {
    models.map((m) => (
      <li class="group relative grid items-center gap-x-8 gap-y-4 border-b border-line py-6 md:grid-cols-[14rem_minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]">
        {hasPicture(m) ? <CarVisual model={m} categoryName={catName(m.category)} decorative showName={false} sizes="(min-width: 48rem) 224px, 100vw" /> : <span class="hidden md:block" aria-hidden="true" />}
        <div class="flex flex-col gap-2">
          <h3 class="text-display-sm text-fg transition-colors duration-500 group-hover:text-accent-fg">
            <a href={urls.car(m.slug)} class="after:absolute after:inset-0 after:content-['']" data-cursor="View">
              {m.make} {m.model}
            </a>
          </h3>
          <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
            <span>{catName(m.category)}</span>
            <span>{m.seats} seats</span>
            {typeof m.luggage === "number" && <span>{m.luggage} bags</span>}
          </p>
        </div>
        <div class="flex flex-col gap-1">
          <span class="label text-muted">{rate === "city" ? "City day with driver" : "Outstation with driver"}</span>
          <PriceTag amount={dayRate(m)} size="lg" />
        </div>
        <div class="flex flex-col gap-1">
          <span class="label text-muted">{rate === "city" ? "Driver overtime" : "Driver night stay"}</span>
          {rate === "city" ? (
            <PriceTag amount={m.rates.withDriver?.overtimeHourly ?? null} unit="hour" from={false} />
          ) : (
            <PriceTag amount={m.rates.driverNightAllowance} unit="night" from={false} />
          )}
        </div>
      </li>
    ))
  }
</ul>
