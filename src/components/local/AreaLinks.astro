---
/**
 * Links to other area pages with descriptive anchors ("Rent a car in Gulberg"), set as a typographic list.
 *
 *   <AreaLinks slugs={["gulberg", "model-town"]} areas={allAreaEntries} />
 */
import { urls } from "@/lib/urls";

interface AreaLike {
  id: string;
  data: { areaName: string; h1: string; distances: { to: string; minutes: number }[] };
}

interface Props {
  slugs: string[];
  areas: AreaLike[];
  class?: string;
}

const { slugs, areas, class: className } = Astro.props;
const items = slugs.map((s) => areas.find((a) => a.id === s)).filter((a): a is AreaLike => Boolean(a));
const airport = (a: AreaLike) => a.data.distances.find((d) => /airport/i.test(d.to))?.minutes;
---

{
  items.length > 0 && (
    <ul class:list={["grid border-t border-line md:grid-cols-2 md:gap-x-14", className]}>
      {items.map((a) => (
        <li class="border-b border-line">
          <a href={urls.area(a.id)} class="group flex flex-col gap-1 py-6">
            <span class="text-display-sm text-fg transition-colors duration-500 group-hover:text-accent-fg">{a.data.h1}</span>
            {typeof airport(a) === "number" && <span class="text-sm text-muted tabular">Airport in about {airport(a)} min</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
