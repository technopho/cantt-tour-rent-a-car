---
/**
 * "Departures board" of approximate drive times from an area (area page hero aside).
 * Data comes from the area content (distances: to, km, minutes). Bars show minutes relative to
 * the longest trip. CSS-only load animation (transform/opacity), static under reduced motion.
 *
 *   <DistanceBoard from="DHA Lahore" distances={entry.data.distances} />
 */
import Icon from "@/components/Icon.astro";
import { formatKm } from "@/lib/format";
import { iconForLabel } from "./geo";

interface Props {
  from: string;
  distances: { to: string; km: number; minutes: number }[];
  class?: string;
}

const { from, distances, class: className } = Astro.props;
const max = Math.max(...distances.map((d) => d.minutes), 1);
const minutesLabel = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h${m % 60 ? ` ${m % 60}` : ""}` : String(m));
const minutesUnit = (m: number) => (m >= 60 ? (m % 60 ? "min" : "") : "min");
---

{
  distances.length > 0 && (
    <section class:list={["board border-t border-line", className]} aria-labelledby="board-title">
      <header class="flex items-baseline justify-between gap-4 border-b border-line py-4">
        <h2 id="board-title" class="label text-fg">
          From {from}
        </h2>
        <span class="text-xs text-muted">Approx., normal traffic</span>
      </header>
      <ol class="divide-y divide-line">
        {distances.map((d, i) => (
          <li class="board-row relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-4 py-4" style={`--i:${i};--p:${(d.minutes / max).toFixed(3)}`}>
            <Icon name={iconForLabel(d.to)} size={20} class="text-accent" />
            <span class="min-w-0">
              <span class="block leading-snug text-fg">{d.to}</span>
              <span class="tabular block text-xs text-muted">about {formatKm(d.km)}</span>
            </span>
            <span class="board-time text-right text-[1.625rem] leading-none text-fg tabular">
              <span class="board-flip inline-block">{minutesLabel(d.minutes)}</span>
              <span class="ml-0.5 text-xs text-muted">{minutesUnit(d.minutes)}</span>
            </span>
            <span class="board-bar pointer-events-none absolute bottom-0 left-0 h-px w-full origin-left bg-accent" aria-hidden="true" />
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .board-bar {
    transform: scaleX(var(--p));
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: no-preference) {
    .board-bar {
      animation: board-bar 1.1s var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms + 250ms);
    }
    .board-flip {
      animation: board-flip 0.7s var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms + 150ms);
      transform-origin: 50% 0%;
    }
  }
  @keyframes board-bar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(var(--p));
    }
  }
  @keyframes board-flip {
    from {
      opacity: 0;
      transform: perspective(240px) rotateX(-80deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
