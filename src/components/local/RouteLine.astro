---
/**
 * Vertical "transit line" of a road trip: Lahore pickup -> stops -> destination.
 * The line grows with scroll where CSS scroll-driven animations exist (transform only);
 * otherwise, and under reduced motion, it is simply drawn.
 */
interface Props {
  to: string;
  stops: string[];
  roads: string[];
  class?: string;
}

const { to, stops, roads, class: className } = Astro.props;
const points = [
  { name: "Lahore", note: "Pickup at your door: home, hotel, office or the airport", kind: "origin" },
  ...stops.map((s) => ({ name: s, note: "", kind: "stop" })),
  { name: to, note: "Destination", kind: "dest" },
];
---

<div class:list={["route-line-wrap", className]}>
  {
    roads.length > 0 && (
      <ul class="mb-10 flex flex-wrap gap-x-6 gap-y-2 border-b border-line pb-6 text-sm text-muted" aria-label="Roads on this route">
        {roads.map((r) => (
          <li>{r}</li>
        ))}
      </ul>
    )
  }
  <div class="relative">
  <span class="route-rail" aria-hidden="true"></span>
  <ol class="route-line relative flex flex-col">
    {
      points.map((p) => (
        <li class:list={["route-stop relative grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-4 pb-8 last:pb-0", `route-stop--${p.kind}`]} data-reveal="fade">
          <span class="route-dot relative z-10 mt-1 grid size-[1.125rem] place-items-center justify-self-center rounded-full" aria-hidden="true" />
          <span class="flex flex-col gap-1">
            <span class:list={["text-fg", p.kind === "stop" ? "text-lg" : "text-display-md"]}>{p.name}</span>
            {p.note && <span class="text-sm text-muted">{p.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>
  </div>
</div>

<style>
  .route-rail {
    position: absolute;
    left: calc(0.875rem - 0.5px);
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), color-mix(in oklab, var(--accent) 45%, var(--line-strong)));
    transform-origin: 50% 0;
  }
  .route-dot {
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .route-stop--origin .route-dot,
  .route-stop--dest .route-dot {
    margin-top: 0.7rem;
    border: 0;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }
  /* The destination glows brass: ember is kept for tail-lights. */
  .route-stop--dest .route-dot {
    background: var(--accent-fill-hover);
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 16px 2px color-mix(in oklab, var(--accent) 55%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .route-rail {
        animation: route-grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 55%;
      }
    }
  }
  @keyframes route-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
