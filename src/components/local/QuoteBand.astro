---
/**
 * Quote section for area, route and hub pages: heading + the TripComposer island (prefilled)
 * + WhatsApp / call alternatives, over a dim image when one is given. Carries data-fab-hide because it
 * already offers WhatsApp. The island hydrates only when visible (client:visible).
 *
 *   <QuoteBand title="Get a quote for DHA Lahore" defaultPickup="DHA Lahore" whatsappMessage="..." />
 *   <QuoteBand title="..." defaultTripType="outstation" defaultDestination="Islamabad" plate={plate} />
 */
import Button from "@/components/Button.astro";
import TripComposer from "@/components/quote/TripComposer.svelte";
import { primaryPhone, site } from "@/config/site";
import { getCategories, getModels } from "@/lib/catalog";
import type { ServiceType, TripType } from "@/lib/catalog-types";
import { toComposerModels } from "@/lib/composer";
import { telUrl, whatsappUrl } from "@/lib/links";
import type { Plate } from "./plates";

interface Props {
  id?: string;
  title: string;
  intro?: string;
  defaultModelSlug?: string;
  defaultServiceType?: ServiceType;
  defaultTripType?: TripType;
  defaultPickup?: string;
  defaultDestination?: string;
  whatsappMessage?: string;
  /** Bullet points next to the composer (what happens after you ask). */
  points?: string[];
  plate?: Plate;
}

const {
  id = "quote",
  title,
  intro,
  defaultModelSlug,
  defaultServiceType,
  defaultTripType,
  defaultPickup,
  defaultDestination,
  whatsappMessage,
  points = [
    "Tell us the car, dates and pickup point",
    "We reply on WhatsApp with a clear price",
    "Confirm, and the car arrives on time",
  ],
  plate,
} = Astro.props;

const [models, categories] = await Promise.all([getModels(), getCategories()]);
const composerModels = toComposerModels(models, categories);
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} data-fab-hide class="relative isolate scroll-mt-[var(--header-h)] overflow-hidden border-t border-line py-section">
  {
    plate && (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <img src={plate.img.src} srcset={plate.img.srcset || undefined} sizes="100vw" width={plate.img.width} height={plate.img.height} alt="" loading="lazy" decoding="async" class="size-full object-cover opacity-30" style={plate.position ? `object-position:${plate.position}` : undefined} />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,var(--bg)_0%,rgb(7_7_8/0.55)_40%,var(--bg)_100%)]"></div>
      </div>
    )
  }
  {
    plate?.caption && (
      <p class="absolute right-(--gutter) bottom-4 text-[0.625rem] leading-none tracking-[0.04em] text-fg/55">
        {plate.caption.startsWith("Photo:")
          ? plate.caption.replace(/^Photo:/, "Background photo:")
          : `Background: ${plate.caption.replace(/^Representative image/, "representative image")}`}
      </p>
    )
  }
  <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
    <div class="flex flex-col gap-8">
      <h2 id={headingId} class="text-display-lg text-fg" data-fx="lines">{title}</h2>
      {intro && <p class="text-lede max-w-xl text-muted" data-fx="fade">{intro}</p>}
      <ol class="flex flex-col border-t border-line" data-fx="stagger">
        {
          points.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] border-b border-line py-4 text-fg">
              <span class="pt-0.5 text-sm text-accent-fg tabular">{String(i + 1).padStart(2, "0")}</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>
      <div class="flex flex-wrap gap-3">
        <Button href={whatsappUrl(whatsappMessage ?? site.whatsappMessage)} variant="secondary" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
          {site.cta.whatsapp.label}
        </Button>
        <Button href={telUrl()} variant="ghost" icon="ph:phone">
          {site.cta.call.label}
          <span class="sr-only">{primaryPhone.display}</span>
        </Button>
      </div>
      <a href={telUrl()} class="link-draw self-start text-lede text-fg tabular">{primaryPhone.display}</a>
    </div>
    <div class="min-w-0">
      <TripComposer
        client:visible
        models={composerModels}
        defaultModelSlug={defaultModelSlug}
        defaultServiceType={defaultServiceType}
        defaultTripType={defaultTripType}
        defaultPickup={defaultPickup}
        defaultDestination={defaultDestination}
        compact
      />
    </div>
  </div>
</section>
