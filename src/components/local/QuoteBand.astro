---
/**
 * Quote section for area, route and hub pages: heading + the TripComposer island (prefilled)
 * + WhatsApp / call alternatives. Carries data-fab-hide because it already offers WhatsApp.
 * The island hydrates only when visible (client:visible), so it costs nothing above the fold.
 *
 *   <QuoteBand title="Get a quote for DHA Lahore" defaultPickup="DHA Lahore" whatsappMessage="..." />
 *   <QuoteBand title="..." defaultTripType="outstation" defaultDestination="Islamabad" />
 */
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import Section from "@/components/Section.astro";
import TripComposer from "@/components/quote/TripComposer.svelte";
import { primaryPhone, site } from "@/config/site";
import { getCategories, getModels } from "@/lib/catalog";
import type { ServiceType, TripType } from "@/lib/catalog-types";
import { toComposerModels } from "@/lib/composer";
import { telUrl, whatsappUrl } from "@/lib/links";

interface Props {
  id?: string;
  title: string;
  intro?: string;
  defaultModelSlug?: string;
  defaultServiceType?: ServiceType;
  defaultTripType?: TripType;
  defaultPickup?: string;
  defaultDestination?: string;
  whatsappMessage?: string;
  /** Bullet points next to the composer (what happens after you ask). */
  points?: string[];
}

const {
  id = "quote",
  title,
  intro,
  defaultModelSlug,
  defaultServiceType,
  defaultTripType,
  defaultPickup,
  defaultDestination,
  whatsappMessage,
  points = [
    "Tell us the car, dates and pickup point",
    "We reply on WhatsApp with a clear price",
    "Confirm, and the car arrives on time",
  ],
} = Astro.props;

const [models, categories] = await Promise.all([getModels(), getCategories()]);
const composerModels = toComposerModels(models, categories);
const headingId = `${id}-title`;
---

<Section id={id} labelledby={headingId} divider data-fab-hide class="scroll-mt-[var(--header-h)]">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
    <div class="flex flex-col gap-6">
      <h2 id={headingId} class="text-display-lg text-fg">{title}</h2>
      {intro && <p class="text-lede max-w-xl text-muted">{intro}</p>}
      <ol class="flex flex-col gap-3">
        {
          points.map((p, i) => (
            <li class="flex items-center gap-3 text-fg">
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line font-display text-sm font-semibold text-accent-fg tabular">
                {i + 1}
              </span>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>
      <div class="flex flex-wrap gap-3">
        <Button href={whatsappUrl(whatsappMessage ?? site.whatsappMessage)} variant="secondary" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
          {site.cta.whatsapp.label}
        </Button>
        <Button href={telUrl()} variant="ghost" icon="ph:phone">
          {site.cta.call.label}
        </Button>
      </div>
      <p class="flex items-center gap-2 text-sm text-muted">
        <Icon name="ph:phone" size={16} class="text-accent" />
        <span class="tabular">{primaryPhone.display}</span>
      </p>
    </div>
    <div class="min-w-0">
      <TripComposer
        client:visible
        models={composerModels}
        defaultModelSlug={defaultModelSlug}
        defaultServiceType={defaultServiceType}
        defaultTripType={defaultTripType}
        defaultPickup={defaultPickup}
        defaultDestination={defaultDestination}
        compact
      />
    </div>
  </div>
</Section>
