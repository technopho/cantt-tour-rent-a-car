---
/**
 * Car image slot with a fixed 16:10 frame (no layout shift).
 *  - With photos: plain <img srcset> from R2 (pre-generated 480/960/1600 widths). Not astro:assets.
 *  - Without photos: a branded night-drive panel (category icon on a polished floor, model name
 *    in display type, tail-light glow from the tokens).
 *
 *   <CarVisual model={model} categoryName="SUVs" />
 *   <CarVisual model={model} priority sizes="(min-width: 1024px) 50vw, 100vw" />   LCP image
 *   <CarVisual model={model} decorative />    when the name is already shown next to it
 */
import type { CatalogModel } from "@/lib/catalog-types";
import Icon from "./Icon.astro";

type VisualModel = Pick<CatalogModel, "make" | "model" | "category" | "images"> & Partial<Pick<CatalogModel, "variant">>;

interface Props {
  model: VisualModel;
  /** Category label shown as a small badge on the placeholder panel (e.g. "SUVs"). */
  categoryName?: string;
  /** Above-the-fold hero image: eager load + fetchpriority high. Max one per page. */
  priority?: boolean;
  sizes?: string;
  /** Hide from assistive tech (use when the model name is rendered next to the visual). */
  decorative?: boolean;
  /** Show the model name on the placeholder panel. Default true. */
  showName?: boolean;
  class?: string;
}

const {
  model,
  categoryName,
  priority = false,
  sizes = "(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  decorative = false,
  showName = true,
  class: className,
} = Astro.props;

/** Phosphor vehicle icon per category slug. */
const CATEGORY_ICONS: Record<string, string> = {
  hatchback: "ph:car-simple",
  sedan: "ph:car-profile",
  suv: "ph:jeep",
  luxury: "ph:car-profile",
  wedding: "ph:car-profile",
  van: "ph:van",
  coaster: "ph:bus",
};

const name = `${model.make} ${model.model}`;
const cover = model.images[0];
const icon = CATEGORY_ICONS[model.category] ?? "ph:car-profile";
const label = categoryName ? `${name}, ${categoryName}` : name;
---

<figure
  class:list={[
    "car-visual relative isolate aspect-[16/10] w-full overflow-hidden rounded-card bg-surface-2 [container-type:inline-size]",
    className,
  ]}
>
  {
    cover ? (
      <img
        src={cover.src}
        srcset={cover.srcset || undefined}
        sizes={cover.srcset ? sizes : undefined}
        width={cover.width}
        height={cover.height}
        alt={decorative ? "" : cover.alt || name}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0"
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : label}
        aria-hidden={decorative ? "true" : undefined}
      >
        {/* Night sky to floor */}
        <div class="absolute inset-0 bg-[linear-gradient(172deg,var(--surface-2)_0%,var(--surface)_62%,var(--bg)_100%)]" />
        {/* Tail-light glow on the floor */}
        <div class="absolute inset-x-0 bottom-0 h-[62%] bg-[radial-gradient(46%_58%_at_50%_100%,color-mix(in_oklab,var(--accent)_24%,transparent),transparent_72%)]" />
        {/* Light trails behind the car */}
        <div class="absolute top-[54%] left-0 h-px w-[46%] bg-[linear-gradient(90deg,transparent,color-mix(in_oklab,var(--accent)_70%,transparent))] opacity-70" />
        <div class="absolute top-[58%] left-[6%] h-px w-[30%] bg-[linear-gradient(90deg,transparent,color-mix(in_oklab,var(--accent)_45%,transparent))] opacity-60" />
        <div class="absolute top-[56%] right-0 h-px w-[40%] bg-[linear-gradient(270deg,transparent,color-mix(in_oklab,var(--text)_55%,transparent))] opacity-40" />
        {/* Floor line */}
        <div class="absolute inset-x-[6%] top-[66%] h-px bg-[linear-gradient(90deg,transparent,var(--line-strong),transparent)] opacity-35" />

        {/* Vehicle + reflection on the polished floor */}
        <div class="absolute top-[66%] left-1/2 aspect-square w-[34cqi] -translate-x-1/2 -translate-y-[88%] text-fg/90 transition-transform duration-700 ease-(--ease-out) group-hover:-translate-y-[91%]">
          <Icon name={icon} size="100%" class="size-full drop-shadow-[0_10px_18px_rgb(0_0_0/0.35)]" />
        </div>
        <div class="absolute top-[66%] left-1/2 aspect-square w-[34cqi] -translate-x-1/2 -translate-y-[12%] -scale-y-100 text-fg opacity-[0.1] [mask-image:linear-gradient(to_top,black,transparent_55%)]">
          <Icon name={icon} size="100%" class="size-full" />
        </div>

        {categoryName && (
          <span class="absolute top-[5cqi] left-[5cqi] rounded-badge border border-line bg-bg/40 px-2 py-1 text-[clamp(0.625rem,2.6cqi,0.75rem)] font-bold uppercase tracking-[0.14em] text-muted backdrop-blur-sm">
            {categoryName}
          </span>
        )}

        {showName && (
          <span class="absolute bottom-[5cqi] left-[5cqi] right-[5cqi] font-display text-[clamp(0.9375rem,5.4cqi,1.875rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-balance text-fg">
            <span class="block text-[0.62em] font-medium tracking-[-0.01em] text-muted">{model.make}</span>{" "}
            {model.model}
          </span>
        )}
      </div>
    )
  }
</figure>
