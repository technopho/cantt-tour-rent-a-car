---
/**
 * Car image slot with a fixed 16:10 frame (no layout shift).
 *  - A real catalog photo: plain <img srcset> from R2 (pre-generated 480/960/1600 widths). Not astro:assets.
 *  - No photo: the AI image for this slug from src/data/media.json, captioned "Representative image".
 *  - Neither: a dignified typographic panel. Never a car icon standing in for a car.
 * The image zooms slowly on hover, and when a surrounding .group is hovered.
 *
 *   <CarVisual model={model} categoryName="SUVs" />
 *   <CarVisual model={model} priority sizes="(min-width: 1024px) 50vw, 100vw" />   LCP image
 *   <CarVisual model={model} decorative />    when the name is already shown next to it
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { fleetImage } from "@/lib/media";

type VisualModel = Pick<CatalogModel, "make" | "model" | "category" | "images"> & Partial<Pick<CatalogModel, "variant" | "slug">>;

interface Props {
  model: VisualModel;
  /** Category label shown as a small label on the typographic panel (e.g. "SUVs"). */
  categoryName?: string;
  /** Above-the-fold hero image: eager load + fetchpriority high. Max one per page. */
  priority?: boolean;
  sizes?: string;
  /** Hide from assistive tech (use when the model name is rendered next to the visual). */
  decorative?: boolean;
  /** Show the model name as readable text on the typographic panel. Default true. */
  showName?: boolean;
  class?: string;
}

const {
  model,
  categoryName,
  priority = false,
  sizes = "(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw",
  decorative = false,
  showName = true,
  class: className,
} = Astro.props;

const name = `${model.make} ${model.model}`;
const photo = model.images[0];
const representative = photo ? undefined : fleetImage(model.slug);
const cover = photo ?? representative;
const label = categoryName ? `${name}, ${categoryName}` : name;
---

<figure
  class:list={[
    "car-visual relative isolate aspect-[16/10] w-full overflow-hidden rounded-card bg-surface [container-type:inline-size]",
    className,
  ]}
>
  {
    cover ? (
      <img
        src={cover.src}
        srcset={cover.srcset || undefined}
        sizes={cover.srcset ? sizes : undefined}
        width={cover.width}
        height={cover.height}
        alt={decorative ? "" : cover.alt || name}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
        class="car-visual__img absolute inset-0 size-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0"
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : label}
        aria-hidden={decorative ? "true" : undefined}
      >
        <div class="absolute inset-0 bg-[radial-gradient(70%_90%_at_72%_18%,color-mix(in_oklab,var(--accent)_10%,transparent),transparent_70%),linear-gradient(180deg,var(--surface-2),var(--surface)_70%)]"></div>
        <div class="car-visual__img absolute inset-0">
          <span class="absolute right-[-0.04em] bottom-[-0.12em] font-display text-[46cqi] leading-none whitespace-nowrap text-transparent italic [-webkit-text-stroke:1px_var(--line-strong)]" aria-hidden="true">
            {model.model.slice(0, 1)}
          </span>
        </div>
        <div class="absolute inset-x-[6cqi] bottom-[6cqi] h-px bg-line"></div>
        {categoryName && <span class="label absolute top-[6cqi] left-[6cqi] text-accent-fg">{categoryName}</span>}
        {
          showName && (
            <span class="absolute bottom-[9cqi] left-[6cqi] right-[6cqi] flex flex-col gap-1 text-fg">
              <span class="label text-muted">{model.make}</span>
              <span class="font-display text-[max(1.75rem,10cqi)] leading-none text-balance">{model.model}</span>
            </span>
          )
        }
      </div>
    )
  }
  {
    representative && (
      <figcaption class="absolute right-0 bottom-0 z-[1] bg-bg/60 px-2 py-1 text-[0.625rem] leading-none tracking-[0.04em] text-fg/80 backdrop-blur-sm">
        Representative image
      </figcaption>
    )
  }
</figure>

<style>
  .car-visual__img {
    transition: transform 2.2s var(--ease-heavy);
    will-change: transform;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .car-visual:hover .car-visual__img,
    :global(.group:hover) .car-visual .car-visual__img {
      transform: scale(1.06);
    }
  }
</style>
