---
/**
 * Button / link: a rectangle with a hairline border and a brass fill that slides in on hover (transform
 * only). Magnetic on fine pointers. Styles live in global.css (.btn), so a plain <a class="btn btn-primary
 * btn-md"> looks the same.
 *
 *   <Button href="/quote/">Get a quote</Button>                                  primary link
 *   <Button href={whatsappUrl()} variant="secondary" icon="simple-icons:whatsapp" external>WhatsApp us</Button>
 *   <Button href={telUrl()} variant="ghost" icon="ph:phone">Call now</Button>
 *   <Button type="submit" size="lg" iconRight="ph:arrow-right">Send request</Button>
 *   <Button href={telUrl()} iconOnly icon="ph:phone" label="Call now" variant="secondary" />
 *
 * Labels: one label per intent across the site: "Get a quote", "WhatsApp us", "Call now".
 * Extra attributes (data-*, aria-*, id, ...) pass through to the <a>/<button>. A data-fx value is merged
 * with the magnetic effect.
 */
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";

type Variant = "primary" | "secondary" | "ghost";
type Size = "sm" | "md" | "lg";

interface Props extends Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  size?: Size;
  /** Leading icon name (Icon.astro). */
  icon?: string;
  /** Trailing icon name; nudges right on hover. */
  iconRight?: string;
  /** Colour class for the leading icon, e.g. "text-whatsapp". */
  iconClass?: string;
  /** Opens in a new tab with rel="noopener noreferrer". */
  external?: boolean;
  /** Square icon-only button. Requires `label`. */
  iconOnly?: boolean;
  /** Accessible name (required for iconOnly). */
  label?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  /** Lean toward the pointer on fine pointers. Default true. */
  magnetic?: boolean;
  class?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  icon,
  iconRight,
  iconClass,
  external = false,
  iconOnly = false,
  label,
  fullWidth = false,
  disabled = false,
  magnetic = true,
  class: className,
  "data-fx": dataFx,
  ...rest
} = Astro.props as Props & { "data-fx"?: string };

const iconSizes: Record<Size, number> = { sm: 15, md: 16, lg: 18 };

const classes = ["btn group/btn", `btn-${variant}`, `btn-${size}`, iconOnly && "btn-icon", fullWidth && "w-full", className];
const fx = [dataFx, magnetic && !iconOnly && !disabled && "magnetic"].filter(Boolean).join(" ") || undefined;
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href && !disabled ? (
    <a href={href} class:list={classes} aria-label={label} data-fx={fx} {...externalAttrs} {...rest}>
      {icon && <Icon name={icon} size={iconSizes[size]} class={iconClass} />}
      {!iconOnly && <slot />}
      {iconRight && (
        <Icon name={iconRight} size={iconSizes[size]} class="transition-transform duration-700 ease-(--ease-out) group-hover/btn:translate-x-1" />
      )}
    </a>
  ) : (
    <button type={type} class:list={classes} aria-label={label} disabled={disabled} data-fx={fx} {...rest}>
      {icon && <Icon name={icon} size={iconSizes[size]} class={iconClass} />}
      {!iconOnly && <slot />}
      {iconRight && (
        <Icon name={iconRight} size={iconSizes[size]} class="transition-transform duration-700 ease-(--ease-out) group-hover/btn:translate-x-1" />
      )}
    </button>
  )
}
