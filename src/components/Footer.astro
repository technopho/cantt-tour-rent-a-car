---
/**
 * Site footer (rendered by BaseLayout): closing CTA band, NAP exactly as site.ts, hours,
 * link columns (services, areas, routes, company) and small print. The CTA band carries
 * data-fab-hide so the floating WhatsApp button steps aside when it is on screen.
 */
import { formatOpeningHours, primaryPhone, site, socialLinks } from "@/config/site";
import { mailtoUrl, mapsUrl, telUrl, whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";
import Button from "./Button.astro";
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  /** Hide the closing CTA band (e.g. on the quote page where the form is the CTA). */
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
const hours = formatOpeningHours();
const social = socialLinks();
const a = site.address;

const columns = [
  { title: "Services", links: site.services.map((s) => ({ label: s.name, href: urls.service(s.slug) })) },
  { title: "Areas we serve", links: site.areasServed.map((ar) => ({ label: ar.name, href: urls.area(ar.slug) })) },
  { title: "Outstation", links: site.routes.map((r) => ({ label: `Lahore to ${r.city}`, href: urls.route(r.slug) })) },
  { title: "Company", links: site.nav.company },
];
---

<footer class="relative isolate overflow-hidden border-t border-line bg-bg">
  {
    !hideCta && (
      <section aria-labelledby="footer-cta-title" class="relative" data-fab-hide>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[70%] bg-[radial-gradient(60%_80%_at_50%_100%,color-mix(in_oklab,var(--accent)_16%,transparent),transparent_70%)]"
          aria-hidden="true"
        />
        <Container class="grid items-end gap-10 py-section lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
          <div>
            <h2 id="footer-cta-title" class="text-display-lg text-fg">
              Gari chahiye? <span class="text-accent">We're on WhatsApp.</span>
            </h2>
            <p class="text-lede mt-5 max-w-xl text-muted">
              Tell us the car, the dates and where to pick you up. We reply with a clear price.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 lg:justify-end">
            <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">
              {site.cta.quote.label}
            </Button>
            <Button
              href={whatsappUrl()}
              variant="secondary"
              size="lg"
              icon="simple-icons:whatsapp"
              iconClass="text-whatsapp"
              external
            >
              {site.cta.whatsapp.label}
            </Button>
            <Button href={telUrl()} variant="ghost" size="lg" icon="ph:phone">
              {site.cta.call.label}
            </Button>
          </div>
        </Container>
        <div class="rule-fade mx-auto max-w-site" aria-hidden="true" />
      </section>
    )
  }

  <Container class="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.35fr_repeat(4,minmax(0,1fr))] lg:gap-10">
    <div class="flex flex-col gap-6 sm:col-span-2 lg:col-span-1">
      <Logo size="lg" />
      <p class="max-w-xs text-sm text-muted">{site.tagline}</p>

      <address class="flex flex-col gap-3 text-sm not-italic text-muted">
        <span class="font-semibold text-fg">{site.name}</span>
        <a href={mapsUrl()} class="flex gap-2.5 transition-colors hover:text-fg" target="_blank" rel="noopener noreferrer">
          <Icon name="ph:map-pin" size={18} class="mt-0.5 text-accent" />
          <span>
            {[a.street, a.area, a.city].filter(Boolean).join(", ")}
            <br />
            {`${[a.region, a.postalCode].filter(Boolean).join(" ")}, ${a.countryName}`}
          </span>
        </a>
        <a href={telUrl()} class="flex items-center gap-2.5 transition-colors hover:text-fg">
          <Icon name="ph:phone" size={18} class="text-accent" />
          <span class="tabular">{primaryPhone.display}</span>
        </a>
        <a href={whatsappUrl()} class="flex items-center gap-2.5 transition-colors hover:text-fg" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:whatsapp" size={16} class="mx-px text-whatsapp" />
          <span>{site.cta.whatsapp.label}</span>
        </a>
        <a href={mailtoUrl()} class="flex items-center gap-2.5 break-all transition-colors hover:text-fg">
          <Icon name="ph:envelope-simple" size={18} class="text-accent" />
          <span>{site.email}</span>
        </a>
        <span class="flex gap-2.5">
          <Icon name="ph:clock" size={18} class="mt-0.5 text-accent" />
          <span>{hours.map((line) => <span class="block">{line}</span>)}</span>
        </span>
      </address>

      {
        social.length > 0 && (
          <ul class="flex gap-2" aria-label="Social media">
            {social.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex size-10 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
                >
                  <Icon name={s.icon} size={16} label={s.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-fg">{col.title}</h2>
          <ul class="mt-4 flex flex-col gap-2.5 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-muted transition-colors hover:text-fg">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </Container>

  <Container class="flex flex-col gap-2 border-t border-line py-6 text-xs text-muted md:flex-row md:items-center md:justify-between">
    <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    <p>Prices on this site are estimates. Our team confirms the final price before you book.</p>
  </Container>
</footer>
