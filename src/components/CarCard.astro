---
/**
 * Fleet card used across the site (home garage, service pages, /cars/, category and model pages). Not a box:
 * an image, a hairline that draws on hover, the name in Bodoni, the price small. The whole card is one link
 * (stretched heading link, so there is exactly one tab stop per card) and shows the "View" cursor.
 *
 *   <CarCard model={model} categoryName="Sedans" />                      default (grid card)
 *   <CarCard model={model} variant="compact" headingLevel="h4" />        related models, sidebars
 *   <CarCard model={model} variant="wide" categoryName="SUVs" />         horizontal on md+ (lists, short grids)
 *   <CarCard model={model} priority sizes="(min-width: 1024px) 50vw, 100vw" />   above-the-fold photo
 *
 * Props stay backward compatible (model, categoryName, href, headingLevel, priority, sizes, class, variant,
 * maxChips). `tilt` is still accepted and no longer does anything: the card sits still, the image moves.
 *
 * Contents: photo (CarVisual falls back to the representative image, then a typographic panel), category,
 * make + model (+ variant and years), with driver / self drive, seats, gearbox, fuel, bags, "suitable for"
 * and the catalog "from Rs X/day" price.
 *
 * The <article> exposes data-category, data-driver and data-self-drive for client-side filters.
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { fuelLabel, modelYears, transmissionLabel } from "@/lib/catalog";
import { formatPKR } from "@/lib/format";
import { urls } from "@/lib/urls";
import CarVisual from "./CarVisual.astro";
import PriceTag from "./PriceTag.astro";
import { CITY_DAY_HOURS, fromPriceBasis, modelUseCases, offersDriver, offersSelfDrive, singularName } from "./fleet/fleet-data";

type Variant = "default" | "compact" | "wide";

interface Props {
  model: CatalogModel;
  /** Category label (e.g. "SUVs", shown as "SUV"). */
  categoryName?: string;
  href?: string;
  headingLevel?: "h2" | "h3" | "h4";
  /** Above-the-fold photo: eager + fetchpriority high. Max one per page. */
  priority?: boolean;
  sizes?: string;
  class?: string;
  variant?: Variant;
  /** Max "suitable for" items. Defaults: default 3, wide 5, compact 0. */
  maxChips?: number;
  /** Accepted for compatibility; no effect. */
  tilt?: boolean;
}

const {
  model,
  categoryName,
  href = urls.car(model.slug),
  headingLevel: Heading = "h3",
  priority = false,
  sizes,
  class: className,
  variant = "default",
  maxChips,
} = Astro.props;

const driver = offersDriver(model);
const selfDrive = offersSelfDrive(model);
const years = modelYears(model);
const basis = fromPriceBasis(model);
const isCompact = variant === "compact";
const isWide = variant === "wide";

const chipLimit = maxChips ?? (isWide ? 5 : isCompact ? 0 : 3);
// "Self drive" is already shown as an availability, so it is not repeated here.
const chips = modelUseCases(model)
  .filter((u) => u.tag !== "self_drive")
  .slice(0, chipLimit);

const specs = [
  `${model.seats} seats`,
  transmissionLabel(model.transmission),
  fuelLabel(model.fuel),
  model.luggage ? `${model.luggage} ${model.luggage === 1 ? "bag" : "bags"}` : null,
].filter((s): s is string => s !== null);
const shownSpecs = isCompact ? specs.slice(0, 2) : specs;

const availability = [driver && "With driver", selfDrive && "Self drive"].filter((s): s is string => Boolean(s));

const defaultSizes = isWide
  ? "(min-width: 1280px) 620px, (min-width: 768px) 48vw, 100vw"
  : isCompact
    ? "(min-width: 1280px) 340px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
    : "(min-width: 1280px) 480px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";

/**
 * Wide cards list the other headline rates (with driver day, outstation day, self drive day). The rate
 * the "from" price already shows is left out so no number appears twice.
 */
const wideRates = [
  model.rates.withDriver && basis !== "with driver" ? { label: `With driver, ${CITY_DAY_HOURS} hour day`, value: model.rates.withDriver.daily } : null,
  model.rates.withDriver?.outstationDaily ? { label: "Outstation, per day", value: model.rates.withDriver.outstationDaily } : null,
  model.rates.selfDrive && basis !== "self drive" ? { label: "Self drive, per day", value: model.rates.selfDrive.daily } : null,
].filter((r): r is { label: string; value: number } => r !== null);

const basisText = basis === "self drive" ? "Self drive rate" : basis === "with driver" ? `With driver, ${CITY_DAY_HOURS} hour day` : null;
---

<article
  class:list={["car-card group relative isolate flex h-full", isWide ? "flex-col md:flex-row md:gap-10" : "flex-col", className]}
  data-car-card
  data-variant={variant}
  data-cursor="View"
  data-category={model.category}
  data-driver={String(driver)}
  data-self-drive={String(selfDrive)}
>
  <div class:list={["car-card__media relative", isWide && "md:min-h-72 md:w-[52%] md:shrink-0"]}>
    <CarVisual
      model={model}
      priority={priority}
      sizes={sizes ?? defaultSizes}
      decorative
      showName={false}
      class={isWide ? "md:absolute md:inset-0 md:aspect-auto md:h-full" : undefined}
    />
  </div>

  <div class:list={["flex flex-1 flex-col", isCompact ? "gap-2 pt-3" : "gap-3 pt-4", isWide && "md:justify-center md:pt-0"]}>
    <div class="car-card__rule relative h-px bg-line" aria-hidden="true"></div>

    <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      {categoryName && <span class="label text-accent-fg">{singularName(categoryName)}</span>}
      {!isCompact && availability.length > 0 && <span class="text-xs text-muted">{availability.join(" · ")}</span>}
    </div>

    <Heading class:list={["text-fg", isWide ? "text-display-md" : "text-display-sm"]}>
      <a href={href} class="car-card__link outline-none after:absolute after:inset-0 after:z-10 after:content-['']">
        <span class="block font-sans text-[0.8125rem] leading-normal font-normal tracking-normal text-muted">{model.make}</span>{" "}
        <span class="block">{model.model}</span>
      </a>
    </Heading>

    {!isCompact && (model.variant || years) && <p class="text-sm text-muted">{[model.variant, years].filter(Boolean).join(" · ")}</p>}

    {isWide && <p class="max-w-prose text-[0.9375rem] leading-relaxed text-muted">{model.shortDescription}</p>}

    <p class="text-sm text-muted">{shownSpecs.join(" · ")}</p>

    {
      chips.length > 0 && (
        <p class="text-xs text-muted">
          <span class="sr-only">Suitable for: </span>
          {chips.map((u) => u.label).join(", ")}
        </p>
      )
    }

    {
      isWide && wideRates.length > 0 && (
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
          {wideRates.map((r) => (
            <div>
              <dt class="text-xs text-muted">{r.label}</dt>
              <dd class="tabular mt-0.5 font-medium text-fg">{formatPKR(r.value)}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class:list={["mt-auto flex items-end justify-between gap-4", isCompact ? "pt-1" : "pt-2"]}>
      <div class="flex flex-col gap-0.5">
        <PriceTag amount={model.rates.fromPrice} size="md" />
        {!isCompact && basisText && <span class="text-xs text-muted">{basisText}</span>}
      </div>
    </div>
  </div>
</article>

<style>
  /* One focus ring around the whole card (the link itself is the only focusable element). */
  .car-card:has(.car-card__link:focus-visible) {
    outline: 1px solid var(--accent);
    outline-offset: 6px;
  }
  .car-card__rule::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 1.1s var(--ease-heavy);
  }
  .car-card:hover .car-card__rule::after {
    transform: scaleX(1);
  }
  .car-card__link {
    transition: color 0.6s linear;
  }
  .car-card:hover .car-card__link {
    color: var(--accent);
  }
</style>
