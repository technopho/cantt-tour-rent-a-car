---
/**
 * Fleet card used across the site (home garage, service pages, /cars/, category and model pages).
 * The whole card is one link (stretched heading link, so there is exactly one tab stop per card).
 *
 *   <CarCard model={model} categoryName="Sedans" />                      default (grid card)
 *   <CarCard model={model} variant="compact" headingLevel="h4" />        related models, sidebars
 *   <CarCard model={model} variant="wide" categoryName="SUVs" />         horizontal on md+ (lists, short grids)
 *   <CarCard model={model} priority sizes="(min-width: 1024px) 50vw, 100vw" />   above-the-fold photo
 *   <CarCard model={model} tilt={false} />                               inside a GSAP-driven scroller
 *
 * Props stay backward compatible with the foundation card (model, categoryName, href, headingLevel,
 * priority, sizes, class). New: variant, maxChips, tilt.
 *
 * Contents: photo (CarVisual renders a branded panel when the model has no photos), category badge,
 * with driver / self drive badges, make + model (+ variant and years), seats, gearbox, fuel, bags,
 * "suitable for" chips and the catalog "from Rs X/day" price.
 *
 * Motion: a subtle 3D tilt that follows the pointer on fine-pointer devices only (tiny script below,
 * transform-only, no layout shift), static under prefers-reduced-motion and on touch.
 * The <article> exposes data-category, data-driver and data-self-drive for client-side filters.
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { fuelLabel, modelYears, transmissionLabel } from "@/lib/catalog";
import { formatPKR } from "@/lib/format";
import { urls } from "@/lib/urls";
import CarVisual from "./CarVisual.astro";
import Icon from "./Icon.astro";
import PriceTag from "./PriceTag.astro";
import { CITY_DAY_HOURS, fromPriceBasis, modelUseCases, offersDriver, offersSelfDrive, singularName } from "./fleet/fleet-data";

type Variant = "default" | "compact" | "wide";

interface Props {
  model: CatalogModel;
  /** Category label for the badge on the visual (e.g. "SUVs", shown as "SUV"). */
  categoryName?: string;
  href?: string;
  headingLevel?: "h2" | "h3" | "h4";
  /** Above-the-fold photo: eager + fetchpriority high. Max one per page. */
  priority?: boolean;
  sizes?: string;
  class?: string;
  variant?: Variant;
  /** Max "suitable for" chips. Defaults: default 3, wide 5, compact 0. */
  maxChips?: number;
  /** Pointer tilt on fine pointers. Default true. */
  tilt?: boolean;
}

const {
  model,
  categoryName,
  href = urls.car(model.slug),
  headingLevel: Heading = "h3",
  priority = false,
  sizes,
  class: className,
  variant = "default",
  maxChips,
  tilt = true,
} = Astro.props;

const driver = offersDriver(model);
const selfDrive = offersSelfDrive(model);
const years = modelYears(model);
const basis = fromPriceBasis(model);
const isCompact = variant === "compact";
const isWide = variant === "wide";

const chipLimit = maxChips ?? (isWide ? 5 : isCompact ? 0 : 3);
// "Self drive" is already a badge, so it is not repeated as a chip.
const chips = modelUseCases(model)
  .filter((u) => u.tag !== "self_drive")
  .slice(0, chipLimit);

const FUEL_ICONS: Record<CatalogModel["fuel"], string> = {
  petrol: "ph:gas-pump",
  diesel: "ph:gas-pump",
  hybrid: "ph:leaf",
  electric: "ph:lightning",
};

const specs = [
  { icon: "ph:users", text: `${model.seats} seats` },
  { icon: "ph:gear-six", text: transmissionLabel(model.transmission) },
  { icon: FUEL_ICONS[model.fuel], text: fuelLabel(model.fuel) },
  model.luggage ? { icon: "ph:suitcase-rolling", text: `${model.luggage} ${model.luggage === 1 ? "bag" : "bags"}` } : null,
].filter((s): s is { icon: string; text: string } => s !== null);
const shownSpecs = isCompact ? specs.slice(0, 2) : specs;

const defaultSizes = isWide
  ? "(min-width: 1280px) 560px, (min-width: 768px) 44vw, 100vw"
  : isCompact
    ? "(min-width: 1280px) 320px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
    : "(min-width: 1280px) 440px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";

/**
 * Wide cards list the other headline rates (with driver day, outstation day, self drive day). The rate
 * the "from" price already shows in the footer is left out so no number appears twice.
 */
const wideRates = [
  model.rates.withDriver && basis !== "with driver" ? { label: `With driver, ${CITY_DAY_HOURS} hour day`, value: model.rates.withDriver.daily } : null,
  model.rates.withDriver?.outstationDaily ? { label: "Outstation, per day", value: model.rates.withDriver.outstationDaily } : null,
  model.rates.selfDrive && basis !== "self drive" ? { label: "Self drive, per day", value: model.rates.selfDrive.daily } : null,
].filter((r): r is { label: string; value: number } => r !== null);

const basisText = basis === "self drive" ? "Self drive rate" : basis === "with driver" ? `With driver, ${CITY_DAY_HOURS} hour day` : null;
---

<article
  class:list={[
    "car-card group relative isolate flex h-full overflow-hidden rounded-card border border-line bg-surface hover:shadow-lift",
    isWide ? "flex-col md:flex-row" : "flex-col",
    className,
  ]}
  data-car-card
  data-variant={variant}
  data-tilt={tilt ? "" : undefined}
  data-category={model.category}
  data-driver={String(driver)}
  data-self-drive={String(selfDrive)}
>
  <div class:list={["car-card__media relative", isWide && "md:min-h-64 md:w-[44%] md:shrink-0"]}>
    <CarVisual
      model={model}
      priority={priority}
      sizes={sizes ?? defaultSizes}
      decorative
      showName={false}
      class={isWide ? "md:absolute md:inset-0 md:aspect-auto md:h-full" : undefined}
    />
    {
      categoryName && (
        <span class="absolute top-3 left-3 z-[1] rounded-badge border border-line bg-bg/60 px-2 py-1 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-muted backdrop-blur-sm">
          {singularName(categoryName)}
        </span>
      )
    }
    {
      !isCompact && (
        <ul class="absolute bottom-3 left-3 z-[1] flex flex-wrap gap-1.5" aria-label="Available as">
          {driver && (
            <li class="inline-flex items-center gap-1.5 rounded-badge border border-line bg-bg/70 px-2 py-1 text-xs font-semibold text-fg backdrop-blur-sm">
              <Icon name="ph:steering-wheel" size={14} class="text-accent" />
              With driver
            </li>
          )}
          {selfDrive && (
            <li class="inline-flex items-center gap-1.5 rounded-badge border border-line bg-bg/70 px-2 py-1 text-xs font-semibold text-fg backdrop-blur-sm">
              <Icon name="ph:key" size={14} class="text-accent" />
              Self drive
            </li>
          )}
        </ul>
      )
    }
    <span class="car-card__glare pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></span>
  </div>

  <div class:list={["flex flex-1 flex-col", isCompact ? "gap-3 p-4" : "gap-4 p-5", isWide && "md:gap-5 md:p-7"]}>
    <div class="flex flex-col gap-1.5">
      <Heading class:list={["text-fg", isCompact ? "text-[1.0625rem] leading-tight" : "text-display-sm"]}>
        <a
          href={href}
          class="car-card__link outline-none after:absolute after:inset-0 after:z-10 after:rounded-card after:content-['']"
        >
          <span class="block font-sans text-[0.8125rem] font-semibold tracking-normal text-muted">{model.make}</span>{" "}
          <span class="block">{model.model}</span>
        </a>
      </Heading>
      {
        !isCompact && (model.variant || years) && (
          <p class="text-sm text-muted">{[model.variant, years].filter(Boolean).join(" · ")}</p>
        )
      }
    </div>

    {isWide && <p class="max-w-prose text-[0.9375rem] leading-relaxed text-muted">{model.shortDescription}</p>}

    <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-muted">
      {
        shownSpecs.map((s) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name={s.icon} size={16} />
            {s.text}
          </li>
        ))
      }
    </ul>

    {
      chips.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label="Suitable for">
          {chips.map((u) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-xs font-medium text-muted">
              <Icon name={u.icon} size={13} />
              {u.label}
            </li>
          ))}
        </ul>
      )
    }

    {
      isWide && wideRates.length > 0 && (
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
          {wideRates.map((r) => (
            <div>
              <dt class="text-xs text-muted">{r.label}</dt>
              <dd class="tabular mt-0.5 font-display font-semibold tracking-[-0.02em] text-fg">{formatPKR(r.value)}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class:list={["mt-auto flex items-end justify-between gap-4 border-t border-line", isCompact ? "pt-3" : "pt-4"]}>
      <div class="flex flex-col gap-0.5">
        <PriceTag amount={model.rates.fromPrice} size={isCompact ? "md" : "lg"} />
        {!isCompact && basisText && <span class="text-xs text-muted">{basisText}</span>}
      </div>
      <span
        class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-muted transition-[background-color,border-color,color,transform] duration-300 ease-(--ease-out) group-hover:border-transparent group-hover:bg-accent-fill group-hover:text-accent-ink"
        aria-hidden="true"
      >
        <Icon name="ph:arrow-up-right" size={18} class="transition-transform duration-300 ease-(--ease-out) group-hover:-translate-y-px group-hover:translate-x-px" />
      </span>
    </div>
  </div>
</article>

<style>
  .car-card {
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .car-card:hover {
    border-color: color-mix(in oklab, var(--text) 16%, transparent);
  }
  /* One focus ring around the whole card (the link itself is the only focusable element). */
  .car-card:has(.car-card__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* The card clips the visual's top corners; the visual itself sits flush. */
  .car-card :global(.car-visual) {
    border-radius: 0;
  }
  .car-card__glare {
    opacity: 0;
    background: radial-gradient(
      26rem circle at var(--glare-x, 50%) var(--glare-y, 0%),
      color-mix(in oklab, var(--accent) 18%, transparent),
      transparent 62%
    );
    transition: opacity 0.4s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .car-card[data-tilt]:hover {
      transform: perspective(1200px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) translate3d(0, -4px, 0);
    }
    .car-card[data-tilting] {
      transition:
        border-color 0.3s var(--ease-out),
        box-shadow 0.45s var(--ease-out),
        transform 0.18s linear;
    }
    .car-card[data-tilting] .car-card__glare {
      opacity: 1;
    }
  }

  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .car-card:active {
      transform: scale(0.985);
      transition-duration: 0.3s, 0.45s, 0.12s;
    }
  }
</style>

<script>
  // Pointer tilt for fleet cards: fine pointers only, never with reduced motion. Bound once per card.
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const MAX_X = 5; // degrees around the horizontal axis
  const MAX_Y = 7; // degrees around the vertical axis

  // Reset every bound card once when the page is hidden (bfcache restores start flat).
  const resets = new Set<() => void>();
  window.addEventListener("pagehide", () => resets.forEach((fn) => fn()));

  function bindTilt(card: HTMLElement) {
    if (card.dataset.tiltBound) return;
    card.dataset.tiltBound = "true";
    let rect: DOMRect | null = null;
    let frame = 0;

    const reset = () => {
      cancelAnimationFrame(frame);
      rect = null;
      delete card.dataset.tilting;
      card.style.removeProperty("--tilt-x");
      card.style.removeProperty("--tilt-y");
    };

    card.addEventListener("pointerenter", () => {
      rect = card.getBoundingClientRect();
    });
    card.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || !fine.matches || reduced.matches) return;
      rect ??= card.getBoundingClientRect();
      const box = rect;
      const px = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width));
      const py = Math.min(1, Math.max(0, (event.clientY - box.top) / box.height));
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        card.dataset.tilting = "";
        card.style.setProperty("--tilt-x", `${((0.5 - py) * 2 * MAX_X).toFixed(2)}deg`);
        card.style.setProperty("--tilt-y", `${((px - 0.5) * 2 * MAX_Y).toFixed(2)}deg`);
        card.style.setProperty("--glare-x", `${(px * 100).toFixed(1)}%`);
        card.style.setProperty("--glare-y", `${(py * 100).toFixed(1)}%`);
      });
    });
    card.addEventListener("pointerleave", reset);
    resets.add(reset);
  }

  function initTilt() {
    if (!fine.matches || reduced.matches) return;
    document.querySelectorAll<HTMLElement>("[data-car-card][data-tilt]").forEach(bindTilt);
  }

  initTilt();
  fine.addEventListener("change", initTilt);
</script>
