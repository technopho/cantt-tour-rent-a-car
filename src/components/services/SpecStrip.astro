---
/**
 * Highlights under the opening: a serif statement beside four short points on hairlines. No icons.
 *
 *   <SpecStrip items={[{ title, text }]} label="Why book with us" />
 */
import Container from "@/components/Container.astro";

interface Item {
  title: string;
  text: string;
  icon?: string;
}

interface Props {
  items: Item[];
  label: string;
}

const { items, label } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="spec-strip-title" class="py-[calc(var(--section-space)*0.6)]">
      <Container class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
        <h2 id="spec-strip-title" class="text-display-md max-w-[16ch] text-fg" data-fx="lines">{label}</h2>
        <ul class="grid gap-x-10 sm:grid-cols-2" data-fx="stagger">
          {items.map((item) => (
            <li class="border-t border-line py-6">
              <h3 class="text-[1.0625rem] font-medium text-fg">{item.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{item.text}</p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )
}
