---
/**
 * "Read before you book" links to guides (src/content/guides). Slugs are resolved against the collection
 * at build time, so a renamed, removed or draft guide is skipped instead of becoming a dead link. Renders
 * nothing when no guide resolves. On phones the list folds under its heading (PhoneFold): the links stay in the
 * HTML and show with JS off.
 *
 *   <GuideLinks slugs={["cost-to-rent-a-car-in-lahore"]} headingId="guides-title" />
 */
import { getCollection } from "astro:content";
import Icon from "@/components/Icon.astro";
import PhoneFold from "@/components/PhoneFold.astro";
import { urls } from "@/lib/urls";

interface Props {
  slugs: readonly string[];
  headingId: string;
  title?: string;
}

const { slugs, headingId, title = "Read before you book" } = Astro.props;
const all = await getCollection("guides", ({ data }) => !data.draft);
const guides = slugs
  .map((slug) => all.find((g) => g.id === slug))
  .filter((g): g is (typeof all)[number] => Boolean(g));
---

{
  guides.length > 0 && (
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <h2 id={headingId} class="text-display-md max-w-[14ch] text-fg" data-fx="lines">
        {title}
      </h2>
      <PhoneFold summary={guides.length === 1 ? "1 guide" : `${guides.length} guides`}>
      <ul class="border-t border-line">
        {guides.map((g) => (
          <li class="border-b border-line">
            <a href={urls.guide(g.id)} class="group flex items-start gap-4 py-5">
              <span class="flex min-w-0 flex-col gap-1">
                <span class="text-[1.0625rem] font-medium text-fg transition-colors duration-500 group-hover:text-accent-fg">{g.data.title}</span>
                <span class="text-sm leading-relaxed text-muted">{g.data.excerpt}</span>
              </span>
              <Icon name="ph:arrow-right" size={18} class="mt-1 ml-auto shrink-0 text-muted transition-transform duration-700 ease-(--ease-out) group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
      </PhoneFold>
    </div>
  )
}
