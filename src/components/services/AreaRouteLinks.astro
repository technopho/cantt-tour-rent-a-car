---
/**
 * Internal links: Lahore areas (service-specific anchor text) and, where the service goes beyond Lahore,
 * outstation routes with distance and drive time when the route page's content entry has them.
 * Plain text on hairlines. On phones each list folds under one line (PhoneFold): the links stay in the HTML.
 */
import { getCollection } from "astro:content";
import PhoneFold from "@/components/PhoneFold.astro";
import { getRoute, site } from "@/config/site";
import { formatDriveTime, formatKm } from "@/lib/format";
import { urls } from "@/lib/urls";

interface Props {
  areas: { title: string; intro: string; linkLabel: (areaName: string) => string };
  routes: { title: string; intro: string; slugs: string[] } | null;
  headingId: string;
}

const { areas, routes, headingId } = Astro.props;
const routeEntries = routes ? await getCollection("routes") : [];
const routeRows = (routes?.slugs ?? [])
  .map((slug) => {
    const served = getRoute(slug);
    if (!served) return null;
    const entry = routeEntries.find((r) => r.data.slug === slug);
    return {
      slug,
      city: served.city,
      meta: entry ? `about ${formatKm(entry.data.distanceKm)}, ${formatDriveTime(entry.data.driveHours)}` : null,
    };
  })
  .filter((r): r is { slug: string; city: string; meta: string | null } => r !== null);
---

<div class:list={["grid gap-16", routeRows.length > 0 && "lg:grid-cols-2 lg:gap-20"]}>
  <div>
    <h2 id={headingId} class="text-display-md text-fg" data-fx="lines">{areas.title}</h2>
    <p class="mt-4 max-w-xl text-muted">{areas.intro}</p>
    <PhoneFold summary={`${site.areasServed.length} areas of Lahore`} class="mt-8">
    <ul class:list={["grid border-t border-line sm:grid-cols-2 sm:gap-x-10 md:mt-8", routeRows.length === 0 && "lg:grid-cols-3"]}>
      {
        site.areasServed.map((area) => (
          <li class="border-b border-line">
            <a href={urls.area(area.slug)} class="block py-3.5 text-[0.9375rem] text-fg transition-colors duration-500 hover:text-accent-fg">
              {areas.linkLabel(area.name)}
            </a>
          </li>
        ))
      }
    </ul>
    </PhoneFold>
    <p class="mt-6 text-sm text-muted">
      Not on the list? We cover all of Lahore, including Cavalry Ground, Walton, Garden Town, Township and Raiwind Road. <a
        href={urls.areas()}
        class="text-accent-fg underline underline-offset-4">See all areas</a
      >.
    </p>
  </div>

  {
    routes && routeRows.length > 0 && (
      <div>
        <h2 class="text-display-md text-fg" data-fx="lines">{routes.title}</h2>
        <p class="mt-4 max-w-xl text-muted">{routes.intro}</p>
        <PhoneFold summary={`${routeRows.length} routes out of Lahore`} class="mt-8">
        <ul class="border-t border-line md:mt-8">
          {routeRows.map((r) => (
            <li class="border-b border-line">
              <a href={urls.route(r.slug)} class="group flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3.5">
                <span class="text-[0.9375rem] text-fg transition-colors duration-500 group-hover:text-accent-fg">Lahore to {r.city}</span>
                {r.meta && <span class="text-sm text-muted tabular-nums">{r.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
        </PhoneFold>
        <p class="mt-6 text-sm text-muted">
          <a href={urls.routes()} class="text-accent-fg underline underline-offset-4">
            All outstation routes from Lahore
          </a>
        </p>
      </div>
    )
  }
</div>
