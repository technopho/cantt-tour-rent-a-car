---
/**
 * What the price covers, what it does not, and the documents to bring. Hairline lists, no boxes. On phones the
 * lists fold under their headings (PhoneFold), so the page is not screens of list text.
 */
import PhoneFold from "@/components/PhoneFold.astro";
import type { DocumentItem } from "./service-data";

interface Props {
  inclusions: string[];
  exclusions: string[];
  documents: { title: string; intro: string; items: DocumentItem[] };
  headingId: string;
  title: string;
}

const { inclusions, exclusions, documents, headingId, title } = Astro.props;
---

<div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
  <h2 id={headingId} class="text-display-lg max-w-[14ch] text-fg lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start" data-fx="lines">{title}</h2>
  <PhoneFold summary={`Included (${inclusions.length}) and not included (${exclusions.length})`}>
  <div class="grid gap-12 sm:grid-cols-2 sm:gap-10">
    <div>
      <h3 class="label text-accent-fg">Included</h3>
      <ul class="mt-5 border-t border-line text-[0.9375rem] leading-relaxed text-fg/90">
        {inclusions.map((item) => <li class="border-b border-line py-3.5">{item}</li>)}
      </ul>
    </div>
    <div>
      <h3 class="label text-muted">Not included</h3>
      <ul class="mt-5 border-t border-line text-[0.9375rem] leading-relaxed text-muted">
        {exclusions.map((item) => <li class="border-b border-line py-3.5">{item}</li>)}
      </ul>
    </div>
  </div>
  </PhoneFold>
</div>

<div class="mt-20 grid gap-10 lg:mt-28 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
  <div>
    <h2 class="text-display-md max-w-[14ch] text-fg" data-fx="lines">{documents.title}</h2>
    <p class="mt-4 max-w-md text-muted">{documents.intro}</p>
  </div>
  <PhoneFold summary={`The ${documents.items.length} documents to bring`}>
  <ol class="border-t border-line">
    {
      documents.items.map((doc, i) => (
        <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 border-b border-line py-4">
          <span class="text-sm text-accent-fg tabular-nums" aria-hidden="true">{i + 1}</span>
          <span class="flex flex-col">
            <span class="font-medium text-fg">{doc.text}</span>
            {doc.note && <span class="mt-0.5 text-sm text-muted">{doc.note}</span>}
          </span>
        </li>
      ))
    }
  </ol>
  </PhoneFold>
</div>
