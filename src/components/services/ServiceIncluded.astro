---
/**
 * "What is included / not included" panel next to the documents checklist.
 * Two columns from 1024px (included panel wider), stacked below.
 */
import Icon from "@/components/Icon.astro";
import type { DocumentItem } from "./service-data";

interface Props {
  inclusions: string[];
  exclusions: string[];
  documents: { title: string; intro: string; items: DocumentItem[] };
  headingId: string;
  title: string;
}

const { inclusions, exclusions, documents, headingId, title } = Astro.props;
---

<div class="grid gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-16">
  <div>
    <h2 id={headingId} class="text-display-lg text-fg">{title}</h2>
    <div class="mt-10 grid overflow-hidden rounded-card border border-line md:grid-cols-2">
      <div class="p-6 sm:p-7">
        <h3 class="flex items-center gap-2.5 font-sans text-base font-bold tracking-normal text-fg">
          <span class="grid size-7 place-items-center rounded-full bg-accent-soft text-accent-fg">
            <Icon name="ph:check" size={14} />
          </span>
          Included
        </h3>
        <ul class="mt-5 flex flex-col gap-3.5 text-[0.9375rem] leading-relaxed text-muted">
          {
            inclusions.map((item) => (
              <li class="flex gap-3">
                <Icon name="ph:check" size={18} class="mt-0.5 text-accent" />
                <span class="text-fg/90">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="border-t border-line bg-surface/60 p-6 sm:p-7 md:border-t-0 md:border-l">
        <h3 class="flex items-center gap-2.5 font-sans text-base font-bold tracking-normal text-fg">
          <span class="grid size-7 place-items-center rounded-full border border-line text-muted">
            <Icon name="ph:minus" size={14} />
          </span>
          Not included
        </h3>
        <ul class="mt-5 flex flex-col gap-3.5 text-[0.9375rem] leading-relaxed text-muted">
          {
            exclusions.map((item) => (
              <li class="flex gap-3">
                <Icon name="ph:minus" size={18} class="mt-0.5 opacity-70" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="lg:pt-2">
    <h2 class="text-display-md text-fg">{documents.title}</h2>
    <p class="mt-3 text-muted">{documents.intro}</p>
    <ol class="mt-8 flex flex-col">
      {
        documents.items.map((doc) => (
          <li class="flex gap-4 border-t border-line py-4 last:border-b">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-surface-2 text-fg">
              <Icon name={doc.icon} size={18} class={doc.icon.startsWith("simple-icons:") ? "text-whatsapp" : undefined} />
            </span>
            <span class="flex flex-col pt-0.5">
              <span class="font-semibold text-fg">{doc.text}</span>
              {doc.note && <span class="mt-0.5 text-sm text-muted">{doc.note}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</div>
