---
/**
 * Group size guide (van and coaster page): one row per seat count in the live catalog, with a strip of
 * small marks so the jump from a sedan to a coaster is visible at a glance. Seat counts and model names
 * come from the catalog.
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";

interface Props {
  models: CatalogModel[];
  headingId: string;
}

const { models, headingId } = Astro.props;

const bySeats = new Map<number, CatalogModel[]>();
for (const m of models) {
  if (!m.rates.withDriver) continue;
  const list = bySeats.get(m.seats) ?? [];
  list.push(m);
  bySeats.set(m.seats, list);
}
const rows = [...bySeats.entries()].sort((a, b) => a[0] - b[0]);
---

{
  rows.length > 1 && (
    <div>
      <h2 id={headingId} class="text-display-lg max-w-[16ch] text-fg" data-fx="lines">
        How many seats do you need?
      </h2>
      <p class="mt-5 max-w-2xl text-muted">
        Every vehicle we rent with a driver, grouped by seats. On long tours, leave a few seats free for bags and comfort.
      </p>
      <ol class="mt-12 border-t border-line">
        {rows.map(([seats, list]) => (
          <li class="grid gap-3 border-b border-line py-6 md:grid-cols-[9rem_minmax(0,1fr)_minmax(0,18rem)] md:items-center md:gap-8">
            <p class="flex items-baseline gap-2 text-fg">
              <span class="seat-num">{seats}</span>
              <span class="text-sm text-muted">seats</span>
            </p>
            <div class="flex flex-wrap gap-1" aria-hidden="true">
              {Array.from({ length: seats }, () => (
                <span class="seat-mark" />
              ))}
            </div>
            <p class="text-sm text-muted">
              {list.map((m, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={urls.car(m.slug)} class="text-fg underline decoration-line-strong underline-offset-4 transition-colors duration-500 hover:text-accent-fg">
                    {m.make} {m.model}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .seat-num {
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .seat-mark {
    width: 0.5rem;
    height: 0.875rem;
    background: color-mix(in oklab, var(--accent) 70%, transparent);
  }
</style>
