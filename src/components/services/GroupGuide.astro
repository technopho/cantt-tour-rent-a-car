---
/**
 * Group size guide (van and coaster page): one row per seat count in the live catalog, with a
 * seat-dot strip so the jump from a sedan to a coaster is visible at a glance. Seat counts and
 * model names come from the catalog.
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";

interface Props {
  models: CatalogModel[];
  headingId: string;
}

const { models, headingId } = Astro.props;

const bySeats = new Map<number, CatalogModel[]>();
for (const m of models) {
  if (!m.rates.withDriver) continue;
  const list = bySeats.get(m.seats) ?? [];
  list.push(m);
  bySeats.set(m.seats, list);
}
const rows = [...bySeats.entries()].sort((a, b) => a[0] - b[0]);
---

{
  rows.length > 1 && (
    <div>
      <h2 id={headingId} class="text-display-md text-fg">
        How many seats do you need?
      </h2>
      <p class="mt-3 max-w-2xl text-muted">
        Every vehicle we rent with a driver, grouped by seats. On long tours, leave a few seats free for bags and comfort.
      </p>
      <ol class="mt-10 border-t border-line">
        {rows.map(([seats, list]) => (
          <li class="grid gap-3 border-b border-line py-5 md:grid-cols-[7rem_minmax(0,1fr)_minmax(0,16rem)] md:items-center md:gap-8">
            <p class="font-display text-display-sm text-fg tabular-nums">
              {seats} <span class="font-sans text-sm font-medium tracking-normal text-muted">seats</span>
            </p>
            <div class="seat-strip flex flex-wrap gap-1" aria-hidden="true">
              {Array.from({ length: seats }, () => (
                <span class="seat-dot" />
              ))}
            </div>
            <p class="text-sm text-muted">
              {list.map((m, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={urls.car(m.slug)} class="font-semibold text-fg underline decoration-line-strong underline-offset-4 hover:text-accent-fg">
                    {m.make} {m.model}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .seat-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 3px;
    background: color-mix(in oklab, var(--accent) 70%, transparent);
  }
</style>
