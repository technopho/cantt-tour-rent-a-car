---
/**
 * Long-form markdown laid out as an edition rather than a wall of text. The rendered body is cut at each
 * H2: the first part stays open, the rest become accordions with a large serif head, and every body sets
 * in two columns on wide screens. All of it stays in the HTML (native <details>, works with JS off).
 * On phones the open part shows its first paragraph and folds the rest (PhoneFold), so the page does not
 * turn into screens of text there; wider screens show it all.
 *
 *   <GuideSplit><Content /></GuideSplit>
 */
import PhoneFold from "@/components/PhoneFold.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const html = await Astro.slots.render("default");

interface Part {
  id?: string;
  title?: string;
  body: string;
}

const parts: Part[] = html
  .split(/(?=<h2[\s>])/)
  .map((chunk) => {
    const m = /^<h2([^>]*)>([\s\S]*?)<\/h2>/.exec(chunk);
    if (!m) return { body: chunk };
    return { id: /\sid="([^"]+)"/.exec(m[1])?.[1], title: m[2], body: chunk.slice(m[0].length) };
  })
  .filter((part) => part.title || part.body.trim());

// Anything before the first heading belongs with the first section.
const lead = parts[0] && !parts[0].title ? parts.shift() : undefined;
const first = parts.shift();

// The open part: its first paragraph as a standfirst, the rest folded on phones.
const openHtml = `${lead?.body ?? ""}${first?.body ?? ""}`.trim();
const cut = openHtml.startsWith("<p") ? openHtml.indexOf("</p>") : -1;
const standfirst = cut > 0 ? openHtml.slice(0, cut + 4) : "";
const rest = cut > 0 ? openHtml.slice(cut + 4).trim() : openHtml;
---

<div class:list={["guide-split", className]}>
  {
    (lead || first) && (
      <div class="guide-split__open">
        {first?.title && <h2 id={first.id} class="text-display-lg scroll-mt-[calc(var(--header-h)+1.5rem)] text-fg" data-fx="lines" set:html={first.title} />}
        {standfirst && <div class="prose-site guide-split__lead mt-8" set:html={standfirst} />}
        {rest && standfirst ? (
          <PhoneFold summary="Keep reading" class="guide-split__fold mt-6">
            <div class="prose-site guide-split__body" set:html={rest} />
          </PhoneFold>
        ) : (
          rest && <div class="prose-site guide-split__body mt-8" set:html={rest} />
        )}
      </div>
    )
  }
  {
    parts.length > 0 && (
      <div class="mt-16 border-t border-line md:mt-24">
        {parts.map((part) => (
          <details class="guide-split__item group border-b border-line">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-7 md:py-9 [&::-webkit-details-marker]:hidden">
              <h2 id={part.id} class="text-display-md scroll-mt-[calc(var(--header-h)+1.5rem)] text-fg transition-colors duration-700 group-hover:text-accent" set:html={part.title} />
              <span class="guide-split__mark relative mt-3 block size-5 shrink-0" aria-hidden="true"></span>
            </summary>
            <div class="prose-site guide-split__body pb-10 md:pb-14" set:html={part.body} />
          </details>
        ))}
      </div>
    )
  }
</div>

<style>
  .guide-split :global(.guide-split__body) {
    max-width: none;
  }
  .guide-split :global(.guide-split__lead) {
    max-width: 44rem;
  }
  @media (width >= 48rem) {
    .guide-split :global(.guide-split__fold) {
      margin-top: 1.5rem;
    }
  }
  @media (width >= 80rem) {
    .guide-split :global(.guide-split__body) {
      column-count: 2;
      column-gap: 3.5rem;
    }
    .guide-split :global(.guide-split__body > :first-child) {
      margin-top: 0;
    }
    .guide-split :global(.guide-split__body :is(h3, h4)) {
      break-after: avoid;
    }
    .guide-split :global(.guide-split__body :is(p, li, ul, ol, blockquote)) {
      break-inside: avoid;
    }
    .guide-split :global(.guide-split__body :is(table, hr)) {
      column-span: all;
    }
  }
  /* A hairline plus, turning into a minus when open. */
  .guide-split__mark::before,
  .guide-split__mark::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transition: transform 0.7s var(--ease-heavy);
  }
  .guide-split__mark::after {
    transform: rotate(90deg);
  }
  details[open] > summary .guide-split__mark::after {
    transform: rotate(0deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .guide-split__item {
        interpolate-size: allow-keywords;
      }
      .guide-split__item::details-content {
        block-size: 0;
        overflow-y: clip;
        transition:
          block-size 0.8s var(--ease-heavy),
          content-visibility 0.8s allow-discrete;
      }
      .guide-split__item[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>

<script>
  // An on-page link or a shared #hash should land on an open section.
  const openFor = (hash: string) => {
    if (hash.length < 2) return;
    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    const details = target?.closest<HTMLDetailsElement>(".guide-split__item");
    if (details) details.open = true;
  };
  openFor(location.hash);
  window.addEventListener("hashchange", () => openFor(location.hash));
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="#"]');
    if (link) openFor(link.getAttribute("href") ?? "");
  });
</script>
