---
/**
 * The band directly under a service hero: the headline price from the catalog, how the service is
 * offered, how many models fit it, the base and how it is confirmed.
 */
import PriceBand from "@/components/fleet/PriceBand.astro";
import { site } from "@/config/site";
import { formatPKR, type PriceUnit } from "@/lib/format";

interface Props {
  amount: number | null;
  unit: PriceUnit;
  note: string;
  modeLabel: string;
  modelCount: number;
  /** Anchor of the cars gallery on the same page. */
  carsHref?: string;
  class?: string;
}

const { amount, unit, note, modeLabel, modelCount, carsHref = "#cars", class: className } = Astro.props;
const unitWords: Record<PriceUnit, string> = {
  day: "per day",
  week: "per week",
  month: "per month",
  hour: "per hour",
  night: "per night",
  trip: "per trip",
};
const items = [
  typeof amount === "number"
    ? { label: "Current rates start at", value: formatPKR(amount), note: `${unitWords[unit]}, ${note}` }
    : { label: "Rates", value: "Price on request", text: true },
  { label: "Service", value: modeLabel, text: true },
  { label: "Cars in this range", value: `${modelCount} ${modelCount === 1 ? "model" : "models"}`, href: carsHref, text: true },
  { label: "Base", value: `${site.address.area}, ${site.address.city}`, text: true },
  { label: "Confirmation", value: "On WhatsApp", text: true },
];
---

<PriceBand items={items} note="From our current rate list. The team confirms the final price before you book." class={className} />
