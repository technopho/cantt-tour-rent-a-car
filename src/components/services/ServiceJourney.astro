---
/**
 * The journey as a composed sequence: large numerals descending a staircase on desktop, one column on
 * phones. A hairline draws across each step. Not cards and not icons.
 *
 *   <ServiceJourney id="journey" title="..." intro="..." stops={[{ label, title, text }]} />
 */
import Section from "@/components/Section.astro";
import PhoneFold from "@/components/PhoneFold.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import type { JourneyStop } from "./service-data";

interface Props {
  id: string;
  title: string;
  intro?: string;
  eyebrow?: string;
  stops: JourneyStop[];
}

const { id, title, intro, eyebrow, stops } = Astro.props;
const headingId = `${id}-title`;
---

<Section id={id} labelledby={headingId}>
  <SectionHeading id={headingId} title={title} intro={intro} eyebrow={eyebrow} />

  <PhoneFold summary={`The ${stops.length} steps, start to finish`} class="mt-10 md:mt-0">
  <ol class="journey md:mt-20" style={`--steps:${stops.length}`}>
    {
      stops.map((stop, i) => (
        <li class="journey__step" style={`--i:${i}`}>
          <div class="h-px w-full origin-left bg-line-strong" data-fx="rule" data-delay={String(i * 0.12)} aria-hidden="true"></div>
          <div class="journey__body" data-fx="fade" data-delay={String(0.1 + i * 0.12)}>
            <span class="journey__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="label text-accent-fg">
                <span class="sr-only">Stop {i + 1}: </span>
                {stop.label}
              </p>
              <h3 class="mt-3 text-xl font-medium text-fg">{stop.title}</h3>
              <p class="mt-2 max-w-sm text-[0.9375rem] leading-relaxed text-muted">{stop.text}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  </PhoneFold>
</Section>

<style>
  .journey {
    display: grid;
    gap: 2.5rem;
  }
  .journey__body {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
  }
  /* A low optical size keeps the hairlines: at auto, a phone "04" read as "01". */
  .journey__num {
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 0.9;
    color: var(--accent);
    font-variant-numeric: lining-nums;
    font-variation-settings: "opsz" 18;
  }
  @media (width >= 64rem) {
    .journey {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
      gap: 2rem;
    }
    /* Each step sits lower than the last: the sequence reads as a road going somewhere. */
    .journey__step {
      margin-top: calc(var(--i) * clamp(2rem, 3.5vw, 4rem));
    }
    .journey__body {
      display: block;
      padding-top: 1.5rem;
    }
    .journey__num {
      display: block;
      margin-bottom: 1.5rem;
      font-size: clamp(4rem, 6.5vw, 7rem);
    }
  }
</style>
