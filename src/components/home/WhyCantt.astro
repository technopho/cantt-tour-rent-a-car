---
/**
 * Why Cantt: one statement across one picture, with a few facts from the catalog and site.ts only.
 * What to bring and the rental terms stay on the page in closed accordions.
 */
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import { formatAddress, formatOpeningHours, primaryPhone, site } from "@/config/site";
import type { CatalogModel } from "@/lib/catalog-types";
import { formatNumber, formatPKR } from "@/lib/format";
import { telUrl } from "@/lib/links";
import { urls } from "@/lib/urls";
import type { FleetFacts, HomeImage } from "./home-data";

interface Props {
  facts: FleetFacts;
  /** The model in the picture. */
  model?: CatalogModel;
  image?: HomeImage;
}

const { facts, model, image } = Astro.props;

const stats = [
  { value: formatNumber(facts.models), label: "models to choose from" },
  facts.fromPrice !== null ? { value: formatPKR(facts.fromPrice), label: "lowest daily rate" } : null,
  { value: formatNumber(site.services.length), label: "ways to rent" },
].filter((s): s is { value: string; label: string } => s !== null);

const bring = [
  "With a driver: your CNIC and a number we can reach on WhatsApp.",
  "Self drive: your original CNIC (or passport for overseas visitors) and a valid driving licence.",
  facts.depositFrom !== null
    ? `Self drive: a refundable security deposit, from ${formatPKR(facts.depositFrom)} depending on the car.`
    : "Self drive: a refundable security deposit, depending on the car.",
];

const terms = [
  "Fuel, motorway tolls and parking are paid separately unless your quote includes them.",
  "A daily booking covers standard duty hours. Extra hours are billed at the overtime rate for that car.",
  "Outstation trips use the outstation rate, plus a night allowance for the driver when you stay over.",
  "Self drive cars come with a daily km allowance, listed for each car.",
  "Every price on this site is an estimate until we confirm it on WhatsApp.",
];

const hours = formatOpeningHours();
---

<section data-theme="dark" id="why" class="why" aria-labelledby="why-title">
  <figure class="why-figure">
    <div class="why-frame" data-fx="image">
      {
        image && (
          <img
            src={image.img.src}
            srcset={image.img.srcset || undefined}
            sizes={image.img.srcset ? "(min-width: 64rem) 58vw, 100vw" : undefined}
            width={image.img.width}
            height={image.img.height}
            alt={image.img.alt}
            loading="lazy"
            decoding="async"
            class="why-img"
            data-fx="parallax"
            data-speed="0.1"
          />
        )
      }
    </div>
    <figcaption class="why-cap">
      {
        model && (
          <a href={urls.car(model.slug)} class="link-draw">
            {model.make} {model.model}
          </a>
        )
      }
      {model && <span class="tabular">from {formatPKR(model.rates.fromPrice)}/day</span>}
      {image?.caption && <span>{image.caption}</span>}
    </figcaption>
  </figure>

  <Container class="why-body">
    <div class="why-main">
      <p class="label why-kicker">Why Cantt</p>
      <h2 id="why-title" class="why-title" data-fx="lines">Clear terms before you pay a <em>rupee</em></h2>
      <p class="why-text" data-fx="fade" data-delay="0.2">
        Cantt stands for being on time. Clean cars, punctual drivers and a written price before you book, from a team based in Lahore Cantt.
      </p>

      <dl class="why-stats" data-fx="stagger">
        {
          stats.map((s) => (
            <div class="why-stat">
              <dt>{s.label}</dt>
              <dd class="tabular">{s.value}</dd>
            </div>
          ))
        }
      </dl>
      <SampleFleetNote class="why-sample" />

      <div class="why-more">
        <details class="why-acc">
          <summary>
            <h3>What to bring</h3>
            <Icon name="ph:plus" size={18} class="why-acc__icon text-accent" />
          </summary>
          <ul>{bring.map((text) => <li>{text}</li>)}</ul>
        </details>
        <details class="why-acc">
          <summary>
            <h3>The small print, upfront</h3>
            <Icon name="ph:plus" size={18} class="why-acc__icon text-accent" />
          </summary>
          <ul>{terms.map((text) => <li>{text}</li>)}</ul>
        </details>
      </div>

      <p class="why-links">
        <a href={urls.policies()} class="link-draw">Read our rental policies</a>
        <a href={urls.rates()} class="link-draw">Compare all rates</a>
        <a href={urls.about()} class="link-draw">About {site.name}</a>
      </p>

      <address class="why-base">
        <span>{formatAddress()}</span>
        <span>{hours.join(", ")}</span>
        <a href={telUrl()} class="link-draw tabular">{primaryPhone.display}</a>
      </address>
    </div>
  </Container>
</section>

<style>
  .why {
    position: relative;
    isolation: isolate;
  }
  .why-figure {
    margin: 0;
  }
  .why-frame {
    position: relative;
    height: clamp(17rem, 70vw, 30rem);
    overflow: hidden;
    background: var(--surface);
  }
  .why-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, var(--bg) 100%);
  }
  .why-img {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 58% 50%;
  }
  .why-cap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.5rem var(--gutter) 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .why-cap a {
    color: var(--text);
  }
  .why :global(.why-body) {
    position: relative;
    padding-block: 1.75rem clamp(3rem, 5vw, 4.5rem);
  }
  .why-kicker {
    color: var(--accent-fg);
  }
  .why-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-variation-settings: "opsz" var(--display-opsz);
    font-size: clamp(3rem, 1.75rem + 5.2vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .why-text {
    margin-top: 1.25rem;
    max-width: 30rem;
    color: var(--muted);
  }

  .why-stats {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  /* Figures above their labels, packed from the top so every figure sits on the same line even when a label
     wraps to two. */
  .why-stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.2rem;
  }
  .why-stat dt {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .why-stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1.05;
    color: var(--text);
    white-space: nowrap;
    font-variant-numeric: lining-nums tabular-nums;
    font-variation-settings: "opsz" 18;
  }
  .why-main :global(.why-sample) {
    margin-top: 0.75rem;
  }

  .why-more {
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .why-acc {
    border-bottom: 1px solid var(--line);
  }
  .why-acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    cursor: pointer;
    list-style: none;
    transition: color 0.5s var(--ease-heavy);
  }
  .why-acc summary::-webkit-details-marker {
    display: none;
  }
  .why-acc summary:hover {
    color: var(--accent-fg);
  }
  .why-acc h3 {
    margin: 0;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
  }
  .why-acc :global(.why-acc__icon) {
    transition: transform 0.7s var(--ease-heavy);
  }
  .why-acc[open] :global(.why-acc__icon) {
    transform: rotate(45deg);
  }
  .why-acc ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 1rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .why-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }
  .why-base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-style: normal;
    color: var(--muted);
  }

  @media (width >= 64rem) {
    .why {
      min-height: 50rem;
    }
    .why-figure {
      position: absolute;
      inset: 0 0 0 44%;
    }
    .why-frame {
      height: 100%;
    }
    .why-frame::after {
      background:
        linear-gradient(90deg, var(--bg) 0%, rgb(7 7 8 / 0.25) 34%, transparent 60%),
        linear-gradient(180deg, transparent 72%, rgb(7 7 8 / 0.85) 100%);
    }
    .why-cap {
      position: absolute;
      right: var(--gutter);
      bottom: 1rem;
      padding: 0;
      justify-content: flex-end;
    }
    .why :global(.why-body) {
      padding-block: clamp(3.5rem, 7vw, 6rem);
    }
    .why-main {
      position: relative;
      z-index: 1;
      max-width: 40rem;
    }
    /* The statement crosses into the picture. */
    .why-title {
      width: 118%;
      max-width: 54rem;
      font-size: clamp(4rem, 2rem + 4.6vw, 7rem);
    }
    .why-stats {
      justify-content: flex-start;
      gap: 3rem;
      margin-top: 1.75rem;
    }
    .why-stat dt {
      font-size: 0.8125rem;
    }
    .why-stat dd {
      font-size: 4rem;
    }
  }
</style>
