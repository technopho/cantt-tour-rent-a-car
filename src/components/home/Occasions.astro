---
/**
 * Occasions (DESIGN.md experience 5): tall image columns that expand on hover, focus or tap, a Bodoni
 * name and one line each. Phones get the same idea on its side: bands that open on tap.
 * On touch the first tap opens a column and the second follows its link. Keyboard and mouse follow
 * the link straight away. Without JS every column is still a plain link, with its line showing on phones.
 * Luxury and vans keep their service-page links in the line under the columns.
 */
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/config/site";
import type { CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";
import { occasions } from "./home-data";

interface Props {
  models: CatalogModel[];
}

const { models } = Astro.props;
const columns = occasions(models);
// Each open column carries its own small print; the line under the columns repeats it for every column, so a
// closed column (a narrow slice of its picture) is covered too.
const anyRepresentative = columns.some((c) => c.image?.representative);
const credits = columns.filter((c) => c.image?.caption && !c.image.representative).map((c) => `${c.name}: ${c.image!.caption}`);
const inColumns = new Set(columns.map((c) => c.href));
const others = site.services.filter((s) => !inColumns.has(urls.service(s.slug)));
---

<section data-theme="dark" id="occasions" class="occ-section" aria-labelledby="occasions-title" data-occ-section>
  <Container class="occ-head">
    <h2 id="occasions-title" class="occ-heading">
      <span class="label occ-kicker">Car rental services in Lahore</span>{" "}
      <span class="occ-title" data-fx="lines">Every <em>occasion</em></span>
    </h2>
    <p class="occ-lede" data-fx="fade" data-delay="0.2">Pick the day. Each page lists the rates, what is included and the cars we recommend.</p>
  </Container>

  <ul class="occ-list" data-occ-list data-fab-hide>
    {
      columns.map((column, i) => (
        <li class:list={["occ", i === 0 && "is-active"]} data-occ>
          <a href={column.href} class="occ-link" data-cursor="View">
            <span class="occ-frame" data-fx="image" data-delay={(i * 0.07).toFixed(2)} data-start="top 92%">
              {column.image && (
                <img
                  src={column.image.img.src}
                  srcset={column.image.img.srcset || undefined}
                  sizes={column.image.img.srcset ? "(min-width: 60rem) 48vw, 100vw" : undefined}
                  width={column.image.img.width}
                  height={column.image.img.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="occ-img"
                  style={column.image.position ? `--focus:${column.image.position}` : undefined}
                />
              )}
            </span>
            {column.image?.caption && <span class="occ-cap">{column.image.caption}</span>}
            <span class="occ-vert" aria-hidden="true">{column.name}</span>
            <div class="occ-body">
              <h3 class="occ-name">
                {column.name}
                <span class="sr-only"> ({column.fullName})</span>
              </h3>
              <p class="occ-line">{column.line}</p>
            </div>
            <span class="occ-arrow" aria-hidden="true">
              <Icon name="ph:arrow-up-right" size={22} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <Container class="occ-foot">
    <p class="occ-also">
      <span class="label">Also</span>
      {others.map((s) => <a href={urls.service(s.slug)} class="link-draw">{s.name}</a>)}
    </p>
    {
      (anyRepresentative || credits.length > 0) && (
        <p class="occ-note">{[anyRepresentative ? "Representative images" : "", ...credits].filter(Boolean).join(". ")}</p>
      )
    }
  </Container>
</section>

<style>
  .occ-section {
    position: relative;
    padding-block: clamp(4rem, 7vw, 7rem) clamp(3rem, 5vw, 5rem);
  }
  .occ-section :global(.occ-head) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  @media (width >= 48rem) {
    .occ-section :global(.occ-head) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }
  }
  .occ-kicker {
    display: block;
    color: var(--accent-fg);
  }
  .occ-title {
    display: block;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-variation-settings: "opsz" var(--display-opsz);
    font-size: clamp(3.5rem, 2.25rem + 6vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .occ-lede {
    max-width: 25rem;
    color: var(--muted);
  }

  /* ---- Bands on phones ---- */
  .occ-list {
    --occ-closed: 5.25rem;
    --occ-open: min(56svh, 24rem);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .occ {
    position: relative;
    flex: none;
    height: var(--occ-closed);
    overflow: hidden;
    background: var(--surface);
    transition: height 1s var(--ease-heavy);
  }
  .occ.is-active,
  .occ:focus-within {
    height: var(--occ-open);
  }
  .occ-link {
    display: block;
    position: relative;
    height: 100%;
    color: var(--text);
    outline: none;
  }
  .occ-frame {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .occ-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(7 7 8 / 0.8) 100%);
  }
  .occ-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: none;
    height: var(--occ-open);
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
    opacity: 0.7;
    /* A closed band shows the middle of the picture, where the car is. */
    transform: translateY(calc((var(--occ-closed) - var(--occ-open)) / 2));
    transition:
      opacity 1.1s var(--ease-heavy),
      transform 1s var(--ease-heavy);
  }
  .occ.is-active .occ-img,
  .occ:focus-within .occ-img {
    opacity: 1;
    transform: none;
  }
  .occ-vert {
    display: none;
  }
  /* Each band's small print. Phones: bottom right of a closed band (its name sits top left), top left once the
     band opens and its name moves down. */
  .occ-cap {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 0.45rem;
    max-width: calc(100% - 2 * var(--gutter) - 2rem);
    font-size: 0.6875rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-align: right;
    color: rgb(242 236 224 / 0.78);
    text-shadow: 0 1px 6px rgb(7 7 8 / 0.8);
    pointer-events: none;
  }
  .occ.is-active .occ-cap,
  .occ:focus-within .occ-cap {
    left: var(--gutter);
    right: auto;
    top: 0.85rem;
    bottom: auto;
    text-align: left;
  }
  /* Without JS a band never opens: its name and line stack at the bottom, the small print stays top left. */
  :global(html:not(.js)) .occ-cap {
    left: var(--gutter);
    right: auto;
    top: 0.85rem;
    bottom: auto;
    text-align: left;
  }
  .occ-body {
    display: block;
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: 3.5rem;
    top: 0;
    padding-block: 1.45rem 1.25rem;
    transition: transform 1s var(--ease-heavy);
  }
  .occ.is-active .occ-body,
  .occ:focus-within .occ-body {
    transform: translateY(calc(var(--occ-open) - 100%));
  }
  .occ-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-variation-settings: "opsz" var(--display-opsz);
    font-size: 2.375rem;
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--text);
  }
  .occ-line {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--text);
    opacity: 0;
    transition: opacity 0.6s var(--ease-heavy);
  }
  .occ.is-active .occ-line,
  .occ:focus-within .occ-line {
    opacity: 1;
    transition-delay: 0.25s;
  }
  .occ-arrow {
    position: absolute;
    z-index: 2;
    top: 1.75rem;
    right: var(--gutter);
    color: var(--accent);
    transition: transform 0.9s var(--ease-heavy);
  }
  .occ:not(.is-active):not(:focus-within) .occ-arrow {
    transform: rotate(90deg);
  }
  /* Without JS nothing can open a band, so each one shows its name and line from the start. */
  :global(html:not(.js)) .occ {
    height: auto;
  }
  :global(html:not(.js)) .occ-body {
    position: relative;
    padding-top: 4.5rem;
  }
  :global(html:not(.js)) .occ-line {
    opacity: 1;
  }

  /* ---- Tall columns from here up ---- */
  @media (width >= 60rem) {
    .occ-list {
      --occ-w: max(46vw, 34rem);
      flex-direction: row;
      height: clamp(32rem, 78dvh, 52rem);
      padding-inline: max(var(--gutter), calc((100vw - var(--container-site)) / 2 + var(--gutter)));
      gap: 2px;
    }
    .occ {
      flex: 1 1 0;
      min-width: 0;
      height: auto;
      transition: flex-grow 1.2s var(--ease-heavy);
    }
    .occ.is-active,
    .occ:focus-within {
      flex-grow: 3.8;
      height: auto;
    }
    :global(html:not(.js)) .occ:hover {
      flex-grow: 3.8;
    }
    :global(html:not(.js)) .occ {
      min-height: 0;
    }
    .occ-frame::after {
      background: linear-gradient(180deg, transparent 45%, rgb(7 7 8 / 0.82) 100%);
    }
    /* The picture keeps its size while the column opens over it: the frame moves, the image does not. */
    .occ-img {
      left: calc(50% - var(--occ-w) / 2);
      width: var(--occ-w);
      height: 100%;
      opacity: 0.5;
      transform: none;
      transition:
        opacity 1.1s var(--ease-heavy),
        transform 2.4s var(--ease-heavy);
    }
    .occ.is-active .occ-img,
    .occ:focus-within .occ-img {
      transform: scale(1.04);
    }
    .occ-vert {
      display: block;
      position: absolute;
      z-index: 2;
      left: 50%;
      bottom: 1.75rem;
      margin-left: -0.5em;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 3.4vw, 3.5rem);
      line-height: 1;
      white-space: nowrap;
      color: var(--text);
      transition: opacity 0.6s var(--ease-heavy);
    }
    .occ.is-active .occ-vert,
    .occ:focus-within .occ-vert {
      opacity: 0;
    }
    .occ-body {
      left: clamp(1.25rem, 2vw, 2rem);
      right: auto;
      top: auto;
      bottom: 0;
      width: min(30vw, 26rem);
      padding-block: 0 clamp(1.25rem, 2vw, 2rem);
      opacity: 0;
      transform: translateY(1.5rem);
      transition:
        opacity 0.5s var(--ease-heavy),
        transform 1s var(--ease-heavy);
    }
    .occ.is-active .occ-body,
    .occ:focus-within .occ-body {
      opacity: 1;
      transform: none;
      transition-delay: 0.3s;
    }
    .occ-name {
      font-size: clamp(3rem, 5vw, 5.25rem);
      line-height: 0.95;
    }
    .occ-line {
      opacity: 1;
      font-size: 1rem;
    }
    .occ-arrow {
      top: 1.25rem;
      right: 1.25rem;
    }
    /* Columns: only the open one carries its small print (a closed column is a narrow slice; the line under
       the columns covers every picture). */
    .occ-cap,
    .occ.is-active .occ-cap,
    .occ:focus-within .occ-cap,
    :global(html:not(.js)) .occ-cap {
      left: clamp(1.25rem, 2vw, 2rem);
      right: auto;
      top: 1.35rem;
      bottom: auto;
      max-width: calc(100% - 5rem);
      white-space: nowrap;
      text-align: left;
      opacity: 0;
      transition: opacity 0.6s var(--ease-heavy);
    }
    .occ.is-active .occ-cap,
    .occ:focus-within .occ-cap,
    :global(html:not(.js)) .occ:hover .occ-cap {
      opacity: 1;
      transition-delay: 0.3s;
    }
    .occ:not(.is-active):not(:focus-within) .occ-arrow {
      opacity: 0;
      transform: none;
    }
    :global(html:not(.js)) .occ-body {
      position: absolute;
      padding-top: 0;
    }
    :global(html:not(.js)) .occ:hover .occ-body {
      opacity: 1;
      transform: none;
    }
    :global(html:not(.js)) .occ:hover .occ-vert {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .occ,
    .occ-img,
    .occ-body,
    .occ-line,
    .occ-vert,
    .occ-cap,
    .occ-arrow {
      transition: none;
    }
    .occ.is-active .occ-img,
    .occ:focus-within .occ-img {
      transform: none;
    }
  }

  /* ---- Under the columns ---- */
  .occ-section :global(.occ-foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }
  .occ-also {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--text);
  }
  .occ-also .label {
    color: var(--muted);
  }
  .occ-note {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>

<script>
  import { hasFinePointer } from "@/scripts/capabilities";

  const list = document.querySelector<HTMLElement>("[data-occ-list]");
  if (list) {
    const columns = [...list.querySelectorAll<HTMLElement>("[data-occ]")];
    const open = (column: HTMLElement) => {
      for (const c of columns) c.classList.toggle("is-active", c === column);
    };
    // The column that was already open when the current touch began. Read at pointerdown, because the
    // tap focuses the link (and focusin opens the column) before the click arrives.
    let armed: HTMLElement | null = null;
    for (const column of columns) {
      // Hover opens with a mouse, and the column stays open after the pointer leaves.
      column.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") open(column);
      });
      column.addEventListener("pointerdown", (event) => {
        if (event.pointerType !== "mouse") armed = column.classList.contains("is-active") ? column : null;
      });
      column.addEventListener("focusin", () => open(column));
      // Touch: the first tap opens, the second follows the link. event.detail is 0 for keyboard clicks.
      column.addEventListener("click", (event) => {
        if (hasFinePointer() || event.detail === 0 || armed === column) return;
        event.preventDefault();
        open(column);
      });
    }
  }
</script>
