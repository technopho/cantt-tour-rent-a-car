</style>

<script>
  import { loadGsap } from "@/scripts/motion";
  import { whenPreloaderParts } from "@/scripts/capabilities";
  import { getTier } from "@/scripts/tier";

  type Place = "before" | "in" | "after";

  const op = document.querySelector<HTMLElement>("[data-op]");

  const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  /** Cubic in-out: a wipe leaves slowly, travels, and settles slowly, however the scroll arrives. */
  const ease = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);

  /** Resolves once the picture is loaded and decoded (or broken: the preloader must never wait on it). */
  function settled(img?: HTMLImageElement | null): Promise<void> {
    return new Promise((resolve) => {
      if (!img) return resolve();
      const decode = () => (img.decode ? img.decode().then(resolve, () => resolve()) : resolve());
      if (img.complete) {
        if (img.naturalWidth > 0) decode();
        else resolve();
        return;
      }
      img.addEventListener("load", decode, { once: true });
      img.addEventListener("error", () => resolve(), { once: true });
    });
  }

  /**
   * The preloader (html[data-preload="media"]) follows the real load of the opening: the first frame (and the
   * type) carry most of the stroke, the second frame the rest, without holding the doors more than 1.2s for it.
   */
  function reportLoad(imgs: HTMLImageElement[], pinned: boolean): Promise<void> {
    const send = (progress: number) => window.dispatchEvent(new CustomEvent("cantt:load-progress", { detail: { progress } }));
    let first = 0;
    let type = 0;
    let second = 0;
    const report = () => send(Math.min(1, 0.05 + 0.63 * first + 0.12 * type + 0.2 * second));
    report();

    const firstIn = settled(imgs[0]).then(() => {
      first = 1;
      report();
    });
    const typeIn = Promise.race([document.fonts ? document.fonts.ready.then(() => undefined) : Promise.resolve(), wait(2500)]).then(() => {
      type = 1;
      report();
    });
    // The second frame starts after the first, so it never competes with the LCP picture. In the stacked
    // layout it is far below the fold and loads lazily, so nothing waits on it.
    const secondIn = firstIn
      .then(() => {
        const img = imgs[1];
        if (!pinned || !img) return;
        img.loading = "eager";
        return Promise.race([settled(img), wait(4000)]);
      })
      .then(() => {
        second = 1;
        report();
      });

    return Promise.all([firstIn, typeIn])
      .then(() => Promise.race([secondIn, wait(1200)]))
      .then(() => {
        send(1);
        window.dispatchEvent(new Event("cantt:load-ready"));
      });
  }

  interface Act {
    el: HTMLElement;
    clip: HTMLElement;
    counter: HTMLElement;
    pic: HTMLElement;
    img: HTMLImageElement | null;
    dim: HTMLElement | null;
    sweep: HTMLElement | null;
    lines: HTMLElement[];
    extras: HTMLElement[];
    wipe: "sweep" | "door";
    place: Place;
    shown: boolean | null;
    z: number;
  }

  /** Ken Burns per frame across its whole life on screen: scale, then x and y drift in percent. */
  const KB = [
    { s: [1.0, 1.09], x: [0, 0], y: [0, -2] },
    { s: [1.12, 1.03], x: [-2.5, 1.2], y: [0, 0] },
    { s: [1.03, 1.13], x: [0, 0], y: [1.4, -2] },
    { s: [1.14, 1.03], x: [0, 0], y: [-3, 1.2] },
    { s: [1.03, 1.12], x: [1.2, -2], y: [0, 0] },
  ];
  /** Scroll units: how long each frame holds, how long each change takes, and the hand-over at the end. */
  const HOLD = [0.9, 1, 1, 1, 0.9];
  const CHANGE = 1.15;
  const TAIL = 0.8;

  async function play(op: HTMLElement, stage: HTMLElement, imgs: HTMLImageElement[], loaded: Promise<void>) {
    const { gsap, ScrollTrigger } = await loadGsap();
    const rich = getTier() !== "fallback";
    op.dataset.mode = "pinned";
    // The fallback tier (Save-Data, little memory, no WebGL2) keeps the frames and wipes, not the extra light.
    if (!rich) op.dataset.lite = "";

    const acts: Act[] = [...stage.querySelectorAll<HTMLElement>("[data-act]")].map((el, index) => ({
      el,
      clip: el.querySelector<HTMLElement>("[data-clip]")!,
      counter: el.querySelector<HTMLElement>("[data-counter]")!,
      pic: el.querySelector<HTMLElement>("[data-pic]")!,
      img: el.querySelector<HTMLImageElement>("[data-op-img]"),
      dim: el.querySelector<HTMLElement>("[data-dim]"),
      sweep: el.querySelector<HTMLElement>("[data-sweep]"),
      lines: [...el.querySelectorAll<HTMLElement>("[data-line]")],
      extras: [...el.querySelectorAll<HTMLElement>("[data-fade]")],
      wipe: el.dataset.wipe === "door" ? "door" : "sweep",
      place: index === 0 ? "in" : "before",
      shown: null,
      z: -1,
    }));
    const n = acts.length;
    const lightV = stage.querySelector<HTMLElement>("[data-light-v]");
    const lightH = stage.querySelector<HTMLElement>("[data-light-h]");
    const indexEl = stage.querySelector<HTMLElement>("[data-op-index]");
    const barEl = stage.querySelector<HTMLElement>("[data-op-bar]");
    const trails = [...stage.querySelectorAll<SVGPathElement>("[data-trail]")];
    const flowGroup = stage.querySelector<SVGGElement>("[data-flow-group]");
    const coreCount = trails.length / 2;

    // The timeline of the film, in scroll units.
    const holdAt: number[] = [];
    const changeAt: number[] = []; // changeAt[k]: the change from frame k-1 to frame k starts
    let t = 0;
    for (let k = 0; k < n; k++) {
      if (k > 0) {
        changeAt[k] = t;
        t += CHANGE;
      }
      holdAt[k] = t;
      t += HOLD[k] ?? 1;
    }
    const tailAt = t;
    const total = t + TAIL;

    /** gsap.to with nothing to animate only warns, so empty groups are skipped. */
    const to = (targets: Element[], vars: Record<string, unknown>) => {
      if (targets.length) gsap.to(targets, vars);
    };

    /** When the words last sent out will have cleared their masks (performance.now() time). */
    let clearAt = 0;
    const OUT = 0.42;
    const OUT_STAGGER = 0.04;

    /**
     * Plays one act's words in or out, on their own clock. Two headlines never share the screen: words coming
     * in wait until the words going out have left (on phones every act's words sit in the same place).
     */
    function words(act: Act, place: Place) {
      if (act.place === place) return;
      const was = act.place;
      act.place = place;
      const all = [...act.lines, ...act.extras];
      gsap.killTweensOf(all);
      const now = performance.now();
      if (place === "in") {
        const delay = Math.max(0, (clearAt - now) / 1000);
        to(act.lines, { yPercent: 0, autoAlpha: 1, duration: 1.15, ease: "expo.out", stagger: 0.09, delay });
        to(act.extras, { autoAlpha: 1, y: 0, duration: 0.9, ease: "power2.out", delay: delay + 0.4 });
        if (was !== "in") settle(act, 0.15 + delay);
        return;
      }
      if (was === "in") clearAt = Math.max(clearAt, now + (OUT + OUT_STAGGER * Math.max(0, act.lines.length - 1)) * 1000);
      to(act.lines, { yPercent: place === "after" ? -118 : 118, duration: OUT, ease: "power2.in", stagger: OUT_STAGGER });
      to(act.extras, { autoAlpha: 0, duration: 0.3, ease: "none" });
    }

    /** A soft band of light crosses the frame as it settles. */
    function settle(act: Act, delay = 0.15) {
      const band = act.sweep;
      if (!rich || !band) return;
      gsap.killTweensOf(band);
      gsap.fromTo(
        band,
        { x: "-60vw", autoAlpha: 1 },
        { x: "130vw", duration: 2.1, ease: "power2.inOut", delay, onComplete: () => gsap.set(band, { autoAlpha: 0 }) },
      );
    }

    let current = -1;
    let flowing = false;
    let onScreen = true;

    function setFlow(on: boolean) {
      if (on === flowing) return;
      flowing = on;
      if (on) op.dataset.flow = "";
      else op.removeAttribute("data-flow");
    }

    function render(p: number) {
      const T = p * total;
      let lightVOn = 0;
      let lightVX = 0;
      let lightHOn = 0;
      let lightHY = 0;
      let latest = 0;
      const places: Place[] = [];

      for (let k = 0; k < n; k++) {
        const act = acts[k];
        const uIn = k === 0 ? 1 : clamp01((T - changeAt[k]) / CHANGE);
        const uOut = k === n - 1 ? 0 : clamp01((T - changeAt[k + 1]) / CHANGE);
        const shown = uIn > 0 && uOut < 1;
        if (uIn >= 0.5) latest = k;

        if (act.shown !== shown) {
          act.shown = shown;
          act.clip.style.visibility = shown ? "visible" : "hidden";
        }

        // Words: out the moment the next frame starts to come, in once the new frame is well over half arrived,
        // so the old lines are gone before the new ones rise (words() also waits for them).
        places[k] = uIn < 0.6 ? "before" : uOut > 0.02 ? "after" : "in";

        if (!shown) continue;
        const eIn = ease(uIn);
        const eOut = ease(uOut);
        const next = acts[k + 1];

        // Who is on top: a sweeping frame covers the one before it; a lifting door covers the one behind.
        let z = 1;
        if (uIn < 1) z = act.wipe === "sweep" ? 3 : 2;
        if (uOut > 0 && next) z = next.wipe === "door" ? 3 : 2;
        if (z !== act.z) {
          act.z = z;
          act.clip.style.zIndex = String(z);
        }

        // The clip moves like a door; the counter holds the picture still inside it (or lags it, for depth).
        let clipX = 0;
        let clipY = 0;
        let counterX = 0;
        let counterY = 0;
        if (uIn < 1 && act.wipe === "sweep") {
          clipX = -100 + 100 * eIn;
          counterX = -clipX;
          lightVOn = Math.pow(Math.sin(Math.PI * uIn), 0.6);
          lightVX = eIn * 100;
        }
        if (uOut > 0 && next?.wipe === "door") {
          clipY = -100 * eOut;
          counterY = 22 * eOut;
          lightHOn = Math.pow(Math.sin(Math.PI * uOut), 0.6);
          lightHY = (1 - eOut) * 100;
        }
        act.clip.style.transform = `translate3d(${clipX}%, ${clipY}%, 0)`;
        act.counter.style.transform = `translate3d(${counterX}%, ${counterY}%, 0)`;

        // Ken Burns across the frame's whole life, plus a push from the light when the next frame sweeps in.
        const lifeStart = k === 0 ? 0 : changeAt[k];
        const lifeEnd = k === n - 1 ? total : changeAt[k + 1] + CHANGE;
        const v = clamp01((T - lifeStart) / (lifeEnd - lifeStart));
        const kb = KB[k] ?? KB[0];
        const s = kb.s[0] + (kb.s[1] - kb.s[0]) * v;
        let px = kb.x[0] + (kb.x[1] - kb.x[0]) * v;
        const py = kb.y[0] + (kb.y[1] - kb.y[0]) * v;
        if (uOut > 0 && next?.wipe === "sweep") px += 7 * eOut;
        act.pic.style.transform = `translate3d(${px.toFixed(3)}%, ${py.toFixed(3)}%, 0) scale(${s.toFixed(4)})`;

        // Darkness: the frame being covered dims, the frame behind a door waits in shadow, the last one fades.
        let dim = 0;
        if (uOut > 0 && next?.wipe === "sweep") dim = 0.5 * eOut;
        if (uIn < 1 && act.wipe === "door") dim = Math.max(dim, 0.62 * (1 - eIn));
        if (k === n - 1) dim = Math.max(dim, 0.5 * ease(clamp01((T - tailAt) / TAIL)));
        if (act.dim) act.dim.style.opacity = dim.toFixed(3);
      }

      // Words going out first, so the words coming in know to wait for them, in either scroll direction.
      places.forEach((place, k) => place !== "in" && words(acts[k], place));
      places.forEach((place, k) => place === "in" && words(acts[k], place));

      if (lightV) {
        lightV.style.opacity = lightVOn.toFixed(3);
        if (lightVOn > 0) lightV.style.transform = `translate3d(${lightVX.toFixed(2)}%, 0, 0)`;
      }
      if (lightH) {
        lightH.style.opacity = lightHOn.toFixed(3);
        if (lightHOn > 0) lightH.style.transform = `translate3d(0, ${lightHY.toFixed(2)}%, 0)`;
      }

      // The trails draw themselves as the last frame arrives, then light runs along them.
      if (trails.length) {
        const from = changeAt[n - 1] + CHANGE * 0.35;
        const d = clamp01((T - from) / (holdAt[n - 1] + (HOLD[n - 1] ?? 1) + TAIL * 0.4 - from));
        trails.forEach((path, i) => {
          const draw = clamp01(d * 1.35 - (i % coreCount) * 0.07);
          path.style.strokeDashoffset = (1 - draw).toFixed(4);
        });
        if (flowGroup) flowGroup.style.opacity = rich ? clamp01((d - 0.75) / 0.25).toFixed(3) : "0";
        setFlow(rich && onScreen && d > 0.75);
      }

      if (latest !== current) {
        current = latest;
        if (indexEl) indexEl.textContent = String(latest + 1).padStart(2, "0");
      }
      if (barEl) barEl.style.transform = `scaleX(${p.toFixed(4)})`;
    }

    // Starting state: the later acts' words wait under their masks, their links unseen.
    acts.forEach((act, index) => {
      if (index === 0) return;
      if (act.lines.length) gsap.set(act.lines, { yPercent: 118 });
      if (act.extras.length) gsap.set(act.extras, { autoAlpha: 0, y: 12 });
    });
    // The stylesheet holds the hero lines under their masks: hand the offset over to GSAP.
    gsap.set(stage.querySelectorAll("[data-hero-line]"), { y: 0, yPercent: 118 });

    const shared = { p: 0 };
    gsap.to(shared, {
      p: 1,
      ease: "none",
      scrollTrigger: {
        trigger: op,
        start: "top top",
        end: () => `+=${Math.max(1, op.offsetHeight - stage.offsetHeight)}`,
        scrub: 0.8,
        invalidateOnRefresh: true,
      },
      onUpdate: () => render(shared.p),
    });

    // Nothing runs while the stage is off screen.
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (!onScreen) setFlow(false);
      else render(shared.p);
    }).observe(stage);

    op.dataset.ready = "";
    render(shared.p);
    ScrollTrigger.refresh();

    // The later frames join the layout (and load) once the first is in.
    loaded.then(() => {
      op.dataset.armed = "";
      imgs.slice(1).forEach((img) => (img.loading = "eager"));
      render(shared.p);
    });

    // The preloader's doors part: its seam of light carries on as frame one's first light.
    whenPreloaderParts(() => {
      const veil = stage.querySelector<HTMLElement>("[data-veil]");
      const seam = stage.querySelector<HTMLElement>("[data-seam]");
      const first = acts[0];
      const heroLines = stage.querySelectorAll<HTMLElement>("[data-hero-line]");
      const soft = stage.querySelectorAll<HTMLElement>("[data-hero-soft]");
      if (veil) gsap.to(veil, { autoAlpha: 0, duration: rich ? 1.7 : 0.9, ease: "power2.out", delay: 0.1 });
      if (first.img) gsap.fromTo(first.img, { scale: 1.12 }, { scale: 1, duration: 3.4, ease: "expo.out" });
      if (seam && rich) {
        gsap.fromTo(seam, { autoAlpha: 1, scaleY: 1 }, { scaleY: 40, autoAlpha: 0, duration: 1.5, ease: "power2.out" });
      }
      settle(first, 0.55);
      // The H1 rises once the doors are well apart, so no line shows cut inside the gap between them.
      gsap.to(heroLines, { yPercent: 0, duration: 1.4, ease: "expo.out", stagger: 0.14, delay: 0.8 });
      gsap.to(soft, { autoAlpha: 1, duration: 1.2, ease: "expo.out", stagger: 0.1, delay: 1.4 });
    });
  }

  if (op) {
    const stage = op.querySelector<HTMLElement>("[data-op-stage]");
    const imgs = [...op.querySelectorAll<HTMLImageElement>("[data-op-img]")];
    const pinned = op.hasAttribute("data-mode");
    const loaded = reportLoad(imgs, pinned);
    if (pinned && stage) {
      play(op, stage, imgs, loaded).catch(() => {
        // Without the timeline the frames go back to the plain stack, words and all.
        op.removeAttribute("data-mode");
        op.removeAttribute("data-flow");
      });
    }
  }
</script>
