  /* Light: a vertical strip that leads a sweep, a horizontal seam under a lifting door. */
  .op[data-mode] .op-light {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: block;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
