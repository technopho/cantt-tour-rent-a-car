  .op[data-mode] .op-act {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* Keep the words inside the part of the screen the address bar never covers. */
    bottom: calc(100lvh - 100svh);
    display: block;
    min-height: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
