---
/**
 * Home FAQ: high-intent Lahore questions (answers built from catalog facts in home-data.ts), native
 * <details> accordion, all closed, with FAQPage JSON-LD. Heading on the left, questions on the right.
 */
import Container from "@/components/Container.astro";
import FaqList from "@/components/FaqList.astro";
import type { FaqItem } from "@/lib/schema";
import { urls } from "@/lib/urls";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <Container class="faq-grid">
    <div class="faq-head">
      <h2 id="faq-title" class="faq-title" data-fx="lines">Renting a car in Lahore: quick <em>answers</em></h2>
      <p class="faq-text">Prices, documents, fuel, airport runs and trips out of the city.</p>
      <a href={urls.faq()} class="faq-all link-draw">All questions</a>
    </div>
    <div class="faq-list" data-fx="fade">
      <FaqList faqs={faqs} schema exclusive id="home-faq" />
    </div>
  </Container>
</section>

<style>
  .faq {
    padding-block: clamp(3rem, 5vw, 5rem);
  }
  .faq :global(.faq-grid) {
    display: grid;
    gap: 1.75rem;
  }
  @media (width >= 64rem) {
    .faq :global(.faq-grid) {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .faq-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 1.9rem + 2.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.008em;
    color: var(--text);
  }
  .faq-text {
    margin-top: 1rem;
    color: var(--muted);
  }
  /* Tighter rows than the shared list, so eight closed questions stay short. */
  .faq-list :global(summary) {
    padding-block: 1.1rem;
  }
  .faq-all {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--text);
    font-weight: 500;
  }
</style>
