---
/**
 * Home FAQ: high-intent Lahore questions (answers built from catalog facts in home-data.ts),
 * native <details> accordion with FAQPage JSON-LD. Narrow reading column.
 */
import Container from "@/components/Container.astro";
import FaqList from "@/components/FaqList.astro";
import Icon from "@/components/Icon.astro";
import type { FaqItem } from "@/lib/schema";
import { urls } from "@/lib/urls";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="border-t border-line py-section" aria-labelledby="faq-title">
  <Container width="narrow">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex max-w-2xl flex-col gap-4">
        <h2 id="faq-title" class="text-display-lg text-fg">Renting a car in Lahore: quick answers</h2>
        <p class="text-muted">Prices, documents, fuel, airport runs and trips out of the city.</p>
      </div>
      <a
        href={urls.faq()}
        class="group inline-flex shrink-0 items-center gap-2 self-start font-semibold text-fg underline decoration-line-strong decoration-1 underline-offset-[0.3em] transition-colors hover:decoration-accent md:self-end"
      >
        All questions
        <Icon name="ph:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
    <FaqList faqs={faqs} schema exclusive openFirst id="home-faq" class="mt-10" />
  </Container>
</section>
