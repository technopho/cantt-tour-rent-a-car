---
/**
 * Services bento: one cell per service in site.ts, each a different size and visual treatment,
 * each linking to its service page. Prices and counts come from the catalog.
 * Grid: 4 columns on desktop (named areas), 2 on tablets, 1 on phones.
 */
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import PriceTag from "@/components/PriceTag.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { site } from "@/config/site";
import type { CatalogModel } from "@/lib/catalog-types";
import type { PriceUnit } from "@/lib/format";
import { urls } from "@/lib/urls";
import { withDriverFrom, type FleetFacts } from "./home-data";

interface Props {
  models: CatalogModel[];
  facts: FleetFacts;
}

const { models, facts } = Astro.props;

const isGroupModel = (m: CatalogModel) => m.category === "van" || m.category === "coaster" || m.seats >= 8;
const groupModels = models.filter(isGroupModel);
const groupSeats = groupModels.length ? Math.max(...groupModels.map((m) => m.seats)) : null;

interface CellExtra {
  area: string;
  price?: { amount: number | null; unit?: PriceUnit; note?: string };
  tags?: string[];
  fact?: string | null;
}

const EXTRAS: Record<string, CellExtra> = {
  "rent-a-car-with-driver-lahore": {
    area: "drv",
    price: {
      amount: withDriverFrom(models, (m) => ["hatchback", "sedan", "suv"].includes(m.category)),
      note: "with driver",
    },
    tags: ["City errands", "Family functions", "Business days", "Hospital visits", "Outstation trips"],
  },
  "self-drive-car-rental-lahore": {
    area: "self",
    price: { amount: facts.selfDriveFrom, note: "self drive" },
    fact: facts.selfDriveModels ? `${facts.selfDriveModels} models available to drive yourself` : null,
  },
  "monthly-car-rental-lahore": {
    area: "month",
    price: { amount: facts.monthlyFrom, unit: "month" },
  },
  "lahore-airport-car-rental": {
    area: "air",
    fact: "Allama Iqbal International Airport (LHE)",
  },
  "wedding-car-rental-lahore": {
    area: "wed",
    price: {
      amount: withDriverFrom(models, (m) => m.category === "wedding" || m.suitableFor.includes("wedding")),
      note: "with driver",
    },
    tags: ["Mehndi", "Baraat", "Walima"],
  },
  "corporate-car-rental-lahore": {
    area: "corp",
    tags: ["Visiting teams", "Events", "Staff transport"],
  },
  "luxury-car-rental-lahore": {
    area: "lux",
    price: { amount: withDriverFrom(models, (m) => m.category === "luxury" || m.category === "wedding"), note: "with driver" },
  },
  "van-coaster-rental-lahore": {
    area: "van",
    price: { amount: withDriverFrom(models, isGroupModel), note: "with driver" },
    fact: groupSeats ? `Up to ${groupSeats} seats` : null,
  },
};

const cells = site.services.map((service) => ({ service, extra: EXTRAS[service.slug] ?? { area: "" } }));
const monthDays = Array.from({ length: 30 }, (_, i) => i);
---

<section id="services" class="py-section" aria-labelledby="services-title">
  <Container>
    <SectionHeading
      id="services-title"
      title="One fleet, every kind of trip"
      intro="Pick the service that fits the day. Each page lists the rates, what is included and the cars we recommend."
    />

    <ul class="bento mt-12 md:mt-16">
      {
        cells.map(({ service, extra }) => (
          <li class:list={["bento-cell", extra.area && `bento-cell--${extra.area}`]} style={extra.area ? `grid-area: ${extra.area}` : undefined}>
            <article class="bento-card group">
              {extra.area === "drv" && (
                <div class="bento-visual bento-visual--drv" aria-hidden="true">
                  <Icon name="ph:steering-wheel" size="100%" class="bento-wheel" />
                  <span class="bento-streak bento-streak--1" />
                  <span class="bento-streak bento-streak--2" />
                  <span class="bento-streak bento-streak--3" />
                </div>
              )}
              {extra.area === "month" && (
                <div class="bento-month" aria-hidden="true">
                  {monthDays.map((d) => (
                    <span class:list={["bento-day", d < 22 && "is-on"]} style={`--d:${d}`} />
                  ))}
                </div>
              )}
              {extra.area === "air" && (
                <svg class="bento-flight" viewBox="0 0 240 40" preserveAspectRatio="none" aria-hidden="true">
                  <path
                    d="M2 36 C 70 2, 170 2, 238 30"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-dasharray="4 6"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              )}
              {extra.area === "lux" && <div class="bento-sheen" aria-hidden="true" />}

              <div class="bento-top">
                <span class="bento-icon">
                  <Icon name={service.icon} size={22} />
                </span>
                <Icon
                  name="ph:arrow-up-right"
                  size={20}
                  class="text-muted transition-[color,transform] duration-300 ease-(--ease-out) group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                />
              </div>

              <div class="bento-body">
                <h3 class="bento-title">
                  <a href={urls.service(service.slug)} class="bento-link">
                    {service.name}
                  </a>
                </h3>
                <p class="bento-desc">{service.description}</p>
                {extra.fact && <p class="bento-fact">{extra.fact}</p>}
                {extra.tags && (
                  <ul class="bento-tags" aria-label={`${service.shortName} uses`}>
                    {extra.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
                {extra.price && typeof extra.price.amount === "number" && (
                  <PriceTag
                    amount={extra.price.amount}
                    unit={extra.price.unit ?? "day"}
                    note={extra.price.note}
                    class={extra.area === "drv" ? "pt-2" : "mt-auto pt-2"}
                  />
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }
  @media (width >= 48rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "drv drv"
        "self air"
        "month corp"
        "wed wed"
        "lux van";
      gap: 1rem;
    }
  }
  @media (width >= 64rem) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(4, minmax(13.5rem, auto));
      grid-template-areas:
        "drv drv self month"
        "drv drv air month"
        "wed wed corp lux"
        "van van corp lux";
    }
  }
  /* Phones: one column in source order (named areas only exist from 48rem). */
  @media (width < 48rem) {
    .bento-cell {
      grid-area: auto !important;
    }
  }

  .bento-card {
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    min-height: 13rem;
    flex-direction: column;
    gap: 1.25rem;
    overflow: hidden;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: var(--surface);
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .bento-card:hover {
    border-color: var(--line-strong);
  }
  .bento-card:has(.bento-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (width >= 64rem) {
    .bento-card {
      padding: 1.75rem;
    }
  }

  .bento-link {
    outline: none;
  }
  .bento-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bento-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .bento-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
  }
  .bento-title {
    font-size: var(--text-display-sm);
    line-height: var(--text-display-sm--line-height);
    letter-spacing: var(--text-display-sm--letter-spacing);
    color: var(--text);
  }
  .bento-desc {
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 34rem;
  }
  .bento-fact {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }
  .bento-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .bento-tags li {
    border-radius: 9999px;
    border: 1px solid var(--line);
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* With driver: the big cell. Steering wheel + light streaks. */
  .bento-cell--drv .bento-card {
    min-height: 22rem;
    background:
      radial-gradient(70% 60% at 85% 20%, var(--accent-soft), transparent 70%),
      var(--surface);
  }
  /* Big cell: visual on top, copy anchored to the bottom. */
  .bento-cell--drv .bento-body {
    justify-content: flex-end;
  }
  .bento-cell--drv .bento-body > :first-child {
    margin-top: auto;
  }
  .bento-cell--drv .bento-title {
    font-size: var(--text-display-md);
    line-height: var(--text-display-md--line-height);
    letter-spacing: var(--text-display-md--letter-spacing);
  }
  .bento-visual--drv {
    position: absolute;
    top: -12%;
    right: -10%;
    z-index: -1;
    width: min(26rem, 70%);
    aspect-ratio: 1;
    color: var(--text);
    opacity: 0.07;
    transition: transform 1.2s var(--ease-out);
  }
  .bento-card:hover .bento-visual--drv {
    transform: rotate(-14deg);
  }
  .bento-streak {
    position: absolute;
    left: -60%;
    height: 2px;
    width: 70%;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--accent));
    opacity: 0;
  }
  .bento-streak--1 {
    top: 64%;
  }
  .bento-streak--2 {
    top: 72%;
    width: 50%;
  }
  .bento-streak--3 {
    top: 80%;
    width: 60%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bento-card:hover .bento-streak {
      animation: bento-streak 1.4s var(--ease-out) both;
    }
    .bento-card:hover .bento-streak--2 {
      animation-delay: 0.12s;
    }
    .bento-card:hover .bento-streak--3 {
      animation-delay: 0.24s;
    }
  }
  @keyframes bento-streak {
    from {
      opacity: 0;
      transform: translateX(0);
    }
    30% {
      opacity: 0.9;
    }
    to {
      opacity: 0;
      transform: translateX(260%);
    }
  }

  /* Monthly: a 30 day grid that fills up. */
  .bento-month {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.4rem;
    max-width: 12rem;
  }
  .bento-day {
    aspect-ratio: 1;
    border-radius: 0.3rem;
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .bento-day.is-on {
    background: color-mix(in oklab, var(--accent) 55%, var(--surface-2));
    border-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bento-day.is-on {
        animation: bento-day linear both;
        animation-timeline: view();
        animation-range: entry calc(20% + var(--d) * 1.5%) cover calc(35% + var(--d) * 1.5%);
      }
    }
  }
  @keyframes bento-day {
    from {
      background: var(--surface-2);
    }
  }

  /* Airport: a dashed flight arc from the plane icon to the arrow, in the empty band at the top of
     the card (never behind the copy). */
  .bento-flight {
    position: absolute;
    top: 1.5rem;
    left: 5rem;
    right: 3.75rem;
    z-index: -1;
    height: 1.75rem;
    color: var(--muted);
    opacity: 0.6;
  }
  @media (width >= 64rem) {
    .bento-flight {
      top: 1.75rem;
      left: 5.25rem;
      right: 4rem;
    }
  }

  /* Weddings: the one accent-washed cell. */
  .bento-cell--wed .bento-card {
    background:
      radial-gradient(90% 120% at 0% 100%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 65%),
      var(--surface);
    border-color: color-mix(in oklab, var(--accent) 30%, var(--line));
  }

  /* Corporate: quiet, tall, ruled lines like a ledger. */
  .bento-cell--corp .bento-card {
    background:
      repeating-linear-gradient(180deg, transparent 0 31px, var(--line) 31px 32px),
      var(--surface);
  }

  /* Luxury: polished sheen sweeping across on hover. */
  .bento-cell--lux .bento-card {
    background: linear-gradient(160deg, var(--surface-2) 0%, var(--surface) 55%, var(--bg) 100%);
  }
  .bento-sheen {
    position: absolute;
    inset: -40% -60%;
    z-index: -1;
    background: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 0.07) 50%, transparent 58%);
    transform: translateX(-30%);
    transition: transform 1.1s var(--ease-out);
  }
  .bento-card:hover .bento-sheen {
    transform: translateX(30%);
  }

  /* Vans and coasters: wide cell, content in a row on large screens. */
  @media (width >= 64rem) {
    .bento-cell--van .bento-body,
    .bento-cell--wed .bento-body {
      max-width: 34rem;
    }
  }
</style>
