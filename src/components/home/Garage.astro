---
/**
 * The garage: every catalog model (featured first), as CarCards on one long track.
 *  - Phones, tablets, reduced motion: native horizontal scroll with snap points.
 *  - Fine-pointer desktop: the section pins (start "top top") and vertical scroll pans the track
 *    (GSAP ScrollTrigger, scrub, invalidateOnRefresh). Category chips re-filter with GSAP Flip.
 *  - Cards tilt slightly toward the pointer on desktop.
 * All cards, prices and links are in the HTML; JS only adds motion and filtering.
 */
import CarCard from "@/components/CarCard.astro";
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import type { CatalogCategory, CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";

interface Props {
  featured: CatalogModel[];
  models: CatalogModel[];
  categories: CatalogCategory[];
}

const { featured, models, categories } = Astro.props;
const featuredSlugs = new Set(featured.map((m) => m.slug));
const ordered = [...featured, ...models.filter((m) => !featuredSlugs.has(m.slug))];
const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
const chips = categories
  .map((c) => ({ slug: c.slug, name: c.name, count: models.filter((m) => m.category === c.slug).length }))
  .filter((c) => c.count > 0);
---

<section id="garage" class="garage" aria-labelledby="garage-title" data-garage>
  <div class="garage-pin" data-garage-pin>
    <Container class="garage-head">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-10">
        <div class="max-w-2xl">
          <h2 id="garage-title" class="text-display-lg text-fg">Cars on rent in Lahore</h2>
          <p class="garage-intro text-lede mt-4 text-muted">
            Walk the garage: hatchbacks for errands, sedans for business, SUVs for the north and a wedding car for the big day.
          </p>
        </div>
        <a
          href={urls.cars()}
          class="group inline-flex shrink-0 items-center gap-2 font-semibold text-fg underline decoration-line-strong decoration-1 underline-offset-[0.3em] transition-colors hover:decoration-accent"
        >
          See all cars
          <Icon name="ph:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>

      <div class="garage-chips scrollbar-none" role="group" aria-label="Filter cars by type">
        <button type="button" class="garage-chip" aria-pressed="true" data-filter="all" data-label="All cars">
          All <span class="garage-chip__count tabular">{models.length}</span>
        </button>
        {
          chips.map((chip) => (
            <button type="button" class="garage-chip" aria-pressed="false" data-filter={chip.slug} data-label={chip.name}>
              {chip.name} <span class="garage-chip__count tabular">{chip.count}</span>
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-garage-status></p>
    </Container>

    <div class="garage-viewport scrollbar-none" data-garage-viewport>
      <ul class="garage-track" data-garage-track>
        {
          ordered.map((model) => (
            <li class="garage-item" data-category={model.category}>
              <div class="garage-card">
                <CarCard
                  model={model}
                  categoryName={categoryName(model.category)}
                  headingLevel="h3"
                  sizes="(min-width: 1024px) 360px, 80vw"
                  tilt={false}
                />
              </div>
            </li>
          ))
        }
        <li class="garage-item garage-item--end">
          <a href={urls.cars()} class="garage-end group">
            <Icon name="ph:garage" size={34} class="text-accent" />
            <span class="font-display text-display-sm text-fg">See all cars</span>
            <span class="text-sm text-muted">Rates, seats, luggage and features for all {models.length} models in the fleet.</span>
            <span class="garage-end__arrow" aria-hidden="true">
              <Icon name="ph:arrow-right" size={22} />
            </span>
          </a>
        </li>
      </ul>
    </div>

    <Container class="garage-foot">
      <nav aria-label="Browse cars by type" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="text-muted">Browse by type:</span>
        {
          chips.map((chip) => (
            <a href={urls.category(chip.slug)} class="font-semibold text-fg underline-offset-4 transition-colors hover:text-accent-fg hover:underline">
              {chip.name}
            </a>
          ))
        }
      </nav>
      <SampleFleetNote />
    </Container>
  </div>
</section>

<style>
  .garage {
    position: relative;
    /* Filtering reflows the cards (Flip): never let the browser pick them as scroll anchors. */
    overflow-anchor: none;
  }

  .garage-pin {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-block: var(--section-space);
    overflow: clip;
  }

  .garage-chips {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block: 0.25rem;
  }
  @media (width >= 48rem) {
    .garage-chips {
      flex-wrap: wrap;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  .garage-chip {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-radius: 9999px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface-2) 60%, transparent);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      transform 0.15s var(--ease-out);
  }
  .garage-chip:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .garage-chip:active {
    transform: scale(0.97);
  }
  .garage-chip[aria-pressed="true"] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .garage-chip__count {
    font-size: 0.75rem;
    /* 0.85 keeps the small count above 4.5:1 in both themes. */
    opacity: 0.85;
  }

  /* Native mode: horizontal scroll with snap points. */
  .garage-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100% - var(--container-site)) / 2 + var(--gutter)));
  }

  .garage-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding-block: 0.75rem 1.25rem;
    padding-inline: max(var(--gutter), calc((100% - var(--container-site)) / 2 + var(--gutter)));
  }

  .garage-item {
    flex: none;
    width: min(80vw, 21rem);
    scroll-snap-align: start;
  }
  .garage-item.is-out {
    display: none;
  }
  /* Items stretch to the tallest card in the row; let the card (h-full) follow so every card's
     bottom edge and price row line up, whatever the number of "suitable for" chips. */
  .garage-card {
    height: 100%;
  }

  .garage-end {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 18rem;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: var(--radius-card);
    border: 1px dashed var(--line-strong);
    background: radial-gradient(80% 60% at 100% 100%, var(--accent-soft), transparent 70%);
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .garage-end:hover {
    border-color: var(--accent);
    background-color: var(--surface);
  }
  .garage-end__arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 9999px;
    background: var(--accent-fill);
    color: var(--accent-ink);
    transition: transform 0.3s var(--ease-out);
  }
  .garage-end:hover .garage-end__arrow {
    transform: translateX(4px);
  }

  .garage-foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (width >= 48rem) {
    .garage-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Desktop with room to pin: one viewport-tall band, the same height before and after GSAP pins it
     (no jump). Cards are sized from the height left after the header, title, chips and footer. */
  @media (width >= 64rem) and (height >= 52rem) {
    .garage-pin {
      height: 100dvh;
      justify-content: safe center;
      gap: 0.75rem;
      padding-top: calc(var(--header-h) + 0.5rem);
      padding-bottom: 0.75rem;
    }
    .garage-chips {
      margin-top: 1rem;
    }
    .garage-track {
      padding-block: 0.5rem 0.75rem;
    }
    .garage-item {
      width: clamp(18rem, calc((100dvh - 39rem) * 1.6), 22.5rem);
    }
    /* The pinned band sits under the floating WhatsApp button for the whole pan: keep the foot clear of it. */
    .garage :global(.garage-foot) {
      padding-right: max(var(--gutter), 12rem);
    }
  }
  @media (width >= 64rem) and (height < 62rem) {
    .garage-intro {
      display: none;
    }
  }

  /* Pinned mode (set by the script): the track is moved by GSAP instead of scrolled. */
  .garage[data-mode="pin"] .garage-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .garage[data-mode="pin"] .garage-track {
    will-change: transform;
  }

  /* Pointer tilt (desktop only). */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .garage-card {
      transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform 0.6s var(--ease-out);
    }
  }
</style>

<script>
  import { hasFinePointer, prefersReducedMotion, whenIdle } from "@/scripts/capabilities";
  import { onPageAnimations } from "@/scripts/motion";

  type Gsap = typeof import("gsap").gsap;
  type ScrollTriggerType = typeof import("gsap/ScrollTrigger").ScrollTrigger;
  type FlipType = typeof import("gsap/Flip").Flip;

  const PIN_QUERY = "(min-width: 64rem) and (min-height: 52rem) and (hover: hover) and (pointer: fine)";
  /** Scroll distance per pixel of horizontal pan (below 1 = the track moves faster than the page). */
  const PAN_RATIO = 0.75;

  function initGarage(garage: HTMLElement) {
    const pin = garage.querySelector<HTMLElement>("[data-garage-pin]");
    const viewport = garage.querySelector<HTMLElement>("[data-garage-viewport]");
    const track = garage.querySelector<HTMLElement>("[data-garage-track]");
    const status = garage.querySelector<HTMLElement>("[data-garage-status]");
    if (!pin || !viewport || !track) return;

    const chips = [...garage.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...track.querySelectorAll<HTMLElement>(".garage-item[data-category]")];
    let current = "all";
    let pinned: { gsap: Gsap; ScrollTrigger: ScrollTriggerType; Flip: FlipType; trigger: InstanceType<ScrollTriggerType> } | null = null;

    const allItems = [...track.querySelectorAll<HTMLElement>(".garage-item")];
    let pendingOut: { kill(): void } | null = null;
    let flipTimeline: { kill(): void } | null = null;
    let filterToken = 0;

    const matches = (item: HTMLElement, slug: string) => slug === "all" || item.dataset.category === slug;

    function applyFilter(slug: string) {
      for (const item of items) item.classList.toggle("is-out", !matches(item, slug));
    }

    function setFilter(slug: string) {
      if (slug === current) return;
      current = slug;

      const shown = items.filter((item) => matches(item, slug)).length;
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.filter === slug));
      const label = chips.find((c) => c.dataset.filter === slug)?.dataset.label ?? "";
      if (status) {
        status.textContent =
          slug === "all" ? `Showing all ${shown} models.` : `Showing ${shown} ${shown === 1 ? "model" : "models"} in ${label}.`;
      }

      if (!pinned) {
        applyFilter(slug);
        viewport?.scrollTo({ left: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" });
        return;
      }

      // Pinned desktop: rewind to the start of the pinned stretch while the leaving cards fade, then
      // Flip the rest into place. Nothing scrolls between Flip.getState() and Flip.from(), so the pin
      // state is identical for both measurements.
      const { gsap, ScrollTrigger, Flip, trigger } = pinned;
      const token = ++filterToken;
      pendingOut?.kill();
      flipTimeline?.kill();
      gsap.set(allItems, { clearProps: "opacity,transform" });
      const leaving = items.filter((item) => !item.classList.contains("is-out") && !matches(item, slug));

      const fade = new Promise<void>((resolve) => {
        if (!leaving.length) return resolve();
        pendingOut = gsap.to(leaving, { opacity: 0, scale: 0.94, duration: 0.25, ease: "power2.in", onComplete: () => resolve() });
      });

      Promise.all([fade, rewindTo(trigger.start)]).then(() => {
        if (token !== filterToken) return; // a newer click took over
        pendingOut = null;
        const state = Flip.getState(allItems.filter((item) => !item.classList.contains("is-out")));
        applyFilter(current);
        if (leaving.length) gsap.set(leaving, { clearProps: "opacity,transform" });
        ScrollTrigger.refresh();
        flipTimeline = Flip.from(state, {
          duration: 0.75,
          ease: "power3.inOut",
          onEnter: (els) =>
            gsap.fromTo(els, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.5, delay: 0.2, ease: "power3.out" }),
        });
      });
    }

    /** Scroll back to `top` (smoothly, through Lenis when it runs), then let ScrollTrigger catch up. */
    async function rewindTo(top: number): Promise<void> {
      if (window.scrollY <= top + 1) return;
      const settle = (resolve: () => void) => requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      const lenis = await import("@/scripts/smooth-scroll").then((m) => m.getLenis()).catch(() => null);
      await new Promise<void>((resolve) => {
        if (lenis) {
          lenis.scrollTo(top, { duration: 0.7, force: true, onComplete: () => settle(resolve) });
          return;
        }
        const timer = window.setTimeout(() => settle(resolve), 900);
        window.addEventListener(
          "scrollend",
          () => {
            window.clearTimeout(timer);
            settle(resolve);
          },
          { once: true },
        );
        window.scrollTo({ top, behavior: "smooth" });
      });
    }

    for (const chip of chips) chip.addEventListener("click", () => setFilter(chip.dataset.filter ?? "all"));

    // Pinned mode moves the track with a transform, so the browser cannot scroll a focused card into
    // view by itself. When keyboard focus lands on a card, jump the page to the pan position that
    // centres it (WCAG 2.4.11: focus not hidden).
    track.addEventListener("focusin", (event) => {
      if (!pinned) return;
      const item = (event.target as Element).closest<HTMLElement>(".garage-item");
      if (!item) return;
      const { trigger } = pinned;
      const max = Math.max(0, track.scrollWidth - viewport.clientWidth);
      const offset = item.getBoundingClientRect().left - track.getBoundingClientRect().left;
      const x = Math.min(max, Math.max(0, offset - (viewport.clientWidth - item.offsetWidth) / 2));
      const top = Math.round(trigger.start + (trigger.end - trigger.start) * (max ? x / max : 0));
      if (Math.abs(window.scrollY - top) < 2) return;
      import("@/scripts/smooth-scroll")
        .then((m) => m.getLenis())
        .catch(() => null)
        .then((lenis) => {
          if (lenis) lenis.scrollTo(top, { immediate: true, force: true });
          else window.scrollTo({ top, behavior: "instant" });
        });
    });

    // Pointer tilt: one delegated listener, transforms written once per frame.
    if (hasFinePointer() && !prefersReducedMotion()) {
      let active: HTMLElement | null = null;
      let frame = 0;
      const reset = (card: HTMLElement | null) => {
        card?.style.setProperty("--rx", "0deg");
        card?.style.setProperty("--ry", "0deg");
      };
      track.addEventListener("pointermove", (event) => {
        const card = (event.target as Element).closest<HTMLElement>(".garage-card");
        if (card !== active) {
          reset(active);
          active = card;
        }
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          card.style.setProperty("--ry", `${(x * 7).toFixed(2)}deg`);
          card.style.setProperty("--rx", `${(-y * 6).toFixed(2)}deg`);
        });
      });
      track.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        reset(active);
        active = null;
      });
    }

    // Pinned horizontal pan: desktop with a fine pointer and motion allowed.
    if (window.matchMedia(PIN_QUERY).matches && !prefersReducedMotion()) {
      whenIdle(() => {
        import("gsap/Flip")
          .then(({ Flip }) =>
            onPageAnimations(
              ({ gsap, ScrollTrigger }) => {
                gsap.registerPlugin(Flip);
                const mm = gsap.matchMedia();
                mm.add(PIN_QUERY, () => {
                  garage.dataset.mode = "pin";
                  const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
                  const tween = gsap.to(track, {
                    x: () => -distance(),
                    ease: "none",
                    scrollTrigger: {
                      trigger: garage,
                      pin,
                      start: "top top",
                      end: () => `+=${Math.round(distance() * PAN_RATIO)}`,
                      scrub: true,
                      invalidateOnRefresh: true,
                      anticipatePin: 1,
                      // Above the How it works pins: measure first so their positions include this spacing.
                      refreshPriority: 1,
                    },
                  });
                  if (tween.scrollTrigger) pinned = { gsap, ScrollTrigger, Flip, trigger: tween.scrollTrigger };
                  // Pins created later than (or before) other sections' triggers: re-measure everything in page order.
                  ScrollTrigger.sort();
                  ScrollTrigger.refresh();
                  return () => {
                    pinned = null;
                    delete garage.dataset.mode;
                  };
                });
                return () => {
                  mm.revert();
                  pinned = null;
                  delete garage.dataset.mode;
                };
              },
              { scope: garage },
            ),
          )
          .catch(() => {});
      }, 1500);
    }
  }

  const garage = document.querySelector<HTMLElement>("[data-garage]");
  if (garage) initGarage(garage);
</script>
