---
/**
 * Pickup areas: a slow marquee of the neighbourhood names as the large type moment, then a compact
 * list with every /areas/<slug>/ link and its one-line pickup note. The marquee repeats the list, so it
 * is hidden from assistive tech and holds no links.
 */
import Container from "@/components/Container.astro";
import { site } from "@/config/site";
import { urls } from "@/lib/urls";
import { areaNote } from "./home-data";

const areas = site.areasServed.map((area) => ({ ...area, note: areaNote(area) }));
---

<section id="areas" class="areas" aria-labelledby="areas-title">
  <div class="areas-rule" data-fx="rule"></div>
  <div class="areas-marquee" data-fx="marquee" data-speed="38" aria-hidden="true">
    {areas.map((area, i) => <span class:list={["areas-word", i % 2 === 1 && "areas-word--italic"]}>{area.name}</span>)}
  </div>
  <div class="areas-rule" data-fx="rule" data-delay="0.15"></div>

  <Container class="areas-body">
    <div class="areas-head">
      <h2 id="areas-title" class="areas-title" data-fx="lines">Pickups across <em>Lahore</em></h2>
      <p class="areas-text">From Cantt to Bahria Town, our drivers know the gates, the shortcuts and where to park. Pick your area for drive times and pickup points.</p>
      <a href={urls.areas()} class="areas-all link-draw">All areas we serve</a>
    </div>

    <ol class="areas-list" data-fx="stagger" data-stagger="0.05">
      {
        areas.map((area) => (
          <li>
            <a href={urls.area(area.slug)} class="areas-row">
              <span class="areas-name">{area.name}</span>
              <span class="areas-note">{area.note}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .areas {
    padding-block: clamp(1.5rem, 3vw, 3rem) clamp(3rem, 5vw, 5rem);
  }
  .areas-rule {
    height: 1px;
    background: var(--line);
  }
  .areas-marquee {
    display: flex;
    width: 100%;
    white-space: nowrap;
    padding-block: 0.1em 0.2em;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 1.75rem + 8vw, 10rem);
    line-height: 1.1;
    color: var(--text);
  }
  .areas-word {
    flex: none;
    padding-inline: 0.45em;
  }
  .areas-word--italic {
    font-style: italic;
    color: var(--accent);
  }

  .areas :global(.areas-body) {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(1.75rem, 4vw, 3.5rem);
  }
  @media (width >= 64rem) {
    .areas :global(.areas-body) {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.8fr);
      gap: 4rem;
    }
  }
  .areas-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-variation-settings: "opsz" var(--display-opsz);
    font-size: clamp(2.75rem, 1.9rem + 2.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.008em;
    color: var(--text);
  }
  .areas-text {
    margin-top: 1rem;
    max-width: 26rem;
    color: var(--muted);
  }
  .areas-all {
    display: inline-block;
    margin-top: 1rem;
    color: var(--text);
    font-weight: 500;
  }

  .areas-list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (width >= 40rem) {
    .areas-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  .areas-row {
    position: relative;
    display: block;
    height: 100%;
    padding-block: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    outline: none;
  }
  .areas-row::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.9s var(--ease-heavy);
  }
  .areas-row:hover::after,
  .areas-row:focus-visible::after {
    transform: scaleX(1);
  }
  .areas-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.15;
    transition: color 0.6s var(--ease-heavy);
  }
  .areas-row:hover .areas-name,
  .areas-row:focus-visible .areas-name {
    color: var(--accent-fg);
  }
  .areas-note {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }
</style>
