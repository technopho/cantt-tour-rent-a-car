---
/**
 * How renting works: a three-step strip. One picture cut into three panes, one step under each.
 * On phones the strip scrolls sideways with snap points, the next card peeking in.
 * What gets confirmed before booking stays available in a closed accordion.
 */
import Container from "@/components/Container.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/config/site";
import { urls } from "@/lib/urls";
import type { HomeImage } from "./home-data";

interface Props {
  image?: HomeImage;
}

const { image } = Astro.props;
const confirmed = [
  "The final price, with fuel, tolls and duty hours spelled out",
  "The car, the pickup time and the pickup point",
  "Your driver's name and number, shared before the trip",
  "For self drive: the deposit, km allowance and return time",
];
const steps = ["01", "02", "03"];
---

<section id="how" class="how" aria-labelledby="how-title">
  <Container class="how-head">
    <h2 id="how-title" class="how-title" data-fx="lines">How renting a car <em>works</em></h2>
    <p class="how-intro" data-fx="fade" data-delay="0.2">Three steps from the first message to a car at your door. No paperwork marathon.</p>
  </Container>

  <Container>
    <ol class="how-strip">
      {
        steps.map((num, i) => (
          <li class="how-step" style={`--i:${i}`}>
            <div class="how-pane" data-fx="image" data-delay={(i * 0.12).toFixed(2)}>
              {image && (
                <img
                  src={image.img.src}
                  srcset={image.img.srcset || undefined}
                  sizes={image.img.srcset ? "100vw" : undefined}
                  width={image.img.width}
                  height={image.img.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="how-img"
                />
              )}
              <span class="how-num" aria-hidden="true">{num}</span>
              {/* The one picture's small print, on the picture: the first pane on phones (the one in view), the
                  last from 768px up (the right end of the strip). */}
              {image?.caption && (i === 0 || i === 2) && <span class:list={["how-cap", i === 0 ? "how-cap--first" : "how-cap--last"]}>{image.caption}</span>}
            </div>
            {i === 0 && (
              <div class="how-copy" data-fx="fade">
                <h3 class="how-name">Tell us your trip</h3>
                <p>Pick a car, the dates and where we should pick you up. Use the trip composer or send a WhatsApp message, whichever is quicker for you.</p>
                <a href={site.cta.quote.href} class="how-link link-draw">{site.cta.quote.label}</a>
              </div>
            )}
            {i === 1 && (
              <div class="how-copy" data-fx="fade" data-delay="0.12">
                <h3 class="how-name">We confirm on WhatsApp</h3>
                <p>Our team replies with the final price, what it includes and the car details. Nothing is booked until you say yes.</p>
                <details class="how-more">
                  <summary>
                    What we confirm before you book
                    <Icon name="ph:plus" size={16} class="how-more__icon text-accent" />
                  </summary>
                  <ul>
                    {confirmed.map((item) => <li>{item}</li>)}
                  </ul>
                </details>
              </div>
            )}
            {i === 2 && (
              <div class="how-copy" data-fx="fade" data-delay="0.24">
                <h3 class="how-name">Drive or get driven</h3>
                <p>Your driver arrives at the agreed time and place. For self drive, collect the keys after a quick handover in Lahore Cantt with your CNIC and driving licence.</p>
                <a href={urls.service("self-drive-car-rental-lahore")} class="how-link link-draw">Self drive requirements</a>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .how {
    padding-block: clamp(3.5rem, 6vw, 6rem) clamp(2.5rem, 4vw, 4rem);
  }
  .how :global(.how-head) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
  }
  .how-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 1.75rem + 3.6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.008em;
    color: var(--text);
  }
  .how-intro {
    max-width: 24rem;
    color: var(--muted);
  }
  @media (width >= 48rem) {
    .how :global(.how-head) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  /* Phones: the three steps are a strip you swipe, the third card peeking in. */
  .how-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 0.75rem;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .how-strip::-webkit-scrollbar {
    display: none;
  }
  .how-step {
    scroll-snap-align: start;
  }
  .how-pane {
    position: relative;
    height: 9.5rem;
    overflow: hidden;
    background: var(--surface);
  }
  .how-pane::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(7 7 8 / 0.5), transparent 40%);
  }
  /* One picture cut across the three panes. */
  .how-img {
    position: absolute;
    top: 0;
    left: calc(var(--i) * -100%);
    width: 300%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .how-num {
    position: absolute;
    z-index: 1;
    left: 0.875rem;
    bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: 3.75rem;
    line-height: 1;
    color: var(--text);
  }
  .how-copy {
    margin-top: 0.875rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .how-name {
    margin: 0 0 0.375rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.875rem;
    line-height: 1.1;
    color: var(--text);
  }
  .how-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--text);
    font-weight: 500;
  }
  .how-more {
    margin-top: 0.75rem;
  }
  .how-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    font-weight: 500;
  }
  .how-more summary::-webkit-details-marker {
    display: none;
  }
  .how-more :global(.how-more__icon) {
    transition: transform 0.7s var(--ease-heavy);
  }
  .how-more[open] :global(.how-more__icon) {
    transform: rotate(45deg);
  }
  .how-more ul {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-left: 0.875rem;
    border-left: 1px solid var(--line-strong);
  }
  .how-cap {
    position: absolute;
    z-index: 1;
    top: 0.6rem;
    right: 0.75rem;
    font-size: 0.625rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: rgb(242 236 224 / 0.75);
    text-shadow: 0 1px 6px rgb(7 7 8 / 0.8);
  }
  .how-cap--last {
    display: none;
  }
  @media (width >= 48rem) {
    .how-cap--first {
      display: none;
    }
    .how-cap--last {
      display: block;
    }
  }

  @media (width >= 48rem) {
    .how-strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
    .how-pane {
      height: clamp(11rem, 30dvh, 19rem);
    }
    .how-num {
      left: 1.25rem;
      bottom: 0.5rem;
      font-size: clamp(4.5rem, 7vw, 7.5rem);
    }
    .how-copy {
      padding-right: clamp(1rem, 3vw, 3rem);
      margin-top: 1.25rem;
      font-size: 1rem;
    }
    .how-name {
      font-size: clamp(1.875rem, 1.4rem + 1vw, 2.5rem);
    }
  }
</style>
