---
/**
 * Discreet note shown when the build used the SAMPLE catalog (catalog.sample.json, "sample": true).
 * Renders nothing once the real catalog is published from the control panel.
 *
 *   <SampleFleetNote />            place near fleet grids / price tables
 */
import { getCatalogMeta } from "@/lib/catalog";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const meta = await getCatalogMeta();
---

{
  meta.sample && (
    <p
      class:list={[
        "inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1.5 text-xs text-muted",
        className,
      ]}
    >
      <Icon name="ph:info" size={14} class="text-accent" />
      Sample fleet: cars and prices are placeholders until the real catalog is published.
    </p>
  )
}
