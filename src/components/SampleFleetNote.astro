---
/**
 * Quiet line of small text shown when the build used the SAMPLE catalog (catalog.sample.json, "sample": true).
 * Renders nothing once the real catalog is published from the control panel.
 *
 *   <SampleFleetNote />            place near fleet grids / price tables
 */
import { getCatalogMeta } from "@/lib/catalog";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const meta = await getCatalogMeta();
---

{
  meta.sample && (
    <p class:list={["max-w-prose text-xs leading-relaxed text-muted", className]}>
      Sample fleet: cars and prices are placeholders until the real catalog is published.
    </p>
  )
}
