---
/**
 * Brand mark: the C with its bar (ivory stroke, brass bar, same shape as public/brand/logo.png) beside
 * "Cantt" and "Rent a Car" in tracked caps. Set in the text face because Bodoni is 28px and up only.
 *
 *   <Logo />                     link to home (default)
 *   <Logo size="lg" href={null} />  plain, not a link
 *   <Logo markOnly />            only the C
 */
import { site } from "@/config/site";

interface Props {
  href?: string | null;
  size?: "sm" | "md" | "lg";
  markOnly?: boolean;
  class?: string;
}

const { href = "/", size = "md", markOnly = false, class: className } = Astro.props;

const s = {
  sm: { mark: 30, word: "text-[0.8125rem]", sub: "text-[0.5rem]", gap: "gap-2.5" },
  md: { mark: 34, word: "text-[0.875rem]", sub: "text-[0.53125rem]", gap: "gap-3" },
  lg: { mark: 48, word: "text-[1.0625rem]", sub: "text-[0.625rem]", gap: "gap-3.5" },
}[size];

const Tag = href ? "a" : "span";
---

<Tag
  href={href ?? undefined}
  class:list={["group/logo inline-flex items-center text-fg", s.gap, className]}
  aria-label={href ? `${site.name}, home` : undefined}
>
  <svg width={s.mark} height={s.mark} viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false" class="shrink-0 overflow-visible">
    <path d="M21.66 10.34A8 8 0 1 0 21.66 21.66" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    <rect
      x="17.6"
      y="15.1"
      width="9.4"
      height="1.8"
      rx="0.9"
      fill="var(--accent)"
      class="origin-[17.6px_16px] transition-transform duration-700 ease-(--ease-out) group-hover/logo:scale-x-[1.28]"></rect>
  </svg>
  {
    !markOnly && (
      <span class="flex flex-col gap-[0.32em] leading-none whitespace-nowrap" aria-hidden={href ? "true" : undefined}>
        <span class:list={["font-sans font-medium uppercase tracking-[0.34em]", s.word]}>Cantt</span>{" "}
        <span class:list={["font-sans font-medium uppercase tracking-[0.27em] text-muted", s.sub]}>Rent a Car</span>
      </span>
    )
  }
</Tag>
