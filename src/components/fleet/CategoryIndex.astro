---
/**
 * Big typographic index of car types, each row linking to /cars/<category>/ with the catalog description,
 * model count, seat range and "from" price. The name is the design: no boxes, no icons.
 *
 *   <CategoryIndex categories={categories} models={models} />
 *   <CategoryIndex categories={others} models={models} size="sm" />   (compact "other types" list)
 */
import PriceTag from "@/components/PriceTag.astro";
import type { CatalogCategory, CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";
import { lowest, seatRange } from "./fleet-data";

interface Props {
  categories: CatalogCategory[];
  models: CatalogModel[];
  size?: "lg" | "sm";
  headingLevel?: "h2" | "h3";
  class?: string;
}

const { categories, models, size = "lg", headingLevel: Heading = "h3", class: className } = Astro.props;

const rows = categories
  .map((c) => {
    const list = models.filter((m) => m.category === c.slug);
    return { ...c, count: list.length, from: lowest(list, (m) => m.rates.fromPrice), seats: seatRange(list) };
  })
  .filter((r) => r.count > 0);
const isLg = size === "lg";
---

<ol class:list={["border-t border-line", className]}>
  {
    rows.map((row) => (
      <li class="category-row group relative border-b border-line" data-cursor="View">
        <div class:list={["grid items-baseline gap-x-10 gap-y-2", isLg ? "py-7 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_auto] md:py-9" : "py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"]}>
          <Heading class:list={["category-row__name text-fg transition-[color,transform] duration-1000 ease-(--ease-out) group-hover:text-accent", isLg ? "text-display-lg" : "text-display-sm"]}>
            <a href={urls.category(row.slug)} class="outline-none after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:after:outline-1 focus-visible:after:outline-accent">
              {row.name}
            </a>
          </Heading>
          {isLg && row.description && <p class="max-w-xl text-[0.9375rem] leading-relaxed text-muted">{row.description}</p>}
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted md:justify-end">
            <span>
              {row.count} {row.count === 1 ? "model" : "models"}
              {row.seats && ` · ${row.seats}`}
            </span>
            <PriceTag amount={row.from} size="sm" />
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .group:hover .category-row__name {
      transform: translateX(0.25em);
    }
  }
</style>
