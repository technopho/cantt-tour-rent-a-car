---
/**
 * Key specs on hairlines (dl semantics) plus the feature list. Quiet on purpose: no boxes, no icons.
 *
 *   <SpecGrid model={model} categoryName="Sedans" categoryHref="/cars/sedan/" />
 */
import { fuelLabel, modelYears, transmissionLabel } from "@/lib/catalog";
import type { CatalogModel } from "@/lib/catalog-types";
import { formatNumber } from "@/lib/format";
import { availabilityLabel, singularName } from "./fleet-data";

interface Props {
  model: CatalogModel;
  categoryName: string;
  categoryHref?: string;
  class?: string;
}

const { model, categoryName, categoryHref, class: className } = Astro.props;
const years = modelYears(model);

const specs = [
  { label: "Seats", value: `${model.seats} seats` },
  model.luggage !== null ? { label: "Luggage", value: `${model.luggage} large ${model.luggage === 1 ? "bag" : "bags"}` } : null,
  { label: "Gearbox", value: transmissionLabel(model.transmission) },
  { label: "Fuel", value: fuelLabel(model.fuel) },
  model.engineCc ? { label: "Engine", value: `${formatNumber(model.engineCc)} cc` } : null,
  years ? { label: "Model years", value: years } : null,
  { label: "Type", value: singularName(categoryName), href: categoryHref },
  { label: "Available", value: availabilityLabel(model) },
].filter((s): s is { label: string; value: string; href?: string } => s !== null);
---

<div class={className}>
  <dl class="grid grid-cols-2 gap-x-8 border-t border-line sm:grid-cols-3 xl:grid-cols-4">
    {
      specs.map((s) => (
        <div class="border-b border-line py-4">
          <dt class="label text-muted">{s.label}</dt>
          <dd class="mt-2 text-[1.0625rem] text-fg">
            {s.href ? (
              <a href={s.href} class="underline decoration-line-strong underline-offset-4 transition-colors duration-500 hover:text-accent-fg">
                {s.value}
              </a>
            ) : (
              s.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    model.features.length > 0 && (
      <div class="mt-10">
        <h3 class="label text-muted">Features</h3>
        <ul class="mt-4 grid gap-x-8 border-t border-line text-[0.9375rem] text-fg/90 sm:grid-cols-2">
          {model.features.map((f) => (
            <li class="border-b border-line py-3">{f}</li>
          ))}
        </ul>
      </div>
    )
  }
</div>
