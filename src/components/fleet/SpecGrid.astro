---
/**
 * Key specs as a grid of small cards (dl semantics) plus the feature list.
 *
 *   <SpecGrid model={model} categoryName="Sedans" categoryHref="/cars/sedan/" />
 */
import Icon from "@/components/Icon.astro";
import { fuelLabel, modelYears, transmissionLabel } from "@/lib/catalog";
import type { CatalogModel } from "@/lib/catalog-types";
import { formatNumber } from "@/lib/format";
import { availabilityLabel, singularName } from "./fleet-data";

interface Props {
  model: CatalogModel;
  categoryName: string;
  categoryHref?: string;
  class?: string;
}

const { model, categoryName, categoryHref, class: className } = Astro.props;
const years = modelYears(model);

const CATEGORY_ICONS: Record<string, string> = {
  hatchback: "ph:car-simple",
  sedan: "ph:car-profile",
  suv: "ph:jeep",
  luxury: "ph:crown-simple",
  wedding: "ph:sparkle",
  van: "ph:van",
  coaster: "ph:bus",
};

const specs = [
  { icon: "ph:users", label: "Seats", value: `${model.seats} seats` },
  model.luggage !== null
    ? { icon: "ph:suitcase-rolling", label: "Luggage", value: `${model.luggage} large ${model.luggage === 1 ? "bag" : "bags"}` }
    : null,
  { icon: "ph:gear-six", label: "Gearbox", value: transmissionLabel(model.transmission) },
  { icon: model.fuel === "electric" ? "ph:lightning" : model.fuel === "hybrid" ? "ph:leaf" : "ph:gas-pump", label: "Fuel", value: fuelLabel(model.fuel) },
  model.engineCc ? { icon: "ph:engine", label: "Engine", value: `${formatNumber(model.engineCc)} cc` } : null,
  years ? { icon: "ph:calendar-blank", label: "Model years", value: years } : null,
  { icon: CATEGORY_ICONS[model.category] ?? "ph:car-profile", label: "Type", value: singularName(categoryName), href: categoryHref },
  { icon: "ph:steering-wheel", label: "Available", value: availabilityLabel(model) },
].filter((s): s is { icon: string; label: string; value: string; href?: string } => s !== null);
---

<div class={className}>
  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
    {
      specs.map((s) => (
        <div class="relative flex flex-col gap-2 rounded-card border border-line bg-surface p-4 md:p-5" data-reveal="fade">
          <Icon name={s.icon} size={22} class="text-accent" />
          <dt class="mt-1 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-muted">{s.label}</dt>
          <dd class="font-display text-[1.0625rem] leading-snug font-semibold tracking-[-0.02em] text-fg">
            {s.href ? (
              <a href={s.href} class="underline decoration-line underline-offset-4 transition-colors hover:text-accent-fg hover:decoration-current">
                {s.value}
              </a>
            ) : (
              s.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    model.features.length > 0 && (
      <div class="mt-8">
        <h3 class="font-sans text-sm font-bold uppercase tracking-[0.14em] text-muted">Features</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {model.features.map((f) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-2 text-sm text-fg">
              <Icon name="ph:check" size={15} class="text-accent" />
              {f}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
