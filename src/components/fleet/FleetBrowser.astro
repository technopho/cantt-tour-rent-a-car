---
/**
 * /cars/ fleet gallery with hairline type filters and an optional service filter. Largest cars first.
 *
 * Progressive enhancement:
 *  - Without JS the type filters are plain links to /cars/<category>/ and every car is listed.
 *  - With JS they filter the gallery in place (modifier clicks still open the category page), the gallery
 *    re-flows its rhythm around what is left (gallery-slots.ts),
 *    the "Any / With driver / Self drive" switch appears, the URL keeps ?type=&service= for sharing,
 *    and the re-flow animates with a same-document View Transition where supported (no library).
 *
 *   <FleetBrowser models={models} categories={categories} />
 */
import type { CatalogCategory, CatalogModel } from "@/lib/catalog-types";
import { urls } from "@/lib/urls";
import GalleryPlate from "./GalleryPlate.astro";
import { categoryLabel } from "./fleet-data";
import { gallerySlots, picturesFirst } from "./gallery-slots";
import { byLargest, modelVisual } from "./model-visual";

interface Props {
  models: CatalogModel[];
  /** Categories that have at least one model, in catalog order. */
  categories: CatalogCategory[];
  class?: string;
}

const { models, categories, class: className } = Astro.props;
const chips = categories.map((c) => ({ ...c, count: models.filter((m) => m.category === c.slug).length })).filter((c) => c.count > 0);
const names = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
// Cars with a picture first, then name-only rows under "Also in the fleet": a name row must never sit
// straight above another car's picture. Filtering keeps this order, so it holds for every filter.
const ordered = picturesFirst([...models].sort(byLargest), (m) => Boolean(modelVisual(m)));
const slots = gallerySlots(ordered.map((m) => Boolean(modelVisual(m))));
const dividerAt = slots.findIndex((slot) => slot === "row");
---

<div class:list={["fleet-browser", className]} data-fleet-browser data-names={JSON.stringify(names)}>
  <div class="fleet-bar z-20 -mx-(--gutter) flex flex-col gap-1 border-b border-line bg-(--header-bg) px-(--gutter) py-1 backdrop-blur-xl not-supports-[backdrop-filter:blur(1px)]:bg-bg md:sticky md:flex-row md:items-center md:justify-between md:gap-8">
    <nav aria-label="Car types" class="-mx-1 min-w-0 overflow-x-auto px-1 scrollbar-none" data-lenis-prevent-wheel>
      <ul class="flex w-max items-center gap-x-6">
        <li>
          <a href={urls.cars()} class="fleet-chip" data-filter="all" data-active="true">
            All cars <sup class="fleet-chip__count">{models.length}</sup>
          </a>
        </li>
        {
          chips.map((c) => (
            <li>
              <a href={urls.category(c.slug)} class="fleet-chip" data-filter={c.slug}>
                {c.name} <sup class="fleet-chip__count">{c.count}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div role="group" aria-label="Service" class="flex shrink-0 items-center gap-x-5 self-start md:self-auto" data-service-filter hidden>
      <button type="button" class="fleet-seg" data-service="any" aria-pressed="true">Any</button>
      <button type="button" class="fleet-seg" data-service="driver" aria-pressed="false">With driver</button>
      <button type="button" class="fleet-seg" data-service="self" aria-pressed="false">Self drive</button>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-fleet-status></p>

  <ul class="plate-grid mt-12 md:mt-20" data-fleet-grid>
    {
      ordered.map((model, i) => (
        <>
        {i === dividerAt && i > 0 && (
          <li class="plate-divider" aria-hidden="true" data-fleet-divider>
            <p class="label text-muted">Also in the fleet</p>
          </li>
        )}
        <li
          class="fleet-item"
          data-slug={model.slug}
          data-category={model.category}
          data-driver={String(model.rates.withDriver !== null)}
          data-self-drive={String(model.rates.selfDrive !== null)}
          data-has-image={String(Boolean(modelVisual(model)))}
          data-slot={slots[i]}
        >
          <GalleryPlate model={model} categoryName={categoryLabel(model.category, categories)} headingLevel="h3" />
        </li>
        </>
      ))
    }
  </ul>

  <div class="mt-8 flex flex-col items-start gap-4 border-y border-line py-8 sm:flex-row sm:items-center sm:justify-between" data-fleet-empty hidden>
    <p class="text-display-sm text-fg">No cars match this combination.</p>
    <button type="button" class="fleet-seg" data-fleet-reset>Show all cars</button>
  </div>
</div>

<style>
  /* Stays under the header, and takes its place when the header hides on the way down. */
  .fleet-bar {
    top: var(--header-h);
    transition: top 0.6s var(--ease-heavy);
  }
  :global(html:has([data-site-header][data-hidden="true"])) .fleet-bar {
    top: 0;
  }

  /* Hairline text controls: the active one carries a brass rule. */
  .fleet-chip,
  .fleet-seg {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding-block: 0.95rem;
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    transition: color 0.5s var(--ease-heavy);
  }
  .fleet-chip::after,
  .fleet-seg::after {
    content: "";
    position: absolute;
    inset: auto 0 0.5rem 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.7s var(--ease-heavy);
  }
  .fleet-chip:hover,
  .fleet-seg:hover {
    color: var(--text);
  }
  .fleet-chip[data-active="true"],
  .fleet-seg[aria-pressed="true"] {
    color: var(--text);
  }
  .fleet-chip[data-active="true"]::after,
  .fleet-seg[aria-pressed="true"]::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }
  .fleet-chip__count {
    color: var(--muted);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    vertical-align: baseline;
    position: relative;
    top: -0.35em;
    line-height: 0;
  }
  /* Before the script runs, "All cars" is a plain link to this page: keep it neutral. */
  :global(html:not(.js)) .fleet-chip[data-active="true"]::after {
    transform: scaleX(0);
  }
</style>

<style is:global>
  /* Same-document view transition for the filter: cards glide, the page itself does not fade. */
  html.vt-fleet::view-transition-old(root),
  html.vt-fleet::view-transition-new(root) {
    animation: none;
  }
  html.vt-fleet::view-transition-group(*) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  html.vt-fleet::view-transition-new(*):only-child {
    animation: 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both fleet-in;
  }
  html.vt-fleet::view-transition-old(*):only-child {
    animation: 0.22s ease-in both fleet-out;
  }
  @keyframes fleet-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  @keyframes fleet-out {
    to {
      opacity: 0;
      transform: scale(0.94);
    }
  }
</style>

<script>
  import { gallerySlots } from "./gallery-slots";

  type Service = "any" | "driver" | "self";

  const root = document.querySelector<HTMLElement>("[data-fleet-browser]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>(".fleet-item")];
    const chips = [...root.querySelectorAll<HTMLAnchorElement>("[data-filter]")];
    const segs = [...root.querySelectorAll<HTMLButtonElement>("[data-service]")];
    const serviceGroup = root.querySelector<HTMLElement>("[data-service-filter]");
    const status = root.querySelector<HTMLElement>("[data-fleet-status]");
    const empty = root.querySelector<HTMLElement>("[data-fleet-empty]");
    const reset = root.querySelector<HTMLButtonElement>("[data-fleet-reset]");
    const divider = root.querySelector<HTMLElement>("[data-fleet-divider]");
    const names: Record<string, string> = JSON.parse(root.dataset.names || "{}");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const params = new URLSearchParams(location.search);
    let category = params.get("type") && names[params.get("type") as string] ? (params.get("type") as string) : "all";
    let service: Service = (["driver", "self"] as const).includes(params.get("service") as "driver" | "self")
      ? (params.get("service") as Service)
      : "any";

    const matches = (el: HTMLElement) =>
      (category === "all" || el.dataset.category === category) &&
      (service === "any" || (service === "driver" ? el.dataset.driver === "true" : el.dataset.selfDrive === "true"));

    const render = () => {
      let shown = 0;
      const visibleItems: HTMLElement[] = [];
      for (const el of items) {
        const visible = matches(el);
        el.hidden = !visible;
        if (visible) {
          shown++;
          visibleItems.push(el);
        }
      }
      const slots = gallerySlots(visibleItems.map((el) => el.dataset.hasImage === "true"));
      visibleItems.forEach((el, i) => (el.dataset.slot = slots[i]));
      // "Also in the fleet" only separates pictures from name rows: with either side empty it goes.
      if (divider) divider.hidden = !(slots.includes("row") && slots.some((slot) => slot !== "row"));
      chips.forEach((chip) => {
        const active = chip.dataset.filter === category;
        chip.dataset.active = String(active);
        chip.setAttribute("aria-pressed", String(active));
      });
      segs.forEach((seg) => seg.setAttribute("aria-pressed", String(seg.dataset.service === service)));
      if (empty) empty.hidden = shown > 0;
      if (status) {
        const where = category === "all" ? "" : ` in ${names[category] ?? category}`;
        const how = service === "driver" ? " with a driver" : service === "self" ? " for self drive" : "";
        status.textContent = `Showing ${shown} ${shown === 1 ? "car" : "cars"}${where}${how}.`;
      }
    };

    const syncUrl = () => {
      const url = new URL(location.href);
      if (category === "all") url.searchParams.delete("type");
      else url.searchParams.set("type", category);
      if (service === "any") url.searchParams.delete("service");
      else url.searchParams.set("service", service);
      history.replaceState(history.state, "", url);
    };

    // Layout changed: scroll-triggered reveals and parallax must measure again.
    const remeasure = () => {
      import("@/scripts/fx").then((m) => m.refreshFx(root)).catch(() => {});
    };

    const update = () => {
      syncUrl();
      // When the chip bar is stuck (the user is deep in the grid), bring the results' start back into view.
      const headerOffset = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) * 16 || 72;
      const rootTop = root.getBoundingClientRect().top;
      const apply = () => {
        render();
        if (rootTop < 0) window.scrollTo({ top: window.scrollY + root.getBoundingClientRect().top - headerOffset, behavior: "instant" });
      };
      const doc = document as Document & {
        startViewTransition?: (cb: () => void) => { finished: Promise<void>; ready: Promise<void>; updateCallbackDone: Promise<void> };
      };
      if (!doc.startViewTransition || reduced.matches || document.visibilityState !== "visible") {
        apply();
        remeasure();
        return;
      }
      // Name only the cards involved so they glide into their new grid positions.
      const named = items.filter((el) => !el.hidden || matches(el));
      named.forEach((el) => (el.style.viewTransitionName = `fleet-${el.dataset.slug}`));
      document.documentElement.classList.add("vt-fleet");
      const transition = doc.startViewTransition(apply);
      // A quick second click aborts the running transition; the DOM update still happens, so the
      // rejected animation promises are expected and silenced.
      transition.ready.catch(() => {});
      transition.updateCallbackDone.catch(() => {});
      transition.finished.catch(() => {}).finally(() => {
        named.forEach((el) => (el.style.viewTransitionName = ""));
        document.documentElement.classList.remove("vt-fleet");
        remeasure();
      });
    };

    chips.forEach((chip) => {
      chip.setAttribute("role", "button");
      chip.addEventListener("click", (event) => {
        // Let new-tab / new-window clicks open the category page.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        const next = chip.dataset.filter ?? "all";
        category = next === category && next !== "all" ? "all" : next;
        update();
      });
      chip.addEventListener("keydown", (event) => {
        if (event.key === " ") {
          event.preventDefault();
          chip.click();
        }
      });
    });

    segs.forEach((seg) =>
      seg.addEventListener("click", () => {
        service = (seg.dataset.service as Service) ?? "any";
        update();
      }),
    );

    reset?.addEventListener("click", () => {
      category = "all";
      service = "any";
      update();
    });

    if (serviceGroup) serviceGroup.hidden = false;
    render();
  }
</script>
