---
/**
 * "Best for" rows on a model page: one row per suitableFor tag with model-specific copy and a link
 * to the matching service or route page.
 *
 *   <BestFor model={model} />
 */
import type { CatalogModel } from "@/lib/catalog-types";
import { bestFor } from "./fleet-data";

interface Props {
  model: CatalogModel;
  class?: string;
}

const { model, class: className } = Astro.props;
const items = bestFor(model);
---

{
  items.length > 0 && (
    <ul class:list={["border-t border-line", className]}>
      {items.map((item) => (
        <li class="grid gap-2 border-b border-line py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
          <div class="min-w-0">
            <h3 class="text-[1.0625rem] font-medium text-fg">{item.label}</h3>
            <p class="mt-1.5 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">{item.text}</p>
          </div>
          <a href={item.href} class="text-sm text-accent-fg underline underline-offset-4 sm:text-right">
            {item.linkLabel}
          </a>
        </li>
      ))}
    </ul>
  )
}
