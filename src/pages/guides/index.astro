---
/**
 * Guides hub (/guides/): editorial index of the car rental guides (newest update first),
 * with reading time and last updated date. ItemList JSON-LD + BreadcrumbList (PageLayout).
 */
import { getCollection } from "astro:content";
import JsonLd from "@/components/JsonLd.astro";
import Section from "@/components/Section.astro";
import Plate from "@/components/local/Plate.astro";
import { firstPlate, guidePlate, platePool, scenePlate, trails, type Plate as PlateData } from "@/components/local/plates";
import RouteLinks from "@/components/local/RouteLinks.astro";
import { guideReadMinutes } from "@/components/local/guide-extras";
import { itemListSchema } from "@/components/local/schema";
import PageLayout from "@/layouts/PageLayout.astro";
import { formatDate, isoDate } from "@/lib/format";
import { urls } from "@/lib/urls";

const PREFERRED = [
  "cost-to-rent-a-car-in-lahore",
  "documents-to-rent-a-car-in-pakistan",
  "self-drive-vs-car-with-driver-lahore",
  "lahore-to-northern-areas-road-trip-guide",
  "renting-a-car-in-lahore-overseas-pakistanis",
];

const guides = (await getCollection("guides", ({ data }) => !data.draft)).sort((a, b) => {
  const pa = PREFERRED.indexOf(a.id);
  const pb = PREFERRED.indexOf(b.id);
  if (pa !== pb) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb);
  return b.data.updatedAt.getTime() - a.data.updatedAt.getTime();
});
const readMinutes = guideReadMinutes;
const routes = await getCollection("routes");
const [lead, ...rest] = guides;
const hero = firstPlate(scenePlate("chauffeur", "lahore-night")) ?? trails();
// Each guide keeps its own picture; if two would show the same image, the later one takes the next free one.
const used = new Set([hero.img.src]);
const plates = new Map<string, PlateData>();
for (const g of guides) {
  const own = guidePlate(g.id);
  const plate = used.has(own.img.src) ? (platePool(g.id).find((p) => !used.has(p.img.src)) ?? own) : own;
  used.add(plate.img.src);
  plates.set(g.id, plate);
}
---

<PageLayout
  title="Car Rental Guides for Lahore and Pakistan"
  description="Guides to renting a car in Lahore: what it costs, documents you need, self drive vs driver, northern road trips and tips for overseas visitors."
  h1="Car rental guides for Lahore"
  intro="Straight answers to the questions people ask before renting a car in Lahore. No jargon, no fine print, updated for 2026."
  crumbs={[{ label: "Guides" }]}
  heroImage={hero.img}
  heroCaption={hero.caption}
  heroPosition={hero.position}
  heroHeight="short"
>
  <JsonLd slot="jsonld" data={itemListSchema("Car rental guides for Lahore", guides.map((g) => ({ name: g.data.title, url: urls.guide(g.id) })))} />


  <Section id="guides" aria-label="All guides" spacing="sm">
    {
      lead && (
        <a href={urls.guide(lead.id)} class="group block" data-cursor="Read">
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-14">
            <Plate plate={plates.get(lead.id)} ratio="aspect-[4/3] lg:aspect-[16/10]" sizes="(min-width: 64rem) 60vw, 100vw" />
            <div class="flex flex-col gap-5">
              <span class="text-sm text-accent-fg tabular">01</span>
              <span class="text-display-lg text-fg transition-colors duration-500 group-hover:text-accent-fg" data-fx="lines">{lead.data.title}</span>
              <span class="text-lede text-muted" data-fx="fade">{lead.data.excerpt}</span>
              <span class="text-sm text-muted">
                Updated <time datetime={isoDate(lead.data.updatedAt)}>{formatDate(lead.data.updatedAt)}</time>, {readMinutes(lead.body)} min read
              </span>
            </div>
          </div>
        </a>
      )
    }

    <ol class="mt-24 flex flex-col gap-20 md:mt-32 md:gap-28">
      {
        rest.map((g, i) => (
          <li>
            <a href={urls.guide(g.id)} class="group grid gap-8 md:grid-cols-2 md:items-center md:gap-14 lg:gap-24" data-cursor="Read">
              <Plate plate={plates.get(g.id)} ratio="aspect-[3/2]" sizes="(min-width: 48rem) 50vw, 100vw" class={i % 2 === 0 ? "md:order-2" : undefined} />
              <span class="flex flex-col gap-5">
                <span class="text-sm text-accent-fg tabular">{String(i + 2).padStart(2, "0")}</span>
                <span class="text-display-md text-fg transition-colors duration-500 group-hover:text-accent-fg" data-fx="lines">{g.data.title}</span>
                <span class="max-w-[52ch] leading-relaxed text-muted" data-fx="fade">{g.data.excerpt}</span>
                <span class="text-sm text-muted">
                  Updated <time datetime={isoDate(g.data.updatedAt)}>{formatDate(g.data.updatedAt)}</time>, {readMinutes(g.body)} min read
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="routes" labelledby="routes-title" divider>
    <h2 id="routes-title" class="text-display-lg text-fg" data-fx="lines">Road trip guides from Lahore</h2>
    <p class="text-lede mt-5 max-w-2xl text-muted" data-fx="fade">Every outstation route has its own guide with drive times, stops, seasons and the right car.</p>
    <RouteLinks routes={routes} limit={6} class="mt-12" />
  </Section>
</PageLayout>
