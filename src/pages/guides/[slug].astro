---
/**
 * Guide page (/guides/<slug>/): evergreen article with a table of contents, a live data block
 * from the catalog / site.ts, image plates and pull quotes between sections, related links and Article JSON-LD (organisation as author).
 */
import { getCollection, render } from "astro:content";
import Button from "@/components/Button.astro";
import JsonLd from "@/components/JsonLd.astro";
import Section from "@/components/Section.astro";
import Plate from "@/components/local/Plate.astro";
import Reading from "@/components/local/Reading.astro";
import { guidePlate, guidePool } from "@/components/local/plates";
import GuideExtras from "@/components/local/GuideExtras.astro";
import GuideToc from "@/components/local/GuideToc.astro";
import { GUIDE_LINKS, guideExtra, guideReadMinutes, guideWordCount } from "@/components/local/guide-extras";
import { articleSchema } from "@/components/local/schema";
import { site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { formatDate, isoDate } from "@/lib/format";
import { whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const words = guideWordCount(entry.body);
const minutes = guideReadMinutes(entry.body);
const extra = guideExtra(entry.id);
const h2s = headings.filter((h) => h.depth === 2);
const toc = [...h2s.map((h) => ({ slug: h.slug, text: h.text })), ...(extra ? [{ slug: extra.id, text: extra.title }] : [])];
const links = GUIDE_LINKS[entry.id] ?? [];
const others = (await getCollection("guides", ({ data: d }) => !d.draft)).filter((g) => g.id !== entry.id);
const path = urls.guide(entry.id);
const hero = guidePlate(entry.id);
// Pictures between sections: never the hero, nor a picture already on a "More guides" card at the foot of the page.
const onPage = new Set([hero.img.src, ...others.map((g) => guidePlate(g.id).img.src)]);
const interludes = guidePool(entry.id).filter((p) => !onPage.has(p.img.src)).slice(0, 3);
const shortTitle = data.title.replace(/\?$/, "").split(":")[0];
---

<PageLayout
  title={data.metaTitle}
  description={data.metaDescription}
  h1={data.title}
  intro={data.excerpt}
  crumbs={[{ label: "Guides", href: urls.guides() }, { label: shortTitle }]}
  type="article"
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt}
  heroImage={hero.img}
  heroCaption={hero.caption}
  heroPosition={hero.position}
>
  <JsonLd
    slot="jsonld"
    data={articleSchema({
      headline: data.title,
      description: data.metaDescription,
      url: path,
      datePublished: data.publishedAt,
      dateModified: data.updatedAt,
      wordCount: words,
      sections: h2s.map((h) => h.text),
    })}
  />

  <Fragment slot="h1"><span class="guide-title">{data.title}</span></Fragment>

  <Fragment slot="actions">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-fg/80">
      <li>
        Updated <time datetime={isoDate(data.updatedAt)}>{formatDate(data.updatedAt)}</time>
      </li>
      <li>{minutes} min read</li>
      <li>By the {site.name} team</li>
    </ul>
  </Fragment>

  <div class="read-progress" aria-hidden="true"></div>

  <Section id="article" aria-label={data.title}>
    <div class="grid gap-12 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <GuideToc items={toc} />
      </div>

      <article class="guide-body min-w-0">
        <Reading html={entry.rendered?.html} slug={entry.id} plates={interludes} every={2}>
          <Content />
        </Reading>

        {extra && <GuideExtras extra={extra} />}

        <div class="mt-20 flex flex-col gap-5 border-t border-accent pt-8" data-fab-hide>
          <p class="text-display-md text-fg" data-fx="lines">Need a car in Lahore?</p>
          <p class="max-w-[52ch] text-muted">Tell us the car, your dates and where to pick you up. We reply on WhatsApp with a clear price.</p>
          <div class="flex flex-wrap gap-3">
            <Button href={urls.quote()} iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
            <Button href={whatsappUrl()} variant="secondary" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
              {site.cta.whatsapp.label}
            </Button>
          </div>
        </div>

        {
          links.length > 0 && (
            <nav aria-labelledby="related-title" class="mt-16">
              <h2 id="related-title" class="label text-muted">
                Related pages
              </h2>
              <ul class="mt-4 grid border-t border-line sm:grid-cols-3 sm:gap-x-8">
                {links.map((l) => (
                  <li class="border-b border-line">
                    <a href={l.href} class="block py-4 text-fg transition-colors duration-500 hover:text-accent-fg">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </article>
    </div>
  </Section>

  {
    others.length > 0 && (
      <Section id="more-guides" labelledby="more-guides-title" divider>
        <h2 id="more-guides-title" class="text-display-lg text-fg" data-fx="lines">
          More guides
        </h2>
        <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
          {others.map((g) => (
            <li>
              <a href={urls.guide(g.id)} class="group flex flex-col gap-5" data-cursor="Read">
                <Plate plate={guidePlate(g.id)} ratio="aspect-[4/3]" sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw" parallax={false} />
                <span class="text-display-sm text-fg transition-colors duration-500 group-hover:text-accent-fg">{g.data.title}</span>
                <span class="text-sm leading-relaxed text-muted">{g.data.excerpt}</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</PageLayout>

<style>
  .guide-title {
    display: block;
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 5.25rem);
    line-height: 1.02;
  }
  /* Wide markdown tables scroll inside the article (html/body clip horizontal overflow). */
  .guide-body :global(.prose-site table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  /* A brass hairline at the top of the screen tracks the reading position. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .read-progress {
        position: fixed;
        inset: 0 0 auto;
        z-index: 70;
        height: 1px;
        background: var(--accent);
        transform-origin: 0 50%;
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
