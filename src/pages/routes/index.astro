---
/**
 * Routes hub (/routes/): transit-style mini map + list of every outstation route with
 * approximate distance, drive time and season; outstation pricing rules with catalog prices;
 * car choice by trip type; quote; FAQs.
 */
import { getCollection } from "astro:content";
import Button from "@/components/Button.astro";
import FaqList from "@/components/FaqList.astro";
import JsonLd from "@/components/JsonLd.astro";
import PriceTag from "@/components/PriceTag.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Interlude from "@/components/local/Interlude.astro";
import Plate from "@/components/local/Plate.astro";
import OutstationPricing from "@/components/local/OutstationPricing.astro";
import QuoteBand from "@/components/local/QuoteBand.astro";
import RouteNetworkMap from "@/components/local/RouteNetworkMap.astro";
import { firstPlate, fleetPlate, picker, roadPlate, terrain, trails } from "@/components/local/plates";
import { cheapestOutstation, withDriverOnly } from "@/components/local/pricing";
import { ROUTE_META, routeMeta } from "@/components/local/route-meta";
import { itemListSchema } from "@/components/local/schema";
import { site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { getCategories, getModels, getModelsSuitableFor } from "@/lib/catalog";
import { formatDriveTime, formatKm } from "@/lib/format";
import { whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const entries = await getCollection("routes");
const order = ROUTE_META.map((r) => r.slug);
const routes = [...entries].sort((a, b) => {
  const ia = order.indexOf(a.data.slug);
  const ib = order.indexOf(b.data.slug);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const groups = [
  { id: "north", title: "Mountains and the north", routes: routes.filter((r) => routeMeta(r.data.slug).region === "north") },
  { id: "punjab", title: "Cities, shrines and the border", routes: routes.filter((r) => routeMeta(r.data.slug).region !== "north") },
];

const [models, categories, outstationTagged] = await Promise.all([getModels(), getCategories(), getModelsSuitableFor("outstation")]);
const outstationModels = withDriverOnly(outstationTagged.length ? outstationTagged : models);

/** Car choice by trip type, with the cheapest outstation day rate per category from the catalog. */
const choices = [
  {
    plate: firstPlate(fleetPlate("mercedes-s-class"), fleetPlate("honda-civic")),
    title: "Sedans for the motorway",
    text: "Islamabad, Sialkot, Faisalabad and Multan are motorway trips. A sedan with a driver is comfortable and economical for up to four people.",
    category: "sedan",
    linkLabel: "See sedans",
  },
  {
    plate: firstPlate(fleetPlate("toyota-land-cruiser"), fleetPlate("toyota-prado")),
    title: "SUVs and 4x4s for the mountains",
    text: "For Murree in snow, Naran, Hunza and Skardu, ground clearance and power matter. Pick an SUV, and a 4x4 for the high passes.",
    category: "suv",
    linkLabel: "See SUVs",
  },
  {
    plate: fleetPlate("toyota-hiace"),
    title: "Vans and coasters for groups",
    text: "Families, wedding parties, school trips and office outings travel together in a Toyota Hiace or a coaster, with room for luggage.",
    category: "van",
    linkLabel: "See vans",
  },
].map((c) => {
  const cat = categories.find((x) => x.slug === c.category);
  // Same pool as the pricing rules above (cars offered for outstation), so the two "from" prices agree.
  const tagged = outstationModels.filter((m) => m.category === c.category);
  const inCat = tagged.length ? tagged : withDriverOnly(models.filter((m) => m.category === c.category));
  return { ...c, href: cat ? urls.category(cat.slug) : urls.cars(), price: cheapestOutstation(inCat)?.price ?? null, linkLabel: cat ? c.linkLabel : "See the fleet" };
});

// The motorway north opens the page, Skardu carries "The road decides the car", and the quote band sits over the
// terrain of the north: three pictures, none repeated.
const pick = picker("/routes/", { pool: [roadPlate("hunza"), terrain(), trails()] });
const hero = pick(roadPlate("motorway")) ?? trails();
const interlude = pick(roadPlate("skardu"), roadPlate("hunza"));
const band = pick(terrain());

const faqs = [
  {
    q: "How is an outstation trip priced?",
    a: "Each 24-hour day from your pickup time is charged at the car's outstation rate with a driver. For every night away from Lahore there is a fixed driver night allowance for his stay and meals. Fuel, tolls and parking are charged at actual cost.",
  },
  {
    q: "Can I rent a self drive car for an outstation trip?",
    a: "Outstation trips are mostly booked with a driver, and for the northern areas we strongly recommend one. If you want a self drive car outside Lahore, ask us: it depends on the car, the route and your documents.",
  },
  {
    q: "Do you do one way trips from Lahore?",
    a: "Yes, for example a drop at Islamabad airport or a move to another city. The car and driver return to Lahore afterwards, and the price reflects the return journey.",
  },
  {
    q: "Is it safe to travel to the northern areas by road?",
    a: "Many families make the trip every summer. Drive in daylight, keep spare days for landslides and road closures, check the weather before high passes like Babusar, and choose an experienced driver and a suitable car.",
  },
  {
    q: "How far ahead should I book an outstation trip?",
    a: "For summer trips north, Eid holidays and long weekends, book two to three weeks ahead because SUVs and vans go first. For motorway trips like Islamabad or Faisalabad, a few days is usually enough.",
  },
];
---

<PageLayout
  title="Outstation Car Rental from Lahore: Routes and Times"
  description="Car rental with driver from Lahore to Islamabad, Murree, Naran, Hunza, Skardu, Swat, Sialkot, Multan and more. Distances, drive times and pricing."
  h1="Outstation car rental from Lahore"
  intro="Motorway runs to Islamabad, family weekends in Murree and two-day drives to Hunza. Every route with distance, drive time, the right car and an honest price."
  crumbs={[{ label: "Outstation routes" }]}
  heroImage={hero.img}
  heroCaption={hero.caption}
  heroPosition={hero.position}
>
  <JsonLd slot="jsonld" data={itemListSchema("Outstation routes from Lahore", routes.map((r) => ({ name: r.data.h1, url: urls.route(r.data.slug) })))} />

  <Fragment slot="actions">
    <Button href="#quote" size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl("Assalam o Alaikum! I need a car with driver for an outstation trip from Lahore.")} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </Fragment>


  <Section id="routes" aria-label="All outstation routes from Lahore">
    <div class="grid gap-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-12 lg:gap-20">
      <div class="md:sticky md:top-[calc(var(--header-h)+1.5rem)] md:self-start">
        <RouteNetworkMap routes={routes.map((r) => ({ slug: r.data.slug, distanceKm: r.data.distanceKm, driveHours: r.data.driveHours }))} />
      </div>
      <div class="flex flex-col gap-20">
        {
          groups.map((g) => (
            <div>
              <h2 id={`group-${g.id}`} class="text-display-md text-fg" data-fx="lines">
                {g.title}
              </h2>
              <ol class="mt-8 border-t border-line" aria-labelledby={`group-${g.id}`}>
                {g.routes.map((r) => {
                  const m = routeMeta(r.data.slug);
                  return (
                    <li class="border-b border-line" data-reveal="fade">
                      <a href={urls.route(r.data.slug)} class="route-row group flex flex-col gap-3 py-7" data-route-row={r.data.slug} data-cursor="View">
                        <span class="route-name text-display-md text-fg transition-[color,transform] duration-700 ease-(--ease-out) group-hover:translate-x-2">Lahore to {r.data.to}</span>
                        <span class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted tabular">
                          <span>about {formatKm(r.data.distanceKm)}</span>
                          <span>
                            {formatDriveTime(r.data.driveHours)}
                            {m.timeNote ? `, ${m.timeNote}` : ""}
                          </span>
                          <span>{m.season}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Interlude plate={interlude} decorative>The road decides the car.</Interlude>

  <Section id="choose" labelledby="choose-title">
    <SectionHeading id="choose-title" title="Pick the car for the road" intro="The road decides the car. A quick guide, with the lowest outstation day rate in each group." />
    <ul class="mt-16 flex flex-col gap-20 md:gap-28">
      {
        choices.map((c, i) => (
          <li class:list={["grid items-center gap-8 md:gap-14", c.plate ? "md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]" : "max-w-3xl"]}>
            {c.plate && <Plate plate={c.plate} sizes="(min-width: 48rem) 55vw, 100vw" class={i % 2 === 1 ? "md:order-2" : undefined} />}
            <div class="flex flex-col gap-5">
              <h3 class="text-display-md text-fg" data-fx="lines">{c.title}</h3>
              <p class="max-w-[52ch] leading-relaxed text-muted" data-fx="fade">{c.text}</p>
              <div class="flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-line pt-5" data-fx="fade">
                <PriceTag amount={c.price} size="lg" note={c.price ? "outstation" : undefined} />
                <a href={c.href} class="link-draw text-accent-fg">{c.linkLabel}</a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <SampleFleetNote class="mt-16" />
  </Section>

  <Section id="pricing" labelledby="pricing-title" divider>
    <SectionHeading
      id="pricing-title"
      title="How outstation pricing works"
      intro="The same four rules for every trip out of Lahore. Prices below come straight from our current fleet rates."
    />
    <OutstationPricing models={outstationModels} days={3} class="mt-14" />
  </Section>

  <QuoteBand
    title="Plan your trip out of Lahore"
    intro="Pick a car, your dates and where you are going. We confirm the route, the driver and a clear price on WhatsApp."
    defaultServiceType="with_driver"
    defaultTripType="outstation"
    whatsappMessage="Assalam o Alaikum! I need a car with driver for an outstation trip from Lahore."
    plate={band}
  />

  <Section id="faq" labelledby="faq-title" divider>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div>
        <SectionHeading id="faq-title" title="Outstation trips: questions" size="md" />
        <p class="mt-6 text-sm text-muted">
          Planning a long trip? Read our <a href={urls.guide("lahore-to-northern-areas-road-trip-guide")} class="link-draw text-accent-fg">northern areas road trip guide</a>.
        </p>
      </div>
      <FaqList faqs={faqs} exclusive id="routes-faq" />
    </div>
  </Section>
</PageLayout>

<style>
  .route-row:global(.is-active) .route-name {
    color: var(--accent-fg);
  }
</style>
