---
/**
 * /partner-with-us/: for car owners and investors who want to attach a car with the company.
 * How it works, the two earning models (no promised returns or percentages), who looks after
 * what, documents, the cars we look for (catalog categories) and an enquiry CTA (WhatsApp +
 * email, deliberately not the rental quote composer).
 */
import Button from "@/components/Button.astro";
import FaqList from "@/components/FaqList.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Interlude from "@/components/local/Interlude.astro";
import Plate from "@/components/local/Plate.astro";
import { fleetPlate, picker, scenePlate, trails } from "@/components/local/plates";
import { site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { getCategories } from "@/lib/catalog";
import { mailtoUrl, whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const categories = await getCategories();

const partnerMessage = `Assalam o Alaikum! I want to attach my car with ${site.name}.\nCar and model year:\nArea in Lahore:`;
const partnerWhatsapp = whatsappUrl(partnerMessage);
const partnerEmail = mailtoUrl(site.email, "Attach my car with Cantt Rent a Car");

const pick = picker("/partner-with-us/");
const hero = pick(scenePlate("garage"), fleetPlate("toyota-land-cruiser")) ?? trails();
const modelPlates = [pick(scenePlate("wedding"), fleetPlate("toyota-prado")), pick(scenePlate("monthly"), fleetPlate("toyota-fortuner"))];
const interlude = pick(scenePlate("corporate", "lahore-night"), fleetPlate("mercedes-s-class"));
// The night road under "Let it earn": dark enough for the brass italic, and a car's working life in one picture.
const closing = pick(trails(), scenePlate("lahore-night"));

const steps = [
  {
    title: "Send us the car details",
    text: "Make, model, year, mileage, colour and where the car is in Lahore, with a few photos. WhatsApp is quickest.",
  },
  {
    title: "Inspection and paperwork check",
    text: "We inspect the car with you and check the registration, token tax and ownership papers. We tell you honestly whether it suits our customers.",
  },
  {
    title: "A written management agreement",
    text: "Term, earning model, who pays for what, how the car is used and how either side can end the agreement, all on paper before the car moves.",
  },
  {
    title: "We run the rentals",
    text: "Pricing, bookings, customer checks, deposits, drivers, cleaning and handovers. Your car is rented on the same terms as the rest of our fleet.",
  },
  {
    title: "Monthly statement and payout",
    text: "Every month you get a statement of rental days, income, expenses and your share or rent, followed by the payout on the agreed date.",
  },
];

const models = [
  {
    title: "Profit share",
    lead: "Your earnings follow the car's actual rental income.",
    points: [
      "Each month, the car's rental income minus agreed running costs is shared between you and us.",
      "Busy months, such as the wedding season and the summer holidays, pay more. Quiet months pay less.",
      "Suits owners who want the upside of a car that rents well.",
    ],
  },
  {
    title: "Fixed monthly rent",
    lead: "A set amount every month, whatever the bookings.",
    points: [
      "We pay an agreed rent for the car each month, regardless of how many days it was rented.",
      "Predictable income, with the booking risk on our side.",
      "Suits owners who value certainty over the highest possible return.",
    ],
  },
];

const responsibilities = [
  { item: "Bookings, pricing and customer communication", who: "Us" },
  { item: "Customer checks: CNIC, licence, deposit", who: "Us" },
  { item: "Cleaning and handover inspections with photos", who: "Us" },
  { item: "Traffic challans during rentals", who: "Recovered from the renter by us" },
  { item: "Routine servicing, oil changes and tyres", who: "Agreed per car" },
  { item: "Insurance policy", who: "Agreed per car" },
  { item: "Tracker installation and monitoring", who: "Agreed per car" },
  { item: "Token tax and registration renewals", who: "Usually the owner, as the car stays in your name" },
  { item: "Accident damage during a rental", who: "Renter's deposit and insurance first, then as per agreement" },
];

const documents = [
  { text: "Original registration book or smart card" },
  { text: "Owner's CNIC", note: "and the owner's consent if the car is in a family member's name" },
  { text: "Token tax paid up to date" },
  { text: "Insurance policy, if the car is insured" },
  { text: "Tracker certificate, if a tracker is fitted" },
  { text: "Service history, if you have it" },
  { text: "Bank's permission, if the car is on lease" },
];

const faqs = [
  {
    q: "How much will my car earn?",
    a: "It depends on the model, year, condition and demand for that kind of car, and on the earning model you choose. We will not promise a number in advance. After inspecting the car we explain the realistic range, and the agreement sets exactly how your share or rent is calculated.",
  },
  {
    q: "Does the car stay in my name?",
    a: "Yes. Ownership does not change. The agreement gives us permission to rent and manage the car for the agreed term.",
  },
  {
    q: "Who drives my car?",
    a: "Our verified drivers for with driver bookings, and checked customers with a CNIC, licence and refundable deposit for self drive. You can ask for your car to be rented with a driver only.",
  },
  {
    q: "Can I use my car myself sometimes?",
    a: "Yes, if you tell us in advance so it is not booked. Some owners keep it for Eid or a family wedding. Your own days simply count as unavailable.",
  },
  {
    q: "How do I end the agreement?",
    a: "The agreement sets a notice period. After the last booking finishes, we hand the car back with its papers, a final inspection and a final statement.",
  },
];
---

<PageLayout
  title="Attach Your Car with a Rent a Car Company in Lahore"
  description="Own a car in Lahore? Attach it with Cantt Rent a Car: a management agreement, profit share or fixed rent, and monthly statements. No inflated promises."
  h1="Attach your car with us"
  intro="Own a car that sits parked, or plan to buy one? We run the rentals and send a monthly statement."
  crumbs={[{ label: "Partner with us" }]}
  whatsappMessage={partnerMessage}
  hideFooterCta
  heroImage={hero.img}
  heroCaption={hero.caption}
  heroPosition={hero.position}
>
  <div slot="actions" class="grid w-full gap-3 sm:flex sm:w-auto sm:flex-wrap" data-fab-hide>
    <Button href={partnerWhatsapp} size="lg" icon="simple-icons:whatsapp" external>{site.cta.whatsapp.label}</Button>
    <Button href={partnerEmail} variant="secondary" size="lg" icon="ph:envelope-simple">Email us</Button>
  </div>


  <section class="container-site mt-10 md:mt-16" aria-label="What you get">
    <p class="label text-muted">What you get</p>
    <ul class="mt-5 grid grid-cols-1 border-t border-line sm:grid-cols-2 lg:grid-cols-4" data-fx="stagger">
      <li class="border-b border-line py-6 pr-6 text-display-sm text-fg lg:border-r lg:px-6 lg:first:pl-0 lg:last:border-r-0">A written management agreement</li>
      <li class="border-b border-line py-6 pr-6 text-display-sm text-fg lg:border-r lg:px-6 lg:first:pl-0 lg:last:border-r-0">A statement every month</li>
      <li class="border-b border-line py-6 pr-6 text-display-sm text-fg lg:border-r lg:px-6 lg:first:pl-0 lg:last:border-r-0">Photos at every handover</li>
      <li class="border-b border-line py-6 pr-6 text-display-sm text-fg lg:border-r lg:px-6 lg:first:pl-0 lg:last:border-r-0">Ownership stays with you</li>
    </ul>
  </section>

  <!-- How it works -->
  <Section id="how" labelledby="how-title">
    <SectionHeading id="how-title" eyebrow="How it works" title="From parked to earning, in five steps" />
    <ol class="partner-steps relative mt-16 flex flex-col border-b border-line">
      {
        steps.map((s, i) => (
          <li class="relative grid gap-4 border-t border-line py-9 md:grid-cols-[4rem_minmax(0,1fr)_minmax(0,1.1fr)] md:items-baseline md:gap-10 lg:py-12">
            <p class="text-sm text-accent-fg tabular" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="text-display-md text-fg" data-fx="lines">{s.title}</h3>
            <p class="max-w-[56ch] leading-[1.75] text-muted" data-fx="fade">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Two earning models -->
  <Section id="models" labelledby="models-title" divider>
    <SectionHeading
      id="models-title"
      title="Two ways to earn"
      intro="Choose the model that fits you. The exact share or rent depends on the car's model, year, condition and demand, and is written into your agreement."
    />
    <div class="mt-16 grid gap-16 md:grid-cols-2 md:gap-12 lg:gap-20">
      {
        models.map((m, i) => (
          <div class:list={["flex flex-col", i === 1 && "md:mt-24"]}>
            <Plate plate={modelPlates[i]} ratio="aspect-[4/3]" sizes="(min-width: 48rem) 50vw, 100vw" />
            <h3 class="text-display-lg mt-8 text-fg" data-fx="lines">{m.title}</h3>
            <p class="text-lede mt-4 text-fg">{m.lead}</p>
            <ul class="mt-6 border-t border-line" data-fx="stagger">
              {m.points.map((p) => (
                <li class="border-b border-line py-4 leading-relaxed text-muted">{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Interlude plate={interlude} decorative>We inspect first, then put real numbers in <em>writing.</em></Interlude>

  <Section id="promise" aria-label="No promised returns" spacing="sm">
    <p class="text-lede max-w-3xl text-fg">
      We do not advertise guaranteed returns or percentages. Anyone who promises a fixed profit before seeing your car is guessing. We
      inspect first, then put real numbers in writing.
    </p>
  </Section>

  <!-- Responsibilities -->
  <Section id="responsibilities" labelledby="resp-title" divider>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <h2 id="resp-title" class="text-display-lg text-fg" data-fx="lines">Who looks after what</h2>
        <p class="text-lede mt-6 text-muted" data-fx="fade">
          The usual split between you and us. Items marked "agreed per car" depend on the car and the earning model, and are settled in
          writing before the car joins the fleet.
        </p>
      </div>
      <div class="overflow-x-auto border-t border-line" role="region" aria-label="Who looks after what, scrollable table" tabindex="0">
        <table class="w-full min-w-[32rem] border-collapse text-left">
          <caption class="sr-only">Typical responsibilities for an attached car</caption>
          <thead>
            <tr class="border-b border-line">
              <th scope="col" class="label py-4 pr-5 text-muted">Item</th>
              <th scope="col" class="label py-4 pl-5 text-muted">Usually handled by</th>
            </tr>
          </thead>
          <tbody>
            {
              responsibilities.map((r) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-4 pr-5 font-normal text-fg">{r.item}</th>
                  <td class:list={["py-4 pl-5", r.who === "Us" ? "text-accent-fg" : "text-muted"]}>{r.who}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <!-- Documents + cars we look for -->
  <Section id="documents" labelledby="docs-title" divider>
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <h2 id="docs-title" class="text-display-lg text-fg" data-fx="lines">Documents we need</h2>
        <p class="mt-5 text-muted">Bring the originals to the inspection. We keep copies only for the agreement.</p>
        <ul class="mt-8 border-t border-line" data-fx="stagger" data-stagger="0.05">
          {
            documents.map((d) => (
              <li class="flex flex-col gap-1 border-b border-line py-4">
                <span class="text-fg">{d.text}</span>
                {d.note && <span class="text-sm text-muted">{d.note}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-display-lg text-fg" data-fx="lines">Cars we are looking for</h2>
        <p class="mt-5 max-w-[56ch] leading-relaxed text-muted">
          Clean, well maintained cars of the kinds our customers ask for, with clear papers and no major accident history. Recent model
          years in popular colours rent best, especially white, silver and black for weddings and corporate work.
        </p>
        <ul class="mt-8 border-t border-line">
          {
            categories.map((c) => (
              <li class="border-b border-line">
                <a href={urls.category(c.slug)} class="block py-4 text-display-sm text-fg transition-[color,transform] duration-700 ease-(--ease-out) hover:translate-x-2 hover:text-accent-fg" data-cursor="View">
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm text-muted">
          See the <a href={urls.cars()} class="link-draw text-accent-fg">current fleet</a> for the models we rent
          today.
        </p>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="partner-faq" labelledby="partner-faq-title" divider>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <SectionHeading id="partner-faq-title" title="Questions car owners ask" />
      <FaqList faqs={faqs} exclusive id="faq-partner" />
    </div>
  </Section>

  <!-- Enquiry CTA -->
  <section data-theme="dark" aria-labelledby="enquire-title" class="relative isolate flex min-h-[80svh] items-end overflow-hidden border-t border-line" data-fab-hide>
    {
      closing && (
        <div class="absolute inset-0 -z-10" aria-hidden="true">
          <img src={closing.img.src} srcset={closing.img.srcset || undefined} sizes="100vw" width={closing.img.width} height={closing.img.height} alt="" loading="lazy" decoding="async" class="size-full object-cover" style={closing.position ? `object-position:${closing.position}` : undefined} data-fx="kenburns" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,var(--bg)_0%,rgb(7_7_8/0.2)_40%,rgb(7_7_8/0.85)_85%,var(--bg)_100%),linear-gradient(90deg,rgb(7_7_8/0.55)_0%,transparent_60%)]"></div>
        </div>
      )
    }
    <div class="container-site grid items-end gap-10 pt-section pb-16 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div>
        <h2 id="enquire-title" class="text-display-xl text-fg" data-fx="lines">
          Gari khari hai? <em class="text-accent">Let it earn.</em>
        </h2>
        <p class="text-lede mt-6 max-w-xl text-fg/80">
          Send the make, model, year and a few photos. We reply with a time to inspect the car, and no obligation until you sign.
        </p>
        {closing?.caption && <p class="mt-6 text-xs text-fg/60">{closing.caption}</p>}
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <Button href={partnerWhatsapp} size="lg" icon="simple-icons:whatsapp" external>{site.cta.whatsapp.label}</Button>
        <Button href={partnerEmail} variant="secondary" size="lg" icon="ph:envelope-simple">Email us</Button>
      </div>
    </div>
  </section>
</PageLayout>
