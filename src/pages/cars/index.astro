---
/**
 * /cars/ hub: "Cars for rent in Lahore". Every model from the catalog (filterable by type and
 * service), trip-to-car advice, the type index, area links and an ItemList of model pages.
 */
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import JsonLd from "@/components/JsonLd.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CategoryIndex from "@/components/fleet/CategoryIndex.astro";
import FleetBrowser from "@/components/fleet/FleetBrowser.astro";
import PriceBand from "@/components/fleet/PriceBand.astro";
import TripMatcher from "@/components/fleet/TripMatcher.astro";
import { CITY_DAY_HOURS, assertNoFleetSlugCollisions, carName, fitText, joinAnd, lowest, softLower } from "@/components/fleet/fleet-data";
import { itemListSchema } from "@/components/fleet/fleet-schema";
import { afterCarList, pageVisuals } from "@/components/fleet/model-visual";
import Interlude from "@/components/services/Interlude.astro";
import { site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { getCatalogMeta, getCategories, getModels } from "@/lib/catalog";
import { heroFor, scene, still } from "@/lib/media";
import { formatPKR } from "@/lib/format";
import { whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const [models, categories, allCategories, catalogMeta] = await Promise.all([
  getModels(),
  getCategories(),
  getCategories({ includeEmpty: true }),
  getCatalogMeta(),
]);
assertNoFleetSlugCollisions(models, allCategories);

const fleetFrom = lowest(models, (m) => m.rates.fromPrice);
const wdFrom = lowest(models, (m) => m.rates.withDriver?.daily);
const sdFrom = lowest(models, (m) => m.rates.selfDrive?.daily);
const monthlyFrom = lowest(models, (m) => {
  const v = Math.min(m.rates.selfDrive?.monthly ?? Infinity, m.rates.withDriver?.monthly ?? Infinity);
  return Number.isFinite(v) ? v : null;
});
const minSeats = Math.min(...models.map((m) => m.seats));
const maxSeats = Math.max(...models.map((m) => m.seats));

const typeNames = categories.map((c) => softLower(c.name));
const title = fitText(
  ["Cars for Rent in Lahore: Sedans, SUVs, Vans and Wedding Cars", "Cars for Rent in Lahore with Driver or Self Drive", "Cars for Rent in Lahore"],
  60,
);
const description = fitText(
  [
    `Every car we rent in Lahore with real daily rates: ${joinAnd(typeNames)}. With driver or self drive${fleetFrom ? `, from ${formatPKR(fleetFrom)}/day` : ""}.`,
    `Every car we rent in Lahore with real daily rates. Sedans, SUVs, vans and wedding cars, with driver or self drive${fleetFrom ? `, from ${formatPKR(fleetFrom)}/day` : ""}.`,
  ],
  155,
);

const glance = [
  wdFrom ? { label: "With driver", value: formatPKR(wdFrom), note: `from, ${CITY_DAY_HOURS} hour day` } : null,
  sdFrom ? { label: "Self drive", value: formatPKR(sdFrom), note: "from, per day" } : null,
  monthlyFrom ? { label: "Monthly", value: formatPKR(monthlyFrom), note: "from, per month" } : null,
  { label: "Seats", value: minSeats === maxSeats ? String(maxSeats) : `${minSeats} to ${maxSeats}`, note: "per car" },
].filter((g): g is { label: string; value: string; note: string } => g !== null);

// Scenes only: every car already has its plate in the gallery above.
// The interlude follows the fleet list, so it shows no vehicle (afterCarList).
const interludes = afterCarList(pageVisuals([scene("garage"), scene("lahore-night"), still("trails")], [], [heroFor(Astro.url.pathname)]));

const listSchema = itemListSchema({
  name: "Cars for rent in Lahore",
  url: urls.cars(),
  items: models.map((m) => ({ name: carName(m), url: urls.car(m.slug) })),
});
---

<PageLayout
  title={title}
  description={description}
  h1="Cars for rent in Lahore"
  intro="Every car in our fleet with its real daily rate. Book with a driver who knows Lahore, or drive yourself with a quick handover in Lahore Cantt."
  crumbs={[{ label: "Fleet" }]}
>
  <JsonLd slot="jsonld" data={listSchema} />

  <div slot="actions" class="flex flex-wrap gap-3" data-fab-hide>
    <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl()} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </div>

  <Section id="fleet" labelledby="fleet-title" spacing="sm" class="pt-10! md:pt-14!">
    <h2 id="fleet-title" class="sr-only">All cars for rent</h2>
    <FleetBrowser models={models} categories={categories} />

    <SampleFleetNote class="mt-10" />
  </Section>

  <Container class="pb-[calc(var(--section-space)*0.55)]">
    <PriceBand items={glance} />
    <div class="mt-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-12">
      <p class="max-w-3xl text-sm leading-relaxed text-muted">
        {catalogMeta.sample ? "" : "Prices come straight from our booking system. "}With a driver, a day is up to {CITY_DAY_HOURS} hours within Lahore. Fuel, motorway
        tolls and parking are extra, and the final price is confirmed on WhatsApp before you book.
      </p>
      <div class="flex shrink-0 flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={urls.rates()} class="text-accent-fg underline underline-offset-4">Rent a car rates in Lahore</a>
        <a href={urls.rates()} class="text-accent-fg underline underline-offset-4">See every rate</a>
      </div>
    </div>
  </Container>

  <Interlude visual={interludes[0]} />

  <Section id="which-car" labelledby="which-car-title">
    <SectionHeading
      id="which-car-title"
      eyebrow="Not sure which car?"
      title="Which car for which trip"
      intro="Practical picks for the trips Lahore families book most, from a quick airport run to a week in the north."
    />
    <TripMatcher models={models} class="mt-12" />
  </Section>

  <Section id="types" labelledby="types-title" class="pt-0!">
    <SectionHeading id="types-title" title="Browse by type" intro="Each type has its own page with rates, tips for Lahore and answers to common questions." />
    <CategoryIndex categories={categories} models={models} class="mt-12" />
  </Section>

  <Section id="areas" labelledby="areas-title" spacing="sm" class="pt-0!">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div>
        <h2 id="areas-title" class="text-display-md text-fg" data-fx="lines">Pickup across Lahore</h2>
        <p class="mt-4 max-w-md text-muted">
          Our base is in Lahore Cantt, so Cantt, DHA and the airport are quickest to reach. We also pick up from homes, offices and hotels across the city.
        </p>
      </div>
      <ul class="grid gap-x-10 border-t border-line sm:grid-cols-2">
        {
          site.areasServed.map((a) => (
            <li class="border-b border-line">
              <a href={urls.area(a.slug)} class="block py-3.5 text-[0.9375rem] text-fg transition-colors duration-500 hover:text-accent-fg">
                Rent a car in {a.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</PageLayout>
