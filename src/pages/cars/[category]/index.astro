---
/**
 * /cars/<category>/ (e.g. /cars/suv/): one page per catalog category that has models.
 * Shares the /cars/<slug>/ URL space with model pages; getStaticPaths in both routes asserts that
 * no model slug equals a category slug (assertNoFleetSlugCollisions).
 */
import type { GetStaticPaths } from "astro";
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import FaqList from "@/components/FaqList.astro";
import JsonLd from "@/components/JsonLd.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import GalleryList from "@/components/fleet/GalleryList.astro";
import PriceBand from "@/components/fleet/PriceBand.astro";
import RateCards from "@/components/fleet/RateCards.astro";
import RatesTable from "@/components/fleet/RatesTable.astro";
import { categoryContent, categoryLinkText } from "@/components/fleet/category-copy";
import { CITY_DAY_HOURS, assertNoFleetSlugCollisions, carName, goesOutstation, lowest, seatRange, singularName, softLower } from "@/components/fleet/fleet-data";
import { itemListSchema } from "@/components/fleet/fleet-schema";
import { afterCarList, pageVisuals } from "@/components/fleet/model-visual";
import Interlude from "@/components/services/Interlude.astro";
import { getRoute, getService, site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { getCategories, getModels, type CatalogCategory } from "@/lib/catalog";
import { whatsappUrl } from "@/lib/links";
import { heroFor, road, scene, still, type Img } from "@/lib/media";
import { formatPKR } from "@/lib/format";
import { urls } from "@/lib/urls";

export const getStaticPaths = (async () => {
  const [models, categories, allCategories] = await Promise.all([getModels(), getCategories(), getCategories({ includeEmpty: true })]);
  assertNoFleetSlugCollisions(models, allCategories);
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}) satisfies GetStaticPaths;

interface Props {
  category: CatalogCategory;
}

const { category } = Astro.props;
const [allModels, categories] = await Promise.all([getModels(), getCategories()]);
const models = allModels.filter((m) => m.category === category.slug);
const content = categoryContent(category, models, allModels);

const nounLower = softLower(content.noun);

const from = lowest(models, (m) => m.rates.fromPrice);
const hasDriver = models.some((m) => m.rates.withDriver);
const hasSelf = models.some((m) => m.rates.selfDrive);
const facts = [
  { label: `Lowest daily rate for ${nounLower}`, value: from !== null ? formatPKR(from) : "On request", text: from === null },
  { label: "Models", value: String(models.length), text: true },
  { label: "Seats", value: seatRange(models) ?? "", text: true },
  { label: "Service", value: hasDriver && hasSelf ? "Driver or self drive" : hasDriver ? "With driver" : "Self drive", text: true },
  { label: "Outstation", value: models.some(goesOutstation) ? "Available" : "Within Lahore", text: true },
];

// Interlude: a picture that fits this type, never the layout's hero (heroFor). It comes right after the list of
// cars, so it shows no vehicle (afterCarList): a car there would read as one more model in the list.
const CATEGORY_SCENES: Record<string, (Img | undefined)[]> = {
  luxury: [scene("contact"), scene("luxury"), scene("cabin")],
  wedding: [scene("badshahi"), scene("wedding")],
  van: [road("motorway"), scene("vans")],
  coaster: [road("motorway"), scene("vans")],
  suv: [road("murree"), road("motorway"), scene("garage")],
  sedan: [scene("lahore-night"), scene("garage")],
  hatchback: [scene("lahore-night")],
};
// The no-car stills close the list, so a type with no picture of its own still gets one here.
const interludes = afterCarList(
  pageVisuals([...(CATEGORY_SCENES[category.slug] ?? [scene("garage")]), still("trails"), still("terrain")], [], [heroFor(Astro.url.pathname)]),
);

const services = content.services.map((slug) => getService(slug)).filter((s) => s !== undefined);
const routes = content.routes.map((slug) => getRoute(slug)).filter((r) => r !== undefined);
const compare = content.compare
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter((c): c is CatalogCategory => c !== undefined && c.slug !== category.slug);
const otherTypes = categories.filter((c) => c.slug !== category.slug && !compare.some((x) => x.slug === c.slug));

const whatsappMessage = `Assalam o Alaikum! I'm looking for one of your ${nounLower} in Lahore.`;
const listSchema = itemListSchema({
  name: content.h1,
  url: urls.category(category.slug),
  items: models.map((m) => ({ name: carName(m), url: urls.car(m.slug) })),
});
const fewModels = models.length <= 2;
---

<PageLayout
  title={content.metaTitle}
  description={content.metaDescription}
  h1={content.h1}
  intro={content.intro}
  crumbs={[{ label: "Fleet", href: urls.cars() }, { label: category.name }]}
  whatsappMessage={whatsappMessage}
>
  <JsonLd slot="jsonld" data={listSchema} />

  <div slot="actions" class="flex flex-wrap gap-3" data-fab-hide>
    <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl(whatsappMessage)} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </div>

  <Container class="pt-10 md:pt-14">
    <PriceBand items={facts} />
  </Container>

  <Section id="models" labelledby="models-title" spacing="sm">
    <SectionHeading id="models-title" title={`Our ${nounLower}`} intro={category.description || undefined} />
    <GalleryList models={models} detailed={fewModels} class="mt-14 md:mt-20" />
    <SampleFleetNote class="mt-10" />
  </Section>

  <Interlude visual={interludes[0]} />

  <Section id="guide" labelledby="guide-title">
    <h2 id="guide-title" class="text-display-lg max-w-[20ch] text-fg" data-fx="lines">{content.guideTitle}</h2>
    <div class="guide-columns mt-10 text-[1.0625rem] leading-relaxed text-muted md:mt-14">
      {content.guide.map((p) => <p>{p}</p>)}
    </div>
    {
      compare.length > 0 && (
        <div class="mt-12 border-t border-line pt-6">
          <p class="label text-muted">Compare with</p>
          <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
            {compare.map((c) => (
              <li>
                <a href={urls.category(c.slug)} class="text-[1.0625rem] text-fg underline decoration-line-strong underline-offset-4 transition-colors duration-500 hover:text-accent-fg">
                  {categoryLinkText(c)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Section>

  <Section id="rates" labelledby="rates-title" class="pt-0!">
    <SectionHeading id="rates-title" title={`${singularName(content.noun)} rates in Lahore`}>
      <p class="text-lede max-w-2xl text-muted">
        Daily rates for each car, straight from our booking system. With a driver, a city day is up to {CITY_DAY_HOURS} hours within Lahore. Open a
        car for overtime, monthly and night stay details.
      </p>
      <a slot="actions" href={urls.rates()} class="link-draw text-sm text-fg">All rates</a>
    </SectionHeading>
    <RatesTable mode="summary" groups={[{ category, models }]} caption={`${singularName(content.noun)} rates in Lahore`} hideGroupHeaders class="mt-12 max-lg:hidden" />
    <RateCards groups={[{ category, models }]} hideGroupHeaders class="mt-10 lg:hidden" />
  </Section>

  <Section id="plan" labelledby="plan-title" class="pt-0!">
    <SectionHeading id="plan-title" title="Plan your trip" intro={`Services and routes people often book with our ${nounLower}.`} />
    <div class:list={["mt-12 grid gap-12", routes.length > 0 && "lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-20"]}>
      <ul class="border-t border-line">
        {
          services.map((s) => (
            <li class="border-b border-line">
              <a href={urls.service(s.slug)} class="group block py-5">
                <span class="block text-[1.0625rem] font-medium text-fg transition-colors duration-500 group-hover:text-accent-fg">{s.name} in Lahore</span>{" "}
                <span class="mt-1 block text-sm text-muted">{s.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        routes.length > 0 && (
          <div>
            <h3 class="label text-muted">Popular routes</h3>
            <ul class="mt-4 border-t border-line">
              {routes.map((r) => (
                <li class="border-b border-line">
                  <a href={urls.route(r.slug)} class="block py-4 text-[0.9375rem] text-fg transition-colors duration-500 hover:text-accent-fg">
                    Lahore to {r.city} by car
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Section>

  <Section id="faq" labelledby="faq-title" class="pt-0!">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <SectionHeading id="faq-title" title={`${content.noun} on rent: common questions`} size="md" />
      </div>
      <div>
        <FaqList faqs={content.faqs} exclusive id={`faq-${category.slug}`} />
        {
          otherTypes.length > 0 && (
            <nav aria-label="Other car types" class="mt-12">
              <p class="label text-muted">Other car types</p>
              <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
                {otherTypes.map((c) => (
                  <li>
                    <a href={urls.category(c.slug)} class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg">
                      {categoryLinkText(c)}
                    </a>
                  </li>
                ))}
                <li>
                  <a href={urls.cars()} class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg">
                    All cars for rent in Lahore
                  </a>
                </li>
              </ul>
            </nav>
          )
        }
      </div>
    </div>
  </Section>
</PageLayout>

<style>
  .guide-columns > p + p {
    margin-top: 1.25em;
  }
  @media (width >= 64rem) {
    .guide-columns {
      column-count: 2;
      column-gap: 4rem;
    }
    .guide-columns > p {
      break-inside: avoid;
    }
  }
</style>
