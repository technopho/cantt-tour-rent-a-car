---
/**
 * /about/: an editorial story told in images and large statements: who we are, what we stand for, how the
 * cars are looked after, how the team works, the fleet today (catalog) and where we work. No invented history, years or numbers: facts come
 * from site.ts and the catalog only.
 */
import Button from "@/components/Button.astro";
import JsonLd from "@/components/JsonLd.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Interlude from "@/components/local/Interlude.astro";
import Plate from "@/components/local/Plate.astro";
import { fleetPlate, picker, scenePlate, trails } from "@/components/local/plates";
import { companyPageSchema } from "@/components/services/page-schema";
import { formatOpeningHours, primaryPhone, site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { cheapestFrom, getCategories, getModels } from "@/lib/catalog";
import { formatPKR } from "@/lib/format";
import { telUrl, whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const [models, categories] = await Promise.all([getModels(), getCategories()]);
const fleet = categories
  .map((c) => {
    const list = models.filter((m) => m.category === c.slug);
    return { ...c, count: list.length, from: cheapestFrom(list) };
  })
  .filter((c) => c.count > 0);

const pageTitle = "About Us, Car Rental Based in Lahore Cantt";
const pageDescription =
  "Cantt Rent a Car is a car rental based in Lahore Cantt. Cars with drivers and self drive across Lahore, verified drivers, maintained cars, clear prices.";

// Lahore at night opens the page (a real photo, credited), the Badshahi Mosque stands beside "who we are", each
// promise gets the scene it describes, and the night road closes the story. Captions come with each plate.
const pick = picker("/about/");
const hero = pick(scenePlate("lahore-night", "garage"), fleetPlate("mercedes-s-class")) ?? trails();
const whoPlate = pick(scenePlate("badshahi", "garage"), fleetPlate("toyota-land-cruiser"));
const promisePlates = [
  pick(scenePlate("airport"), fleetPlate("toyota-prado")),
  pick(scenePlate("chauffeur"), fleetPlate("toyota-fortuner")),
  pick(scenePlate("corporate"), fleetPlate("honda-civic")),
];
const carePlate = pick(scenePlate("cabin", "selfdrive"), fleetPlate("toyota-corolla"));
const fleetPlateSide = pick(scenePlate("luxury"), fleetPlate("toyota-land-cruiser"), fleetPlate("toyota-fortuner"));
const closingPlate = pick(trails());

const promises = [
  {
    no: "01",
    title: "On time",
    text: "A car that arrives late ruins the day it was meant to make easier. We confirm the pickup the day before, the driver leaves with time to spare, and he messages you when he is outside. If something goes wrong on our side, you hear it from us first, with a plan.",
    how: ["Pickup confirmed a day ahead", "Driver details shared before the trip", "Flights tracked for airport pickups"],
  },
  {
    no: "02",
    title: "Verified drivers",
    text: "Every driver we send has had his CNIC and driving licence checked and his references taken, and we check his driving before he carries a customer. He knows Lahore, keeps to lanes and speed limits, and treats your family the way he would want his own treated.",
    how: ["CNIC and licence checked", "References taken", "Driving checked before the first customer trip"],
  },
  {
    no: "03",
    title: "Clear pricing",
    text: "The rates on this site come from the same rate list our team quotes from. Before you book, we tell you what is included, what is not, and how fuel, tolls, overtime and deposits work. The number you agreed is the number you pay.",
    how: ["Rates published for every car", "A written quote on WhatsApp", "Deposit terms in writing"],
  },
];

const care = [
  {
    title: "Before every booking",
    items: [
      "Washed outside, vacuumed inside",
      "Tyres and tyre pressure checked",
      "AC, lights, horn and wipers tested",
      "Engine oil, coolant and brake fluid levels",
      "Registration papers and token tax receipt in the car",
    ],
  },
  {
    title: "On schedule",
    items: [
      "Oil and filters changed by kilometres, not guesswork",
      "Brakes, battery and suspension checked at every service",
      "Wheel alignment and balancing",
      "Any warning light investigated before the next booking",
    ],
  },
  {
    title: "With the seasons",
    items: [
      "AC gas and condenser checked before the June heat",
      "Wipers, fog lights and tyres before the winter fog on the motorways",
      "Electricals and brakes checked after monsoon rain and flooded underpasses",
    ],
  },
];

const team = [
  {
    role: "Drivers",
    text: "The people you meet. Chosen for patience and road sense as much as driving skill, and briefed before every trip on the address, the timings and anything special about your booking.",
  },
  {
    role: "Booking team",
    text: "The people you message. They quote, confirm, share driver details and stay reachable on WhatsApp while your trip is running, so you are never chasing a reply.",
  },
  {
    role: "Fleet care",
    text: "The people you never see. They prepare each car before it goes out, book the services, and take a car off the road the moment something is not right.",
  },
];
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  h1="On time, from Lahore Cantt"
  intro="Cars with verified drivers and self drive across Lahore, from our Cantt base, at prices you agree upfront."
  crumbs={[{ label: "About us" }]}
  heroImage={hero.img}
  heroCaption={hero.caption}
  heroPosition={hero.position}
>
  <JsonLd slot="jsonld" data={companyPageSchema("AboutPage", { url: urls.about(), name: pageTitle, description: pageDescription })} />
  <div slot="actions" class="grid w-full gap-3 sm:flex sm:w-auto sm:flex-wrap" data-fab-hide>
    <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl()} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </div>


  <!-- Who we are -->
  <Section id="who" labelledby="who-title">
    <h2 id="who-title" class="eyebrow">Who we are</h2>
    <p class="text-display-xl mt-8 max-w-[17ch] text-fg" data-fx="lines">The name is a promise as much as an <em>address.</em></p>
    <div class="mt-16 grid gap-12 md:mt-24 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:items-end lg:gap-24">
      <Plate plate={whoPlate} ratio="aspect-[4/5] md:aspect-[5/4]" sizes="(min-width: 48rem) 55vw, 100vw" />
      <div class="flex max-w-[60ch] flex-col gap-6 text-[1.0625rem] leading-[1.75] text-fg/85" data-fx="stagger">
        <p>
          {site.name} is a car rental business based in {site.address.area}. We rent sedans, SUVs, vans, coasters and wedding cars, with a
          driver or for self drive, to families, visitors and companies across Lahore, and for trips out of the city.
        </p>
        <p>
          Cantt is where Lahore keeps time: wide roads, ordered traffic, gates that open at
          the hour they say. That is the standard we bring to every booking, whether it is an early morning airport pickup in DHA or a
          baraat convoy through Gulberg on a December evening.
        </p>
        <p>
          When you book with us, you deal with one team from the first message to the moment the car is back. No call centre, no
          middleman, and no surprises in the final bill.
        </p>
      </div>
    </div>
  </Section>

  <!-- What we stand for -->
  <div class="overflow-hidden border-y border-line py-6" aria-hidden="true">
    <div class="flex" data-fx="marquee" data-speed="40">
      {promises.map((p) => <span class="text-display-md whitespace-nowrap pr-16 text-fg/45">{p.title}</span>)}
    </div>
  </div>

  <Section id="values" labelledby="values-title">
    <SectionHeading id="values-title" eyebrow="What we stand for" title="Three things we will not compromise on" />
    <ol class="mt-20 flex flex-col gap-24 md:mt-28 md:gap-40">
      {
        promises.map((p, i) => (
          <li class="grid items-center gap-10 md:grid-cols-2 lg:gap-24">
            <Plate plate={promisePlates[i]} ratio="aspect-[4/5] md:aspect-[4/3]" sizes="(min-width: 48rem) 50vw, 100vw" class={i % 2 === 1 ? "md:order-2" : undefined} />
            <div>
              <p class="label text-accent-fg tabular" aria-hidden="true">{p.no}</p>
              <h3 class="text-display-lg mt-5 text-fg" data-fx="lines">{p.title}</h3>
              <p class="mt-6 max-w-[56ch] text-[1.0625rem] leading-[1.75] text-muted" data-fx="fade">{p.text}</p>
              <ul class="mt-8 border-t border-line" data-fx="stagger">
                {p.how.map((h) => (
                  <li class="border-b border-line py-3.5 text-[0.9375rem] text-fg">{h}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Interlude plate={carePlate}>A clean car is the minimum. A car that will not let you down is the <em>job.</em></Interlude>

  <!-- Car care -->
  <Section id="care" labelledby="care-title">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-24">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <h2 id="care-title" class="text-display-lg text-fg" data-fx="lines">How we look after the cars</h2>
        <p class="text-lede mt-6 text-muted" data-fx="fade">
          Lahore is hard on cars: summer heat above 40 degrees, winter fog, monsoon water in the underpasses and stop-start traffic
          all year.
        </p>
        <p class="mt-5 text-muted" data-fx="fade">
          Every car is photographed at handover and return, so its condition is on record, and any car with a fault stays off the road
          until it is fixed.
        </p>
      </div>
      <div class="flex flex-col gap-14">
        {
          care.map((c, i) => (
            <div>
              <h3 class="flex items-baseline gap-5 border-b border-line pb-5 text-display-md text-fg">
                <span class="font-sans text-sm text-accent-fg tabular" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {c.title}
              </h3>
              <ul class="grid gap-x-10 md:grid-cols-2" data-fx="stagger" data-stagger="0.05">
                {c.items.map((item) => (
                  <li class="border-b border-line py-4 text-[0.9375rem] leading-relaxed text-muted">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Team -->
  <Section id="team" labelledby="team-title" divider>
    <SectionHeading
      id="team-title"
      title="The team behind the wheel"
      intro="A team with clear jobs. Everyone knows who is responsible for your booking, and so do you."
    />
    <dl class="mt-16 border-t border-line">
      {
        team.map((t) => (
          <div class="grid gap-4 border-b border-line py-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-baseline md:gap-14 lg:py-14">
            <dt class="text-display-lg text-fg" data-fx="lines">{t.role}</dt>
            <dd class="max-w-[56ch] text-[1.0625rem] leading-[1.75] text-muted" data-fx="fade">{t.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Fleet today, from the catalog -->
  <Section id="fleet" labelledby="fleet-title" divider>
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-24">
      <div class="flex flex-col gap-10">
        <SectionHeading id="fleet-title" title="The fleet today" intro="Every category we rent, with current starting prices from our rate list." />
        <Plate plate={fleetPlateSide} ratio="aspect-[3/2]" sizes="(min-width: 64rem) 50vw, 100vw" />
        <div class="flex flex-wrap items-center gap-5">
          <Button href={urls.cars()} variant="secondary" iconRight="ph:arrow-right">See every car</Button>
          <SampleFleetNote />
        </div>
      </div>
      <ul class="self-start border-t border-line">
        {
          fleet.map((c) => (
            <li class="border-b border-line">
              <a href={urls.category(c.slug)} class="group flex flex-col gap-2 py-7" data-cursor="View">
                <span class="text-display-md text-fg transition-[color,transform] duration-700 ease-(--ease-out) group-hover:translate-x-2 group-hover:text-accent-fg">{c.name}</span>
                <span class="text-sm text-muted">
                  {c.count} {c.count === 1 ? "model" : "models"}
                  {typeof c.from === "number" && (
                    <>
                      , from <span class="text-fg tabular-nums">{formatPKR(c.from)}</span>/day
                    </>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Interlude plate={closingPlate} height="mid" />

  <!-- Where we work -->
  <Section id="where" labelledby="where-title">
    <h2 id="where-title" class="text-display-xl text-fg" data-fx="lines">Where we work</h2>
    <p class="text-lede mt-6 max-w-2xl text-muted" data-fx="fade">
      From {site.address.area} to every part of Lahore, and out on the motorways to Islamabad, the north and the cities of Punjab.
    </p>

    <div class="mt-16 grid gap-16 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-24">
      <div class="flex flex-col gap-12">
        <ul class="grid border-t border-line sm:grid-cols-2 sm:gap-x-10">
          {
            site.areasServed.map((a) => (
              <li class="border-b border-line">
                <a href={urls.area(a.slug)} class="block py-4 text-lg text-fg transition-colors duration-500 hover:text-accent-fg">Rent a car in {a.name}</a>
              </li>
            ))
          }
        </ul>
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[0.9375rem]">
          {
            site.routes.map((r) => (
              <li>
                <a href={urls.route(r.slug)} class="link-draw text-muted transition-colors duration-500 hover:text-fg">Lahore to {r.city}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="self-start border-t border-accent pt-6">
        <p class="label text-muted">Our base</p>
        <p class="text-display-md mt-4 text-fg">{site.address.area}, {site.address.city}</p>
        <dl class="mt-8 flex flex-col gap-5">
          <div>
            <dt class="label text-muted">Opening hours</dt>
            <dd class="mt-2 text-fg">{formatOpeningHours().map((line) => <span class="block">{line}</span>)}</dd>
          </div>
          <div>
            <dt class="label text-muted">Phone</dt>
            <dd class="mt-2"><a href={telUrl()} class="link-draw text-lg text-fg tabular-nums">{primaryPhone.display}</a></dd>
          </div>
          <div>
            <dt class="label text-muted">Service area</dt>
            <dd class="mt-2 text-fg">All of Lahore, and outstation trips across Pakistan</dd>
          </div>
        </dl>
        <p class="mt-8 text-sm leading-relaxed text-muted">
          Want to work with us instead? Car owners can <a href={urls.partner()} class="link-draw text-accent-fg">attach their car with us</a>, and our <a href={urls.contact()} class="link-draw text-accent-fg">contact page</a> has every way to reach the team.
        </p>
      </div>
    </div>
  </Section>
</PageLayout>
