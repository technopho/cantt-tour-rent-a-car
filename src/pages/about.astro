---
/**
 * /about/: who we are, what we stand for, how the cars are looked after, how the team works,
 * the fleet today (catalog) and where we work. No invented history, years or numbers: facts come
 * from site.ts and the catalog only.
 */
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import JsonLd from "@/components/JsonLd.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { companyPageSchema } from "@/components/services/page-schema";
import { formatOpeningHours, primaryPhone, site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { cheapestFrom, getCategories, getModels } from "@/lib/catalog";
import { formatPKR } from "@/lib/format";
import { telUrl, whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const [models, categories] = await Promise.all([getModels(), getCategories()]);
const fleet = categories
  .map((c) => {
    const list = models.filter((m) => m.category === c.slug);
    return { ...c, count: list.length, from: cheapestFrom(list) };
  })
  .filter((c) => c.count > 0);

const pageTitle = "About Us, Car Rental Based in Lahore Cantt";
const pageDescription =
  "Cantt Rent a Car is a car rental based in Lahore Cantt. Cars with drivers and self drive across Lahore, verified drivers, maintained cars, clear prices.";

const promises = [
  {
    no: "01",
    title: "On time",
    text: "A car that arrives late ruins the day it was meant to make easier. We confirm the pickup the day before, the driver leaves with time to spare, and he messages you when he is outside. If something goes wrong on our side, you hear it from us first, with a plan.",
    how: ["Pickup confirmed a day ahead", "Driver details shared before the trip", "Flights tracked for airport pickups"],
  },
  {
    no: "02",
    title: "Verified drivers",
    text: "Every driver we send has had his CNIC and driving licence checked and his references taken, and we check his driving before he carries a customer. He knows Lahore, keeps to lanes and speed limits, and treats your family the way he would want his own treated.",
    how: ["CNIC and licence checked", "References taken", "Driving checked before the first customer trip"],
  },
  {
    no: "03",
    title: "Clear pricing",
    text: "The rates on this site come from the same rate list our team quotes from. Before you book, we tell you what is included, what is not, and how fuel, tolls, overtime and deposits work. The number you agreed is the number you pay.",
    how: ["Rates published for every car", "A written quote on WhatsApp", "Deposit terms in writing"],
  },
];

const care = [
  {
    title: "Before every booking",
    icon: "ph:list-checks",
    items: [
      "Washed outside, vacuumed inside",
      "Tyres and tyre pressure checked",
      "AC, lights, horn and wipers tested",
      "Engine oil, coolant and brake fluid levels",
      "Registration papers and token tax receipt in the car",
    ],
  },
  {
    title: "On schedule",
    icon: "ph:wrench",
    items: [
      "Oil and filters changed by kilometres, not guesswork",
      "Brakes, battery and suspension checked at every service",
      "Wheel alignment and balancing",
      "Any warning light investigated before the next booking",
    ],
  },
  {
    title: "With the seasons",
    icon: "ph:sun-horizon",
    items: [
      "AC gas and condenser checked before the June heat",
      "Wipers, fog lights and tyres before the winter fog on the motorways",
      "Electricals and brakes checked after monsoon rain and flooded underpasses",
    ],
  },
];

const team = [
  {
    role: "Drivers",
    text: "The people you meet. Chosen for patience and road sense as much as driving skill, and briefed before every trip on the address, the timings and anything special about your booking.",
  },
  {
    role: "Booking team",
    text: "The people you message. They quote, confirm, share driver details and stay reachable on WhatsApp while your trip is running, so you are never chasing a reply.",
  },
  {
    role: "Fleet care",
    text: "The people you never see. They prepare each car before it goes out, book the services, and take a car off the road the moment something is not right.",
  },
];
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  h1="On time, from Lahore Cantt"
  intro="Cars with verified drivers and self drive across Lahore, from our Cantt base, at prices you agree upfront."
  crumbs={[{ label: "About us" }]}
>
  <JsonLd slot="jsonld" data={companyPageSchema("AboutPage", { url: urls.about(), name: pageTitle, description: pageDescription })} />
  <div slot="actions" class="grid w-full gap-3 sm:flex sm:w-auto sm:flex-wrap" data-fab-hide>
    <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl()} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </div>

  <div slot="aside" class="rounded-card border border-line bg-surface/85 p-6 shadow-soft backdrop-blur-sm sm:p-7">
    <p class="text-sm font-medium text-muted">Our base</p>
    <p class="mt-2 font-display text-display-sm text-fg">{site.address.area}, {site.address.city}</p>
    <dl class="mt-6 flex flex-col gap-4 border-t border-line pt-6 text-sm">
      <div>
        <dt class="sr-only">Opening hours</dt>
        <dd class="flex gap-3 text-fg">
          <Icon name="ph:clock" size={18} class="mt-0.5 text-accent" />
          <span>{formatOpeningHours().map((line) => <span class="block">{line}</span>)}</span>
        </dd>
      </div>
      <div>
        <dt class="sr-only">Phone</dt>
        <dd class="flex gap-3">
          <Icon name="ph:phone" size={18} class="mt-0.5 text-accent" />
          <a href={telUrl()} class="font-semibold text-fg tabular-nums underline-offset-4 hover:underline">{primaryPhone.display}</a>
        </dd>
      </div>
      <div>
        <dt class="sr-only">Service area</dt>
        <dd class="flex gap-3 text-fg">
          <Icon name="ph:map-trifold" size={18} class="mt-0.5 text-accent" />
          <span>All of Lahore, and outstation trips across Pakistan</span>
        </dd>
      </div>
    </dl>
  </div>

  <!-- Who we are -->
  <Section id="who" labelledby="who-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-20">
      <h2 id="who-title" class="text-display-lg text-fg">Who we are</h2>
      <div class="prose-site max-w-none text-lede [&>*+*]:mt-6">
        <p>
          {site.name} is a car rental business based in {site.address.area}. We rent sedans, SUVs, vans, coasters and wedding cars, with a
          driver or for self drive, to families, visitors and companies across Lahore, and for trips out of the city.
        </p>
        <p>
          The name is a promise as much as an address. Cantt is where Lahore keeps time: wide roads, ordered traffic, gates that open at
          the hour they say. That is the standard we bring to every booking, whether it is an early morning airport pickup in DHA or a
          baraat convoy through Gulberg on a December evening.
        </p>
        <p>
          When you book with us, you deal with one team from the first message to the moment the car is back. No call centre, no
          middleman, and no surprises in the final bill.
        </p>
      </div>
    </div>
  </Section>

  <!-- What we stand for -->
  <Section id="values" labelledby="values-title" divider>
    <SectionHeading id="values-title" eyebrow="What we stand for" title="Three things we will not compromise on" />
    <ol class="mt-14 border-t border-line">
      {
        promises.map((p) => (
          <li class="grid gap-6 border-b border-line py-10 md:grid-cols-[7rem_minmax(0,1.4fr)_minmax(0,1fr)] md:gap-10 lg:py-14" data-reveal>
            <p class="promise-no font-display text-[clamp(3rem,2rem+3vw,4.5rem)] leading-none font-bold tracking-[-0.06em]" aria-hidden="true">
              {p.no}
            </p>
            <div>
              <h3 class="text-display-md text-fg">{p.title}</h3>
              <p class="mt-4 max-w-xl leading-relaxed text-muted">{p.text}</p>
            </div>
            <ul class="flex flex-col gap-3 self-center text-[0.9375rem]">
              {p.how.map((h) => (
                <li class="flex gap-3 text-fg">
                  <Icon name="ph:check" size={18} class="mt-0.5 text-accent" />
                  {h}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Car care -->
  <Section id="care" labelledby="care-title" divider>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <h2 id="care-title" class="text-display-lg text-fg">How we look after the cars</h2>
        <p class="text-lede mt-5 text-muted">
          Lahore is hard on cars: summer heat above 40 degrees, winter fog, monsoon water in the underpasses and stop-start traffic
          all year. A clean car is the minimum. A car that will not let you down is the job.
        </p>
        <p class="mt-5 text-muted">
          Every car is photographed at handover and return, so its condition is on record, and any car with a fault stays off the road
          until it is fixed.
        </p>
      </div>
      <div class="flex flex-col">
        {
          care.map((c) => (
            <div class="border-t border-line py-8 first:pt-0 first:border-t-0 lg:first:pt-2" data-reveal>
              <h3 class="flex items-center gap-3 text-display-sm text-fg">
                <span class="grid size-10 place-items-center rounded-full bg-accent-soft text-accent">
                  <Icon name={c.icon} size={20} />
                </span>
                {c.title}
              </h3>
              <ul class="mt-5 grid gap-x-8 gap-y-3 text-[0.9375rem] text-muted md:grid-cols-2">
                {c.items.map((item) => (
                  <li class="flex gap-3">
                    <Icon name="ph:check" size={18} class="mt-0.5 shrink-0 text-accent" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Team -->
  <Section id="team" labelledby="team-title" divider>
    <SectionHeading
      id="team-title"
      title="The team behind the wheel"
      intro="A team with clear jobs. Everyone knows who is responsible for your booking, and so do you."
    />
    <dl class="mt-12 border-t border-line">
      {
        team.map((t) => (
          <div class="grid gap-3 border-b border-line py-7 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-10">
            <dt class="font-display text-display-sm text-fg">{t.role}</dt>
            <dd class="max-w-2xl leading-relaxed text-muted">{t.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Fleet today, from the catalog -->
  <Section id="fleet" labelledby="fleet-title" divider>
    <SectionHeading id="fleet-title" title="The fleet today" intro="Every category we rent, with current starting prices from our rate list.">
      <Button slot="actions" href={urls.cars()} variant="secondary" iconRight="ph:arrow-right">See every car</Button>
    </SectionHeading>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      {
        fleet.map((c) => (
          <li class="bg-bg">
            <a href={urls.category(c.slug)} class="group flex h-full flex-col gap-2 p-6 transition-colors duration-300 hover:bg-surface">
              <span class="font-display text-display-sm text-fg">{c.name}</span>
              <span class="text-sm text-muted">
                {c.count} {c.count === 1 ? "model" : "models"}
                {typeof c.from === "number" && (
                  <>
                    , from <span class="font-semibold text-fg tabular-nums">{formatPKR(c.from)}</span>/day
                  </>
                )}
              </span>
              <Icon
                name="ph:arrow-right"
                size={18}
                class="mt-auto pt-2 text-muted transition-[color,transform] duration-300 group-hover:translate-x-1 group-hover:text-accent"
              />
            </a>
          </li>
        ))
      }
    </ul>
    <SampleFleetNote class="mt-8" />
  </Section>

  <!-- Where we work -->
  <Section id="where" labelledby="where-title" divider>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-20">
      <div>
        <h2 id="where-title" class="text-display-lg text-fg">Where we work</h2>
        <p class="text-lede mt-5 text-muted">
          From {site.address.area} to every part of Lahore, and out on the motorways to Islamabad, the north and the cities of Punjab.
        </p>
      </div>
      <div class="flex flex-col gap-10">
        <ul class="flex flex-wrap gap-2.5">
          {
            site.areasServed.map((a) => (
              <li>
                <a
                  href={urls.area(a.slug)}
                  class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 py-2.5 pr-4 pl-3.5 text-sm font-medium text-fg transition-colors hover:border-line-strong hover:bg-surface-2"
                >
                  <Icon name="ph:map-pin" size={16} class="text-accent" />
                  Rent a car in {a.name}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
          {
            site.routes.map((r) => (
              <li>
                <a href={urls.route(r.slug)} class="text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-fg">
                  Lahore to {r.city}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="text-sm text-muted">
          Want to work with us instead? Car owners can <a href={urls.partner()} class="font-semibold text-accent-fg underline underline-offset-4"
            >attach their car with us</a
          >, and our <a href={urls.contact()} class="font-semibold text-accent-fg underline underline-offset-4">contact page</a> has every way to reach the team.
        </p>
      </div>
    </div>
  </Section>
</PageLayout>

<style>
  .promise-no {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--accent) 80%, transparent);
  }
</style>
