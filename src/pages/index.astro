---
/**
 * Home page (DESIGN.md "Signature experiences"):
 *  1. The opening: five full-bleed frames on a pinned stage, changed by strip-light sweeps and garage-door
 *     wipes as the visitor scrolls, the H1 on the first. Pictures only, no 3D.
 *  2. The Collection: pinned horizontal gallery, highest rate first, every other model as a quiet link
 *  3. The Road North: particle terrain, the route to Skardu, every stop a real link. The site's only 3D, so it
 *     comes early, right after the cars
 *  4. Trip composer band (quote island), framed by a picture
 *  5. Occasions: image columns that open on hover or tap, every service page linked
 *  6. How renting works: a three-step strip
 *  7. Pickup areas: marquee and a compact list of every area
 *  8. Why Cantt: one statement beside one picture (real facts only)
 *  9. FAQ: closed accordions (FAQPage JSON-LD)
 * 10. Final CTA: full-bleed closing scene (the footer CTA band is hidden here to avoid repeating it)
 * The layout adds AutoRental + WebSite JSON-LD; every price and count comes from the catalog.
 */
import { getCollection } from "astro:content";
import AreaIndex from "@/components/home/AreaIndex.astro";
import Collection from "@/components/home/Collection.astro";
import ComposerBand from "@/components/home/ComposerBand.astro";
import FinalCta from "@/components/home/FinalCta.astro";
import HomeFaq from "@/components/home/HomeFaq.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HowItWorks from "@/components/home/HowItWorks.astro";
import Occasions from "@/components/home/Occasions.astro";
import RoadNorth from "@/components/home/RoadNorth.astro";
import WhyCantt from "@/components/home/WhyCantt.astro";
import { fleetFacts, homeFaqs, homeRoutes, sceneOrModel, sceneOrStill, splitCollection } from "@/components/home/home-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getModels } from "@/lib/catalog";
import { toComposerModels } from "@/lib/composer";
import { scene } from "@/lib/media";

const [models, categories, routeEntries] = await Promise.all([
  getModels(),
  getCategories(),
  getCollection("routes"),
]);

const facts = fleetFacts(models);
const composerModels = toComposerModels(models, categories);
const routes = homeRoutes(
  routeEntries.map((entry) => ({
    slug: entry.data.slug,
    distanceKm: entry.data.distanceKm,
    driveHours: entry.data.driveHours,
    motorways: entry.data.motorways,
  })),
);
const faqs = homeFaqs(facts);
// Why Cantt shows the S-Class or the Prado, else the top of the gallery. Null-safe: images may not exist yet.
const { gallery } = splitCollection(models);
const whyCar = ["mercedes-s-class", "toyota-prado"].flatMap((slug) => gallery.filter((c) => c.model.slug === slug))[0] ?? gallery[0];
// The opening ends on the first of these night scenes that exists; the closing scene takes the other one, so the
// page does not open and close on the same picture.
const closingScenes = ["lahore-night", "badshahi"].filter((name) => scene(name)).slice(1);
---

<BaseLayout
  title="Luxury Rent a Car in Lahore with Driver or Self Drive"
  description="Luxury rent a car in Lahore with a driver or self drive. Luxury sedans, SUVs and wedding cars from Lahore Cantt for airport runs, weddings and the north."
  overlayHeader
  hideFooterCta
  preloadMedia
>
  <HomeHero />
  <Collection models={models} categories={categories} />
  <RoadNorth routes={routes} />
  <!-- Not a fleet car: the Collection has just shown every one of them. -->
  <ComposerBand models={composerModels} image={sceneOrStill(["cabin", "garage"], "trails", "62% 72%")} />
  <Occasions models={models} />
  <HowItWorks image={sceneOrModel(["garage"], "honda-civic", models, "50% 58%")} />
  <AreaIndex />
  <WhyCantt facts={facts} model={whyCar?.model} image={whyCar?.image} />
  <HomeFaq faqs={faqs} />
  <FinalCta image={sceneOrModel(closingScenes, "toyota-prado", models)} />
</BaseLayout>
