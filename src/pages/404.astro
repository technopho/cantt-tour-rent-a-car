---
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import HeroTrails from "@/components/HeroTrails.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { whatsappUrl } from "@/lib/links";
import { urls } from "@/lib/urls";

const popular = [
  { label: "The fleet", href: urls.cars(), icon: "ph:car-profile" },
  ...site.services.slice(0, 5).map((s) => ({ label: s.name, href: urls.service(s.slug), icon: s.icon })),
  { label: "Outstation routes", href: urls.routes(), icon: "ph:map-trifold" },
  { label: "Contact us", href: urls.contact(), icon: "ph:chat-circle-dots" },
];
---

<BaseLayout
  title="Page not found"
  description="This page does not exist. Find a car, a service or get a quote from Cantt Rent a Car in Lahore."
  noindex
  overlayHeader
  hideFooterCta
>
  <section class="relative isolate overflow-hidden pt-[calc(var(--header-h)+3rem)] pb-20 md:pt-[calc(var(--header-h)+5rem)] md:pb-28">
    <HeroTrails intensity="bold" placement="top" />
    <Container class="relative">
      <p
        class="font-display text-[clamp(5rem,3rem+12vw,13rem)] leading-none font-bold tracking-[-0.06em] text-transparent [-webkit-text-stroke:1px_var(--line-strong)]"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="mt-4 max-w-3xl text-display-xl text-fg">This road does not go anywhere.</h1>
      <p class="text-lede mt-5 max-w-xl text-muted">
        The page may have moved or never existed. Here is where most people are headed.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
        <Button
          href={whatsappUrl()}
          variant="secondary"
          size="lg"
          icon="simple-icons:whatsapp"
          iconClass="text-whatsapp"
          external
        >
          {site.cta.whatsapp.label}
        </Button>
        <Button href={urls.home()} variant="ghost" size="lg" icon="ph:house">Back to home</Button>
      </div>

      <nav aria-labelledby="popular-title" class="mt-16 max-w-3xl">
        <h2 id="popular-title" class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-muted">Popular pages</h2>
        <ul class="mt-4 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2">
          {
            popular.map((link) => (
              <li class="bg-bg">
                <a
                  href={link.href}
                  class="group flex items-center gap-3 px-5 py-4 text-fg transition-colors hover:bg-surface"
                >
                  <Icon name={link.icon} size={20} class="text-accent" />
                  <span class="font-medium">{link.label}</span>
                  <Icon
                    name="ph:arrow-right"
                    size={16}
                    class="ml-auto text-muted transition-transform duration-300 group-hover:translate-x-1"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Container>
  </section>
</BaseLayout>
