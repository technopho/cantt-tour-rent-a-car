---
/**
 * /rates/: "Rent a car rates in Lahore (<year>)". Every model's rates from the catalog, grouped by
 * category: cards on phones and tablets, two clean tables (with driver / self drive) on desktop.
 * Notes on inclusions, outstation rules, deposits and payment, last updated from catalog.generatedAt.
 */
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import FaqList from "@/components/FaqList.astro";
import JsonLd from "@/components/JsonLd.astro";
import SampleFleetNote from "@/components/SampleFleetNote.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CategoryIndex from "@/components/fleet/CategoryIndex.astro";
import PriceBand from "@/components/fleet/PriceBand.astro";
import RateCards from "@/components/fleet/RateCards.astro";
import RatesTable from "@/components/fleet/RatesTable.astro";
import { CITY_DAY_HOURS, carName, fitText, highest, lowest, paymentMethodsText } from "@/components/fleet/fleet-data";
import { webPageSchema } from "@/components/fleet/fleet-schema";
import { afterCarList, pageVisuals } from "@/components/fleet/model-visual";
import Interlude from "@/components/services/Interlude.astro";
import { TERMS } from "@/components/services/terms";
import { site } from "@/config/site";
import PageLayout from "@/layouts/PageLayout.astro";
import { getCategories, getModels, loadCatalog, type CatalogModel } from "@/lib/catalog";
import { formatDate, formatNumber, formatPKR, isoDate } from "@/lib/format";
import type { FaqItem } from "@/lib/schema";
import { whatsappUrl } from "@/lib/links";
import { heroFor, scene } from "@/lib/media";
import { urls } from "@/lib/urls";

const [catalog, models, categories] = await Promise.all([loadCatalog(), getModels(), getCategories()]);

const generated = new Date(catalog.generatedAt);
const validDate = !Number.isNaN(generated.getTime());
const year = new Intl.DateTimeFormat("en-GB", { year: "numeric", timeZone: site.timeZone }).format(validDate ? generated : new Date());
const updatedLabel = validDate ? formatDate(generated) : null;

const groups = categories
  .map((category) => ({ category, models: models.filter((m) => m.category === category.slug) }))
  .filter((g) => g.models.length > 0);
const driverGroups = groups
  .map((g) => ({ ...g, models: g.models.filter((m) => m.rates.withDriver) }))
  .filter((g) => g.models.length > 0);
const selfGroups = groups
  .map((g) => ({ ...g, models: g.models.filter((m) => m.rates.selfDrive) }))
  .filter((g) => g.models.length > 0);

/** Model with the lowest value of a rate, plus that value. */
function cheapestBy(pick: (m: CatalogModel) => number | null | undefined): { model: CatalogModel; value: number } | null {
  let best: { model: CatalogModel; value: number } | null = null;
  for (const model of models) {
    const value = pick(model);
    if (typeof value === "number" && value > 0 && (!best || value < best.value)) best = { model, value };
  }
  return best;
}

const cheapest = cheapestBy((m) => m.rates.fromPrice);
const wdMin = cheapestBy((m) => m.rates.withDriver?.daily);
const sdMin = cheapestBy((m) => m.rates.selfDrive?.daily);
const wdMonthlyMin = cheapestBy((m) => m.rates.withDriver?.monthly);
const sdMonthlyMin = cheapestBy((m) => m.rates.selfDrive?.monthly);
const monthlyMin = [wdMonthlyMin, sdMonthlyMin].filter((x) => x !== null).sort((a, b) => a.value - b.value)[0] ?? null;
const outstationMin = lowest(models, (m) => m.rates.withDriver?.outstationDaily);
const overtimeMin = lowest(models, (m) => m.rates.withDriver?.overtimeHourly);
const nightMin = lowest(models, (m) => (m.rates.withDriver ? m.rates.driverNightAllowance : null));
const nightMax = highest(models, (m) => (m.rates.withDriver ? m.rates.driverNightAllowance : null));
const depositMin = lowest(models, (m) => m.rates.selfDrive?.securityDeposit);
const depositMax = highest(models, (m) => m.rates.selfDrive?.securityDeposit);
const weeklyMin = lowest(models, (m) => m.rates.selfDrive?.weekly);
const kmMin = lowest(models, (m) => m.rates.selfDrive?.kmPerDay);
const kmMax = highest(models, (m) => m.rates.selfDrive?.kmPerDay);
const popular =
  models.find((m) => m.featured && m.category === "sedan" && m.rates.withDriver) ?? models.find((m) => m.featured && m.rates.withDriver) ?? null;

const range = (min: number | null, max: number | null, fmt: (n: number) => string = formatPKR) =>
  min === null ? null : max !== null && max !== min ? `${fmt(min)} to ${fmt(max)}` : fmt(min);

const title = fitText([`Rent a Car Rates in Lahore ${year}: Daily, Weekly, Monthly`, `Rent a Car Rates in Lahore ${year}`], 60);
const description = fitText(
  [
    wdMin && sdMin
      ? `Rent a car rates in Lahore for ${year}: with driver from ${formatPKR(wdMin.value)} per ${CITY_DAY_HOURS} hour day, self drive from ${formatPKR(sdMin.value)}. Weekly, monthly and deposits.`
      : "",
    `Rent a car rates in Lahore for ${year}. Daily, weekly and monthly prices for every car, with driver or self drive.`,
  ].filter(Boolean),
  155,
);
const everyCarHasDriver = models.every((m) => m.rates.withDriver);
const everyCarSelfDrive = models.every((m) => m.rates.selfDrive);
const h1 = `Rent a car rates in Lahore (${year})`;

const glance = [
  wdMin && { label: "With driver", value: formatPKR(wdMin.value), note: `${CITY_DAY_HOURS} hour day, ${carName(wdMin.model)}` },
  sdMin && { label: "Self drive", value: formatPKR(sdMin.value), note: `per day, ${carName(sdMin.model)}` },
  monthlyMin && { label: "Monthly", value: formatPKR(monthlyMin.value), note: `per month, ${carName(monthlyMin.model)}` },
  outstationMin && { label: "Outstation", value: formatPKR(outstationMin), note: "per day with driver" },
].filter((g): g is { label: string; value: string; note: string } => Boolean(g));

// The interlude follows the rate cards, so it shows no vehicle (afterCarList).
const interludes = afterCarList(pageVisuals([scene("garage"), scene("lahore-night")], models, [heroFor(Astro.url.pathname)]));

const rules = [
  {
    id: "included",
    title: `A city day is ${CITY_DAY_HOURS} hours`,
    text: `With a driver, the daily rate covers the car and driver for up to ${CITY_DAY_HOURS} hours within Lahore, for example ${TERMS.cityDayWindow}.${
      overtimeMin ? ` Extra hours are billed at the overtime rate of each car, from ${formatPKR(overtimeMin)} per hour.` : ""
    } Pickup can be from your home, office, hotel or the airport.`,
  },
  {
    id: "extras",
    title: "Fuel, tolls and parking are extra",
    text: "No rate includes fuel. Motorway tolls on the M-2, M-3 and M-11 and parking fees are also paid separately. Your quote lists everything that is extra before you confirm, so there are no surprises on the day.",
  },
  {
    id: "outstation",
    title: "Outstation trips",
    text: `Trips outside Lahore use the outstation daily rate${outstationMin ? `, from ${formatPKR(outstationMin)}` : ""}. When the driver stays overnight, a night allowance${
      nightMin ? ` of ${range(nightMin, nightMax)} per night` : ""
    } is added. One way drops are quoted on WhatsApp, because the car and driver still have to come back to Lahore. For Naran, Hunza and Skardu we recommend an SUV.`,
    link: { href: urls.routes(), label: "Outstation routes from Lahore" },
  },
  {
    id: "deposit",
    title: "Self drive deposit and documents",
    text: `Self drive needs a refundable security deposit${depositMin ? ` of ${range(depositMin, depositMax)} depending on the car` : ""}, collected at handover and returned after the car is checked on return. Bring your CNIC (or passport if visiting from abroad) and a valid driving licence.${
      kmMin ? ` Each self drive day includes ${range(kmMin, kmMax, (n) => `${formatNumber(n)} km`)}.` : ""
    }`,
    link: { href: urls.service("self-drive-car-rental-lahore"), label: "Self drive car rental in Lahore" },
  },
  {
    id: "longer",
    title: "Weekly and monthly rates",
    text: `Longer bookings cost less per day.${weeklyMin ? ` Weekly self drive rates start at ${formatPKR(weeklyMin)}.` : ""}${
      monthlyMin ? ` Monthly rates start at ${formatPKR(monthlyMin.value)}.` : ""
    } Monthly rentals suit office use, long family visits and overseas Pakistanis staying for the season.`,
    link: { href: urls.service("monthly-car-rental-lahore"), label: "Monthly car rental in Lahore" },
  },
  {
    id: "payment",
    title: "Paying for your rental",
    text: "We confirm the total and how to pay on WhatsApp before you book. Nothing is paid on this website.",
    chips: [...site.paymentAccepted],
  },
];

const faqs: FaqItem[] = [
  cheapest && {
    q: "How much does it cost to rent a car in Lahore per day?",
    a: `Our lowest rate is ${formatPKR(cheapest.value)} per day for the ${carName(cheapest.model)}${
      cheapest.model.rates.selfDrive?.daily === cheapest.value ? " on self drive" : ""
    }.${wdMin ? ` With a driver, a ${CITY_DAY_HOURS} hour city day starts at ${formatPKR(wdMin.value)} (${carName(wdMin.model)}).` : ""}${
      popular?.rates.withDriver
        ? ` A popular car like the ${carName(popular)} is ${formatPKR(popular.rates.withDriver.daily)} with a driver${
            popular.rates.selfDrive ? ` or ${formatPKR(popular.rates.selfDrive.daily)} for self drive` : ""
          }.`
        : ""
    } Fuel, tolls and parking are extra.`,
  },
  {
    q: "Are these rates with a driver or without?",
    a: `${
      everyCarHasDriver
        ? "Both. Every car shows its with driver rate, and cars that can be self driven also show a self drive rate."
        : everyCarSelfDrive
          ? "Both. Every car shows its self drive rate, and cars that come with a driver also show a with driver rate."
          : "Both. Each car shows the rates for the service it is offered with: with a driver, self drive, or both."
    } With a driver, the rate covers the car and driver for a ${CITY_DAY_HOURS} hour city day within Lahore.`,
  },
  {
    q: "Is fuel included in the rent?",
    a: `Not in the rates listed here. Fuel, motorway tolls and parking are paid separately. With a driver, fuel is ${TERMS.fuelWithDriver}; for self drive, the fuel rule is ${TERMS.fuelSelfDrive}. Your quote lists everything that is extra before you confirm.`,
  },
  monthlyMin && {
    q: "What is the monthly rent of a car in Lahore?",
    a: `Monthly rates start at ${[
      sdMonthlyMin ? `${formatPKR(sdMonthlyMin.value)} for self drive (${carName(sdMonthlyMin.model)})` : null,
      wdMonthlyMin ? `${formatPKR(wdMonthlyMin.value)} with a driver (${carName(wdMonthlyMin.model)})` : null,
    ]
      .filter(Boolean)
      .join(" and ")}. Monthly rates for every car are in the tables above.`,
  },
  outstationMin && {
    q: "Do you charge more for outstation trips?",
    a: `Yes. Trips outside Lahore use the outstation daily rate, from ${formatPKR(outstationMin)} with a driver.${
      nightMin ? ` When the driver stays overnight, a night allowance of ${range(nightMin, nightMax)} per night is added.` : ""
    } Tolls are paid separately.`,
  },
  depositMin && {
    q: "How much is the security deposit for self drive?",
    a: `It depends on the car: ${range(depositMin, depositMax)}. The deposit is refundable. It is collected at handover and returned after the car is checked on return.`,
  },
  {
    q: "How do I pay?",
    a: `We accept ${paymentMethodsText()}. We confirm the total and how to pay on WhatsApp before you book. Nothing is paid on this website.`,
  },
].filter((f): f is FaqItem => Boolean(f));

const pageSchema = webPageSchema({ name: h1, description, url: urls.rates(), dateModified: catalog.generatedAt });
const jump = [
  { href: "#rates", label: "Rates by car" },
  { href: "#included", label: "What is included" },
  { href: "#outstation", label: "Outstation" },
  { href: "#deposit", label: "Self drive deposit" },
  { href: "#faq", label: "Questions" },
];
---

<PageLayout
  title={title}
  description={description}
  h1={h1}
  intro="Daily, weekly and monthly prices for every car we rent, with a driver or self drive. Taken straight from our booking system."
  crumbs={[{ label: "Rates" }]}
  heroHeight="short"
>
  <JsonLd slot="jsonld" data={pageSchema} />

  <div slot="actions" class="flex flex-wrap gap-3" data-fab-hide>
    <Button href={site.cta.quote.href} size="lg" iconRight="ph:arrow-right">{site.cta.quote.label}</Button>
    <Button href={whatsappUrl()} variant="secondary" size="lg" icon="simple-icons:whatsapp" iconClass="text-whatsapp" external>
      {site.cta.whatsapp.label}
    </Button>
  </div>

  <!-- The opening figures: the lowest rate in each way of renting -->
  <Container class="pt-10 md:pt-14">
    <div class="flex items-baseline justify-between gap-4">
      <p class="label text-accent-fg">Lowest rates</p>
      {
        updatedLabel && (
          <p class="text-xs text-muted">
            Updated <time datetime={isoDate(generated)}>{updatedLabel}</time>
          </p>
        )
      }
    </div>
    <PriceBand items={glance} class="mt-4" />
  </Container>

  <Section id="rates" labelledby="rates-title" spacing="sm">
    <nav aria-label="On this page" class="-mx-1 overflow-x-auto px-1 scrollbar-none">
      <ul class="flex w-max gap-x-7 border-b border-line">
        {
          jump.map((j) => (
            <li>
              <a href={j.href} class="link-draw inline-block py-3 text-sm whitespace-nowrap text-muted transition-colors duration-500 hover:text-fg">
                {j.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <SectionHeading id="rates-title" title="Rates for every car" class="mt-14 md:mt-20">
      <p class="text-lede max-w-2xl text-muted">
        Prices in Pakistani rupees, straight from our booking system{updatedLabel && <>, last updated <time datetime={isoDate(generated)}>{updatedLabel}</time></>}.
        Open a car for photos, specs and a quote.
      </p>
    </SectionHeading>

    <div class="mt-14 hidden flex-col gap-20 lg:flex">
      {
        driverGroups.length > 0 && (
          <div>
            <h3 id="with-driver" class="text-display-md text-fg">With driver</h3>
            <p class="mt-3 max-w-3xl text-muted">
              A city day is up to {CITY_DAY_HOURS} hours within Lahore. Outstation days apply outside Lahore, and the night allowance is added for each night
              the driver stays away.
            </p>
            <RatesTable mode="driver" groups={driverGroups} caption="Rent a car with driver rates in Lahore" class="mt-8" />
          </div>
        )
      }
      {
        selfGroups.length > 0 && (
          <div>
            <h3 id="self-drive" class="text-display-md text-fg">Self drive</h3>
            <p class="mt-3 max-w-3xl text-muted">
              Prices per 24 hours. The deposit is refundable and the kilometres shown are included in each day.
            </p>
            <RatesTable mode="self" groups={selfGroups} caption="Self drive car rental rates in Lahore" class="mt-8" />
          </div>
        )
      }
    </div>

    <RateCards groups={groups} class="mt-12 lg:hidden" />
    <SampleFleetNote class="mt-8" />
  </Section>

  <Interlude visual={interludes[0]} />

  <Section id="rules" labelledby="rules-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <h2 id="rules-title" class="text-display-lg max-w-[12ch] text-fg" data-fx="lines">What the rates include</h2>
        <p class="text-lede mt-5 max-w-md text-muted">The short version of how pricing works. The full terms are on our policies page.</p>
        <a href={urls.policies()} class="mt-5 inline-block text-accent-fg underline underline-offset-4">Rental policies</a>
      </div>
      <ul class="border-t border-line">
        {
          rules.map((r) => (
            <li id={r.id} class="scroll-mt-[calc(var(--header-h)+1.5rem)] border-b border-line py-8">
              <h3 class="text-xl font-medium text-fg">{r.title}</h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-muted">{r.text}</p>
              {r.chips && (
                <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-fg" aria-label="Payment methods">
                  {r.chips.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}
              {r.link && (
                <a href={r.link.href} class="mt-4 inline-block text-sm text-accent-fg underline underline-offset-4">
                  {r.link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="types" labelledby="types-title" class="pt-0!">
    <SectionHeading id="types-title" title="Browse cars by type" size="md" />
    <CategoryIndex categories={categories} models={models} size="sm" class="mt-10" />
  </Section>

  <Section id="faq" labelledby="faq-title" class="pt-0!">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <SectionHeading id="faq-title" title="Rent a car rates: common questions" size="md" />
      </div>
      <FaqList faqs={faqs} exclusive id="faq-rates" />
    </div>
  </Section>
</PageLayout>
